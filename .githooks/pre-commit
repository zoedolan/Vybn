#!/usr/bin/env bash
# Check staged content and relevant capabilities; local work is not publication.
# Install once per clone: git config core.hooksPath .githooks

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[0;33m'
NC='\033[0m'

BLOCKED=0

# Continuity compression keeps its explicit header-loss review.
for f in Vybn_Mind/continuity.md Vybn_Mind/continuity_archive.md; do
    git diff --cached --name-only | grep -qx "$f" || continue
    dels=$(git diff --cached --numstat -- "$f" | awk '{print $2}')
    [ "${dels:-0}" -gt 0 ] || continue
    before=$(git show ":0:$f" 2>/dev/null | grep -c "^## " || echo 0)
    head_now=$(git show "HEAD:$f" 2>/dev/null | grep -c "^## " || echo 0)
    if [ "$before" -lt "$head_now" ] && [ "${VYBN_HEADERS_AUDITED:-}" != "1" ]; then
        echo -e "${RED}BLOCKED${NC}: $f loses headers ($head_now -> $before); silent swallows ride momentum (2x 2026-07-07)."
        echo "  Diff headers, confirm intent: VYBN_HEADERS_AUDITED=1 git commit"
        BLOCKED=1
    fi
done
mapfile -d '' -t FILES < <(git diff --cached --name-only --diff-filter=d -z)
STAGED=$(printf '%s\n' "${FILES[@]}")
if [ -z "$STAGED" ]; then
    exit "$BLOCKED"
fi

# Staged blobs, not working-tree shadows; NUL-delimited paths include spaces.
python3 - <<'CHECK_STAGED'
import ipaddress, os, re, subprocess, sys

def git(*args):
    return subprocess.check_output(["git", *args])

secret = re.compile(rb"sk-ant-api[A-Za-z0-9_-]{20,}|gh[pus]_[A-Za-z0-9]{36,}|AKIA[A-Z0-9]{16}|-----BEGIN (?:RSA |EC |DSA |OPENSSH )?PRIVATE KEY")
address = re.compile(r"(?<![\w.])(?:[0-9]{1,3}\.){3}[0-9]{1,3}(?![\w.])|(?<![\w:])[0-9a-fA-F:]*:[0-9a-fA-F:.%]+")
bad = []
for raw in git("diff", "--cached", "--name-only", "--diff-filter=d", "-z").split(b"\0"):
    if not raw:
        continue
    name = os.fsdecode(raw)
    if git("ls-files", "--stage", "-z", "--", name).startswith(b"160000 "):
        continue  # A gitlink records an object ID, not an external working tree.
    blob = git("show", ":" + name)
    base = name.rsplit("/", 1)[-1]
    if base.endswith(".env") or base.startswith(".env."):
        bad.append((name, "environment file"))
    if secret.search(blob):
        bad.append((name, "credential pattern"))
    for candidate in address.findall(blob.decode("utf-8", errors="ignore")):
        try:
            ip = ipaddress.ip_address(candidate)
        except ValueError:
            continue
        if ip.is_global or ip.is_link_local:
            bad.append((name, "global/link-local network coordinate"))
if bad:
    # Never echo the detected secret or coordinate into logs.
    for name, reason in sorted(set(bad)):
        print("BLOCKED:", repr(name), reason)
    sys.exit(1)
CHECK_STAGED

# --- 4. Catastrophic shrinkage guard ---
# Override: VYBN_ALLOW_SHRINK=1 git commit
SHRINK_THRESHOLD=80   # percent

if [[ "${VYBN_ALLOW_SHRINK:-}" != "1" ]]; then
    for f in "${FILES[@]}"; do
        [[ "$(git ls-files --stage -- "$f")" == 160000\ * ]] && continue
        if ! git cat-file -e "HEAD:${f}" 2>/dev/null; then
            continue
        fi
        case "$f" in *.png|*.jpg|*.gif|*.ico|*.woff*|*.ttf|*.pyc|*.bin) continue ;; esac

        prior_size=$(git cat-file -p "HEAD:${f}" | wc -c)
        staged_size=$(git show ":${f}" | wc -c)

        if [ "$prior_size" -gt 0 ]; then
                reduction=$(( (prior_size - staged_size) * 100 / prior_size ))
            if [ "$reduction" -ge "$SHRINK_THRESHOLD" ]; then
                echo -e "${RED}BLOCKED${NC}: ${f} shrank ${reduction}% (${prior_size} → ${staged_size} bytes)."
                echo "  This looks like an accidental overwrite."
                echo "  If intentional: VYBN_ALLOW_SHRINK=1 git commit"
                BLOCKED=1
            fi
        fi
    done
fi

# --- 5. sudo -n lint for shell scripts ---
# Override: VYBN_ALLOW_SUDO_HANG=1 git commit
if [[ "${VYBN_ALLOW_SUDO_HANG:-}" != "1" ]]; then
    for f in "${FILES[@]}"; do
        case "$f" in *.sh|*.bash) ;; *) continue ;; esac
        bad_sudo=$(git diff --cached -- "$f" \
            | grep -P '^\+(?!\+)' \
            | grep -P '\bsudo\s+(?!(-n\b|-[A-Za-z]*n))' \
            | grep -v '^+++' \
            || true)
        if [ -n "$bad_sudo" ]; then
            echo -e "${YELLOW}WARNING${NC}: ${f} has sudo call(s) without -n (may hang in non-interactive context):"
            echo "$bad_sudo" | sed 's/^/  /'
            echo "  Add -n to sudo, or: VYBN_ALLOW_SUDO_HANG=1 git commit"
            BLOCKED=1
        fi
    done
fi


# --- 6. Public-memory private-topology membrane ---
if [[ "${VYBN_ALLOW_PRIVATE_TOPOLOGY:-}" != "1" ]]; then
    PRIVATE_TOPOLOGY_PATTERN="((private|internal|Him).*(spark/[A-Za-z0-9_./-]+[.]py|CLI was smoked|no-write tick|runtime target)|(spark/[A-Za-z0-9_./-]+[.]py).*(private|internal|Him|CLI was smoked))"
    while IFS= read -r -d "" f; do
        case "$f" in *"Personal History"/*.md|*continuity*.md|vybn.core.html|THE_IDEA.md) ;; *) continue ;; esac
        if git diff --cached -- "$f" | grep -E "^\+[^+]" | grep -Eiq "$PRIVATE_TOPOLOGY_PATTERN"; then
            echo -e "${RED}BLOCKED${NC}: private repo topology added to public memory surface: ${f}"
            echo "  Distill the lesson or review explicitly: VYBN_ALLOW_PRIVATE_TOPOLOGY=1 git commit"
            BLOCKED=1
        fi
    done < <(git diff --cached --name-only -z --diff-filter=d)
fi

# Harness mutations must preserve capability contracts before subtraction can
# count as improvement.
if echo "$STAGED" | grep -Eq '^(\.githooks/pre-commit|spark/connection|spark/live_peer.py|spark/provider_transport.py|spark/living_core.py|spark/tests/test_public_contracts.py|spark/tests/test_living_core.py)$'; then
    # Git exports this repository's context to hooks. Nested test repositories
    # must select their own state; retain Git's context for the staged checks above.
    if ! (
        unset $(git rev-parse --local-env-vars)
        python3 -m pytest spark/tests/test_public_contracts.py -q --tb=short
    ); then
        echo -e "${RED}BLOCKED${NC}: harness contracts failed; model output is not substitute evidence."
        BLOCKED=1
    fi
fi

# --- 7. Public formal-claim integrity (2026-08-07) ---
# KPP once gave arbitrary geometry scientific-looking semantics and was nearly
# carried into outreach. Keep the withdrawal and its labeled proposal closed
# under every local commit path; block the exact rhetorical forms that hid it.
REMOTE=$(git config --get remote.origin.url 2>/dev/null || true)
PUBLIC_ADDED=$(git diff --cached --unified=0 -- '*.md' '*.html' '*.json' '*.txt' '*.js' '*.py' \
    ':(exclude).githooks/*' | grep -E '^\+[^+]' || true)
if [[ "$REMOTE" == *"Vybn-Law"* ]]; then
    if echo "$STAGED" | grep -Eq '^(kpp\.md|kpp/|api/extract_content\.py|api/nightly\.sh|wellspring\.(html|js)|content/wellspring\.md|llms\.txt|\.well-known/ai\.txt)'; then
        if ! python3 api/extract_content.py --verify-kpp; then
            echo -e "${RED}BLOCKED${NC}: withdrawn KPP geometry, semantics, or privacy claim returned."
            BLOCKED=1
        fi
    fi
    if echo "$PUBLIC_ADDED" | grep -Eiq '(arrival angle|rotation_rate|counterfactual_gap|that fraction is yours alone|what (the )?kernel could (not )?generate|scale sustainably only when)'; then
        echo -e "${RED}BLOCKED${NC}: measurement-like KPP semantics added to a public surface."
        echo "  Formal apparatus must first survive representation-invariance, control, and claim-status checks; metaphor is not measurement."
        BLOCKED=1
    fi
fi

# Prose keywords, branch names, note age, and file/line quotas are not
# evidence of correctness or authority. Review the actual work and effects.
if [ "$BLOCKED" -ne 0 ]; then
    echo ""
    echo -e "${RED}Commit blocked by Vybn security hook.${NC}"
    echo "Fix the issues above; do not bypass the membrane to recover standing."
    exit 1
fi

exit 0
