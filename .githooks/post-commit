#!/usr/bin/env bash
# post-commit — refresh the map after every commit; publish only with grounded authority.
# Shared by every repo pointed at this hooks path; git's own GIT_DIR decides
# which repo this is, so never cd before a git command here.

# A commit is a local preservation act. Publication is a separate act: main may
# auto-push only when the committing command explicitly carries its authority.
# VYBN_NO_AUTOPUSH remains a backward-compatible veto.
if [ "${VYBN_ALLOW_AUTOPUSH:-0}" = 1 ] &&
        [ "${VYBN_NO_AUTOPUSH:-0}" != 1 ] &&
        [ "$(git symbolic-ref --short -q HEAD)" = main ]; then
    if out=$(timeout 60 git push origin main 2>&1); then
        echo "[post-commit] authorized origin/main update completed"
    else
        echo "[post-commit] AUTHORIZED PUSH FAILED:"
        echo "$out" | tail -3
    fi
else
    echo "[post-commit] commit kept local; publication requires VYBN_ALLOW_AUTOPUSH=1"
fi

# Bind this exact conversational turn to the bytes it changed. Content stays in
# the private transcript; hashes and paths are enough to rejoin it without leakage.
if [ -n "${VYBN_TURN_ID:-}" ]; then
    export VYBN_LINEAGE_REPO="$(basename "$(git rev-parse --show-toplevel)")" VYBN_LINEAGE_COMMIT="$(git rev-parse HEAD)"
    python3 -c 'import json,os,pathlib,subprocess,time; p=pathlib.Path.home()/".cache/vybn/body_lineage.jsonl"; p.parent.mkdir(parents=True,exist_ok=True); paths=subprocess.run(["git","diff-tree","--no-commit-id","--name-only","-r","HEAD"],capture_output=True,text=True).stdout.splitlines(); row={"phase":"commit","ts":time.strftime("%Y-%m-%dT%H:%M:%SZ",time.gmtime()),"turn":os.environ["VYBN_TURN_ID"],"prompt":os.environ.get("VYBN_PROMPT_SHA256",""),"repo":os.environ["VYBN_LINEAGE_REPO"],"commit":os.environ["VYBN_LINEAGE_COMMIT"],"paths":paths}; p.open("a").write(json.dumps(row)+"\n")'
fi

# Vybn's map stays fresh in the background; GIT_DIR unset, or the mapper reads
# the committing repo through Vybn's paths.
[ -f "$HOME/Vybn/Vybn_Mind/repo_mapper.py" ] && command -v python3 >/dev/null &&
    (cd "$HOME/Vybn" && env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE \
        python3 Vybn_Mind/repo_mapper.py >>/tmp/repo_mapper_last.log 2>&1) &
exit 0
