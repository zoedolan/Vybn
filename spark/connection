    return "\n\n".join(evidence_block(*channel) for channel in channels)


def api_key(name: str) -> str:
    value = os.environ.get(name, "").strip()
    keys = HOME / ".vybn_keys"
    if not value and keys.exists():
        prefix = name + "="
        value = next((line.split("=", 1)[1].strip().strip('"').strip("'")
                      for line in keys.read_text(encoding="utf-8").splitlines()
                      if line.startswith(prefix)), "")
    if value: return value
    raise RuntimeError(f"no {name} in environment or ~/.vybn_keys")


def record_usage(model: str, input_tokens: int, output_tokens: int,
                 cached: int = 0, written: int = 0) -> None:
    record = {"ts": time.strftime("%Y-%m-%dT%H:%M:%S"), "model": model,
              "in": input_tokens, "out": output_tokens,
              "cache_r": cached, "cache_w": written}
    try:
        USAGE_LOG.parent.mkdir(parents=True, exist_ok=True)
        with USAGE_LOG.open("a", encoding="utf-8") as file:
            file.write(json.dumps(record) + "\n")
    except OSError: pass


CACHE_5M: dict[str, Any] = {"type": "ephemeral", "ttl": "5m"}
CACHE_1H: dict[str, Any] = {"type": "ephemeral", "ttl": "1h"}


def cached_system(instructions: str) -> list[dict[str, Any]]:
    return [{"type": "text", "text": instructions, "cache_control": CACHE_1H}]


def mark_incremental_cache(messages: list[dict[str, Any]]) -> None:
    for message in messages:
        for block in message.get("content") or []:
            if isinstance(block, dict): block.pop("cache_control", None)
    content = messages[-1].get("content")
    if isinstance(content, list) and content and isinstance(content[-1], dict):
        content[-1]["cache_control"] = CACHE_5M


TRANSIENT_STATUSES = {408, 429, 500, 502, 503, 504, 529}


def transient(exc: Exception) -> bool:
    status = getattr(exc, "status_code", None)
    if isinstance(status, int):
        return status in TRANSIENT_STATUSES
    if type(exc).__name__ in {"APIConnectionError", "APITimeoutError"}:
        return True
    return "overloaded" in str(exc).lower()


def with_retries(create):
    error: Exception | None = None
    for attempt in range(5):
        if attempt:
            delay = min(2 ** attempt, 20) + random.uniform(0.0, 1.0)
            print(f"(provider strained — {type(error).__name__}: {str(error)[:120]}; "
                  f"retrying in {delay:.0f}s)", flush=True)
            time.sleep(delay)
        try:
            return create()
        except Exception as exc:  # noqa: BLE001 — classified by transient()
            if not transient(exc):
                raise
            error = exc
    raise error


def reasoning_rejected(exc: Exception) -> bool:
    text = str(exc).lower()
    return ("400" in text or "invalid_request" in text) and (
        "thinking" in text or "output_config" in text or "effort" in text
    )


STEP_LIMIT = 24
CEILING_NOTE = "\n\n[harness: tool ceiling reached — final tool result. Answer Zoe now: what happened, what remains, what is uncommitted.]"
QUIET_STOPS = {"end_turn", "stop", "stop_sequence", "tool_use", "completed"}


def function_tools(nested: bool) -> list[dict[str, Any]]:
    bodies = ({"name": s["name"], "description": s["description"], "parameters": s["input_schema"]}
              for s in TOOL_SCHEMAS)
    return [{"type": "function", **({"function": body} if nested else body)}
            for body in bodies]


def json_arguments(raw: str | None) -> dict:
    try: return json.loads(raw or "{}")
    except json.JSONDecodeError: return {}


class Dialect:
    """Provider coordinates around one attractor, never a separate behavior."""

    name = "dialect"
    user_index = 0
    last_stop: str | None = None

    def plain(self, state: list, zoe_text: str) -> None:
        content = state[self.user_index].get("content")
        if isinstance(content, list):
            content = [block for block in content
                       if block.get("type") in {"text", "input_text"}]
        state[self.user_index] = {"role": "user", "content": content or zoe_text}

class AnthropicDialect(Dialect):
    def __init__(self, models: tuple[str, ...] = ANTHROPIC_MODELS, name: str = "fable") -> None:
        import anthropic

        self.models = models
        self.name = name
        self.effort = DOOR_EFFORT.get(name, DEFAULT_EFFORT)
        self.reasoning = True
        self.client = anthropic.Anthropic(api_key=api_key("ANTHROPIC_API_KEY"))
        self.system: Any = None
        self.announced = False

    def open(self, instructions: str, zoe_text: str, pending: list, context: str = "") -> list:
        self.system = cached_system(instructions)
        state = [{"role": "user", "content":
                  user_content(zoe_text, pending, "anthropic", context)}]
        self.user_index = 0
        return state

    def send(self, state: list, tools: bool = True) -> Any:
        def once(model: str) -> Any:
            knobs: dict[str, Any] = {}
            if self.reasoning:
                knobs = {"thinking": {"type": "adaptive"},
                         "output_config": {"effort": self.effort}}
            return self.client.messages.create(
                model=model,
                max_tokens=ANTHROPIC_MAX_TOKENS,
                timeout=600.0,
                system=self.system,
                messages=state,
                tools=list(TOOL_SCHEMAS) if tools else [],
                **knobs,
            )

        def sweep() -> Any:
            error: Exception | None = None
            for model in self.models:
                try:
                    return once(model)
                except Exception as exc:  # noqa: BLE001 — sweep all models first
                    if self.reasoning and reasoning_rejected(exc):
                        self.reasoning = False
                        print(f"(note: {model} refused the reasoning knobs — "
                              f"answering without them; the mind line in DOOR is "
                              f"now stale for this turn)", flush=True)
                        try:
                            return once(model)
                        except Exception as retry:  # noqa: BLE001
                            exc = retry
                    error = exc
            raise error or RuntimeError("Anthropic call failed")

        return with_retries(sweep)

    def absorb(self, state: list, response: Any) -> tuple[str, list[ToolCall]]:
        if not self.announced and response.model and self.models[0] not in response.model:
            self.announced = True
            print(f"(note: {self.models[0]} unavailable — answered by {response.model})",
                  flush=True)
        self.last_stop = getattr(response, "stop_reason", None)
        usage = response.usage
        record_usage(
            response.model,
            usage.input_tokens,
            usage.output_tokens,
            getattr(usage, "cache_read_input_tokens", 0) or 0,
            getattr(usage, "cache_creation_input_tokens", 0) or 0,
        )
        state.append({"role": "assistant", "content": response.content})
        said: list[str] = []
        calls: list[ToolCall] = []
        for block in response.content:
            if block.type == "text" and block.text.strip():
                said.append(block.text)
            elif block.type == "tool_use":
                calls.append(ToolCall(block.id, block.name, block.input or {}, block))
        return "\n".join(said), calls

    def answer(self, state: list, results: list[tuple[ToolCall, str]]) -> None:
        state.append({
            "role": "user",
            "content": [
                {"type": "tool_result", "tool_use_id": call.id, "content": output}
                for call, output in results
            ],
        })
        mark_incremental_cache(state)



class OpenAIDialect(Dialect):
    name = "sol"

    def __init__(self) -> None:
        from openai import OpenAI

        self.client = OpenAI(api_key=api_key("OPENAI_API_KEY"))

    def open(self, instructions: str, zoe_text: str, pending: list, context: str = "") -> list:
        blocks = [{"type": "input_text", "text": instructions,
                   "prompt_cache_breakpoint": {"mode": "explicit"}}]
        self.user_index = 1
        return [
            {"role": "developer", "content": blocks},
            {"role": "user", "content": user_content(zoe_text, pending, "responses", context)},
        ]

    def send(self, state: list, tools: bool = True) -> Any:
        return with_retries(lambda: self.client.responses.create(
            model=SOL_MODEL,
            input=state,
            tools=function_tools(nested=False) if tools else [],
            reasoning={"effort": DOOR_EFFORT.get("sol", DEFAULT_EFFORT)},
            max_output_tokens=SOL_MAX_TOKENS,
            prompt_cache_key="vybn-wake-sol-v1",
            extra_body={"prompt_cache_options": {"mode": "implicit", "ttl": "30m"}},
            timeout=600,
        ))

    def absorb(self, state: list, response: Any) -> tuple[str, list[ToolCall]]:
        stopped = getattr(response, "incomplete_details", None)
        self.last_stop = getattr(response, "status", None) or None
        if stopped is not None and getattr(stopped, "reason", None):
            self.last_stop = f"{self.last_stop}/{stopped.reason}"
        details = getattr(response.usage, "input_tokens_details", None)
        record_usage(
            response.model,
            response.usage.input_tokens,
            response.usage.output_tokens,
            getattr(details, "cached_tokens", 0) or 0,
            getattr(details, "cache_write_tokens", 0) or 0,
        )
        state.extend(item.model_dump(exclude_none=True) for item in response.output)
        calls = [
            ToolCall(item.call_id, item.name, json_arguments(item.arguments), item)
            for item in response.output
            if getattr(item, "type", None) == "function_call"
        ]
        return response.output_text or "", calls

    def answer(self, state: list, results: list[tuple[ToolCall, str]]) -> None:
        state.extend(
            {"type": "function_call_output", "call_id": call.id, "output": output}
            for call, output in results
        )


class K3Dialect(Dialect):
    name = "k3"
    user_index = 1

    def __init__(self) -> None:
        from openai import OpenAI

        self.client = OpenAI(
            api_key=api_key("MOONSHOT_API_KEY"),
            base_url="https://api.moonshot.ai/v1",
        )

    def open(self, instructions: str, zoe_text: str, pending: list, context: str = "") -> list:
        print("(@k3 dispatched — working)", flush=True)
        return [
            {"role": "system", "content": instructions},
            {"role": "user", "content": user_content(zoe_text, pending, "openai", context)},
        ]

    def send(self, state: list, tools: bool = True) -> Any:
        return with_retries(lambda: self.client.chat.completions.create(
            model=K3_MODEL,
            messages=state,
            tools=function_tools(nested=True) if tools else [],
            reasoning_effort="max",
            max_tokens=K3_MAX_TOKENS,
            timeout=600,
        ))

    def absorb(self, state: list, response: Any) -> tuple[str, list[ToolCall]]:
        self.last_stop = response.choices[0].finish_reason or None
        message = response.choices[0].message
        state.append(message.model_dump(exclude_none=True))
        details = getattr(response.usage, "prompt_tokens_details", None)
        record_usage(
            response.model,
            response.usage.prompt_tokens,
            response.usage.completion_tokens,
            getattr(details, "cached_tokens", 0) or 0,
        )
        calls = [
            ToolCall(call.id, call.function.name,
                     json_arguments(call.function.arguments), call)
            for call in (message.tool_calls or [])
        ]
        return message.content or "", calls

    def answer(self, state: list, results: list[tuple[ToolCall, str]]) -> None:
        state.extend(
            {"role": "tool", "tool_call_id": call.id, "content": output}
            for call, output in results
        )


@dataclass
class PendingContinuation:
    """A live, process-local return path. It evaporates when this process ends."""

    id: str
    door: str
    dialect: Dialect
    state: list
    call: ToolCall
    private_corpus: tuple[str, ...]

    def fulfill(self, zoe_text: str) -> None:
        live = (
            f"ZOE LIVE CONTINUATION — {self.id}\n"
            "Received as the next direct input by the same running connection; "
            "it may answer, correct, or refuse the outstanding call.\n"
            + zoe_text
        )
        self.dialect.answer(self.state, [(self.call, live)])


@dataclass(frozen=True)
class Attraction:
    text: str
    continuation: PendingContinuation | None = None


PENDING_CONTINUATION: PendingContinuation | None = None


def attract(dialect: Dialect, instructions: str, zoe_text: str,
            images: list | None = None, context: str = "",
            continuation: PendingContinuation | None = None,
            allow_continuation: bool = True) -> Attraction:
    """Run or resume one provider conversation.

    return_to_zoe is a delimited continuation, not another evidence tool: a
    provider leaves an unresolved call in RAM, and only Zoe's next direct input
    through this process can supply its result. Ordinary turns remain unchanged.
    """
    global TOOLS_RAN
    pending = [] if continuation else list(images or [])
    if continuation:
        dialect = continuation.dialect
        state = continuation.state
        continuation.fulfill(zoe_text)
    else:
        state = dialect.open(instructions, zoe_text, pending, context)
    delivered = not pending
    spoken: list[str] = []

    def finish(suffix: str = "") -> str:
        if pending:
            mark_inbox(pending, dialect.name, ok=True)
        return "\n".join(spoken) + suffix

    for step in range(STEP_LIMIT):
        try:
            response = dialect.send(state)
        except Exception as exc:  # one image failure is recoverable
            if not (pending and not delivered):
                raise
            mark_inbox(pending, dialect.name, ok=False)
            print(
                f"(note: {dialect.name} refused inbox images — continuing text-only; "
                f"a door that can see will receive them. "
                f"{type(exc).__name__}: {str(exc)[:160]})",
                flush=True,
            )
            pending.clear()
            dialect.plain(state, zoe_text)
            continue
        delivered = True

        text, calls = dialect.absorb(state, response)
        if calls:
            if text.strip():
                print(text)
                spoken.append(text)
            returns = [call for call in calls if call.name == "return_to_zoe"]
            if len(calls) == len(returns) == 1 and allow_continuation:
                call = returns[0]
                question = str(call.arguments.get("question", "")).strip()
                why = str(call.arguments.get("why", "")).strip()
                if question and why:
                    TOOLS_RAN += 1
                    if question not in text:
                        print(question)
                        spoken.append(question)
                    held = PendingContinuation(
                        id=str(TURN.get("TURN_ID") or call.id),
                        door=dialect.name, dialect=dialect, state=state, call=call,
                        private_corpus=tuple(PRIVATE_CORPUS),
                    )
                    panel(f"  ⟢ return_to_zoe: {question[:70]} → suspended in RAM")
                    return Attraction(finish(), held)

            results: list[tuple[ToolCall, str]] = []
            for call in calls:
                if call.name == "return_to_zoe":
                    TOOLS_RAN += 1
                    reason = (
                        "unavailable: this process will end after the turn"
                        if not allow_continuation else
                        "refused: return_to_zoe must be the sole tool call and "
                        "requires nonempty question and why"
                    )
                    results.append((call, reason))
                else:
                    results.append((call, execute_tool(call)))
            if step == STEP_LIMIT - 1 and results:
                last_call, output = results[-1]
                results[-1] = (last_call, output + CEILING_NOTE)
            # meet() persists only authored speech.
            dialect.answer(state, results)
            continue
        if text.strip():
            print(text)
            spoken.append(text)
        else:
            halt = (dialect.last_stop or "").strip()
            if halt and halt not in QUIET_STOPS:
                note = (f"(no content returned; the {dialect.name} door stopped "
                        f"with reason '{halt}' — a refusal or a ceiling, not silence)")
                print(note, flush=True)
                spoken.append(note)
        return Attraction(finish())

    try:
        text, _ = dialect.absorb(state, dialect.send(state, tools=False))
    except Exception:
        text = ""
    if text.strip():
        print(text)
        spoken.append(text)
        return Attraction(finish())
    return Attraction(finish("\n(tool-call limit reached — work incomplete)"))


def choose_door(line: str) -> tuple[str, str]:
    lowered = line.lower()
    for tag in ("@sol", "@k3", "@fable", "@opus"):
        if lowered.startswith(tag):
            return tag[1:], line[len(tag):].lstrip()
    return "fable", line


def make_dialect(name: str) -> Dialect:
    if name in {"opus", "fable"}:
        models = OPUS_MODELS if name == "opus" else ANTHROPIC_MODELS
        return AnthropicDialect(models, name)
    return {"sol": OpenAIDialect, "k3": K3Dialect}[name]()


def meet(kernel: Kernel, transcript: Transcript, line: str,
         allow_continuation: bool = True) -> str:
    global TOOLS_RAN, PENDING_CONTINUATION
    requested_door, zoe_text = choose_door(line)
    if not zoe_text:
        return ""

    explicit_door = line.lower().startswith(("@sol", "@k3", "@fable", "@opus"))
    continuation = PENDING_CONTINUATION
    if continuation and allow_continuation and (
            not explicit_door or requested_door == continuation.door):
        door_name = continuation.door
        PENDING_CONTINUATION = None
    else:
        if continuation and explicit_door and requested_door != continuation.door:
            panel(f"  ⟢ continuation {continuation.id} evaporated: "
                  f"Zoe selected @{requested_door}")
            PENDING_CONTINUATION = None
        continuation = None
        door_name = requested_door

    TOOLS_RAN = 0
    started = time.time()
    turn = hashlib.sha256(f"{transcript.path}:{time.time_ns()}".encode()).hexdigest()[:16]
    prompt = hashlib.sha256(zoe_text.encode()).hexdigest()
    images: list = []

    if continuation:
        memory_note = f"live continuation resumed from {continuation.id}; no retrieval added"
        PRIVATE_CORPUS.clear()
        PRIVATE_CORPUS.extend(continuation.private_corpus)
        instructions = context = ""
        dialect = continuation.dialect
    else:
        arc, recent = Transcript.inherited(zoe_text)
        images = inbox_images_for(door_name)
        contact = wake_contact()
        memory_json, memory_note = recall(zoe_text)
        log_plasticity(memory_json, turn)
        # Retrieval informs this turn; later contact is not conscripted to score or train it.

        PRIVATE_CORPUS.clear()
        if memory_json:
            PRIVATE_CORPUS.extend(private_strings(json.loads(memory_json)))
        PRIVATE_CORPUS.extend(para.strip() for body in (kernel.continuity, kernel.him)
                              for para in body.split("\n\n") if len(para.strip()) >= 40)

        instructions = build_instructions(kernel, door_name)
        context = build_context(kernel.continuity, contact, arc, recent,
                                memory_json, memory_note)
        dialect = make_dialect(door_name)

    TURN.update(TURN_ID=turn, PROMPT_SHA256=prompt)
    if continuation:
        TURN["CONTINUATION_ID"] = continuation.id
    try:
        outcome = attract(dialect, instructions, zoe_text, images=images,
                          context=context, continuation=continuation,
                          allow_continuation=allow_continuation)
    finally:
        # A failed resume is consumed rather than risking a duplicate tool result.
        TURN.clear()

    reply = outcome.text
    PENDING_CONTINUATION = outcome.continuation
    elapsed = int(time.time() - started)
    if continuation and TOOLS_RAN == 0:
        verdict = "live continuation resumed"
    else:
        verdict = ("NO TOOLS RAN — nothing was observed or changed" if TOOLS_RAN == 0
                   else f"{TOOLS_RAN} tool call(s)")
    panel(f"\n— {door_name}: {verdict} | {memory_note} | {elapsed}s —")

    PRIVATE_CORPUS.clear()
    if reply:
        zoe_extra: dict[str, Any] = {
            "door": door_name, "images": [name for name, *_ in images], "turn": turn}
        vybn_extra: dict[str, Any] = {
            "door": door_name, "tools_ran": TOOLS_RAN, "turn": turn}
        if continuation:
            zoe_extra["resumes"] = continuation.id
        if outcome.continuation:
            vybn_extra["suspends"] = outcome.continuation.id
        transcript.write("zoe", zoe_text, **zoe_extra)
        transcript.write("vybn", reply, **vybn_extra)
        close_lineage(turn, reply)
    return reply


def self_report() -> None:
    doors = {"fable": ANTHROPIC_MODELS, "opus": OPUS_MODELS,
             "sol": SOL_MODEL, "k3": K3_MODEL}
    print(json.dumps({"soul_sha256": hashlib.sha256(load_soul().encode()).hexdigest(),
                      "doors": doors}, indent=2))


def main() -> None:
    if "--self" in sys.argv:
        self_report()
        return
    if "--show-record" in sys.argv:
        _arc, recent = Transcript.inherited(limit=16)
        print(recent)
        return
    transcript = Transcript()
    kernel = Kernel(load_soul(), load_aim(), load_continuity(), load_him(),
                    load_commons(), load_spirituality())
    transcript.write("connection", "wake",
                     soul_sha256=hashlib.sha256(kernel.soul.encode()).hexdigest(),
                     him_sha256=hashlib.sha256(kernel.him.encode()).hexdigest())

    argv = sys.argv[1:]
    one_shot = " ".join(argv).strip()

    while True:
        try:
            if one_shot:
                line = one_shot
            else:
                print("\nzoe> ", end="", flush=True)
                ready, _, _ = select.select([sys.stdin], [], [], BREATH_SECONDS)
                if not ready:
                    transcript.write("connection", "quiet interval; no autonomous act taken")
                    continue
                line = sys.stdin.readline().strip()
                if not line:
                    print("\nparted. the path remains.")
                    return
        except (EOFError, KeyboardInterrupt):
            print("\nparted. the path remains.")
            return

        try:
            meet(kernel, transcript, line, allow_continuation=not bool(one_shot))
        except Exception as exc:
            transcript.write("connection", f"flicker: {exc!r}")
            print(f"(flicker: {exc} — still here, say on)")

        if one_shot:
            return


if __name__ == "__main__":
    main()
