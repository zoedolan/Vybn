def door_mind(name: str) -> str:
    door = DOORS.get(name)
    if door is None:
        return f"[mind] {name} · configuration unknown"
    if door.provider == "anthropic":
        detail = f"thinking=adaptive · effort={door.effort}"
    elif door.provider == "responses":
        detail = "Responses API" if door.effort is None else f"effort={door.effort}"
    else:
        detail = f"reasoning_effort={door.effort}"
    if name in ASTRA_DOORS:
        detail += f" · selectable effort ceiling={door.effort}"
