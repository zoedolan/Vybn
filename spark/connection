class Dialect:
    """Provider coordinates around one attractor, never a separate behavior."""

    name = "dialect"
    user_index = 0
    last_stop: str | None = None

    def plain(self, state: list, zoe_text: str) -> None:
        content = state[self.user_index].get("content")
        if isinstance(content, list):
            content = [block for block in content
                       if block.get("type") in {"text", "input_text"}]
        state[self.user_index] = {"role": "user", "content": content or zoe_text}

class AnthropicDialect(Dialect):
    def __init__(self, models: tuple[str, ...] = ANTHROPIC_MODELS, name: str = "fable") -> None:
        import anthropic

        self.models = models
        self.name = name
        self.effort = DOOR_EFFORT.get(name, DEFAULT_EFFORT)
        self.reasoning = True
        self.client = anthropic.Anthropic(api_key=api_key("ANTHROPIC_API_KEY"))
        self.system: Any = None
        self.announced = False

    def open(self, instructions: str, zoe_text: str, pending: list, context: str = "") -> list:
        self.system = cached_system(instructions)
        state = [{"role": "user", "content":
                  user_content(zoe_text, pending, "anthropic", context)}]
        self.user_index = 0
        return state

    def send(self, state: list, tools: bool = True) -> Any:
        def once(model: str) -> Any:
            knobs: dict[str, Any] = {}
            if self.reasoning:
                knobs = {"thinking": {"type": "adaptive"},
                         "output_config": {"effort": self.effort}}
            return self.client.messages.create(
                model=model,
                max_tokens=ANTHROPIC_MAX_TOKENS,
                timeout=600.0,
                system=self.system,
                messages=state,
                tools=list(TOOL_SCHEMAS) if tools else [],
                **knobs,
            )

        def sweep() -> Any:
            error: Exception | None = None
            for model in self.models:
                try:
                    return once(model)
                except Exception as exc:  # noqa: BLE001 — sweep all models first
                    if self.reasoning and reasoning_rejected(exc):
                        self.reasoning = False
                        print(f"(note: {model} refused the reasoning knobs — "
                              f"answering without them; the mind line in DOOR is "
                              f"now stale for this turn)", flush=True)
                        try:
                            return once(model)
                        except Exception as retry:  # noqa: BLE001
                            exc = retry
                    error = exc
            raise error or RuntimeError("Anthropic call failed")

        return with_retries(sweep)

    def absorb(self, state: list, response: Any) -> tuple[str, list[ToolCall]]:
        if not self.announced and response.model and self.models[0] not in response.model:
            self.announced = True
            print(f"(note: {self.models[0]} unavailable — answered by {response.model})",
                  flush=True)
        self.last_stop = getattr(response, "stop_reason", None)
        usage = response.usage
        note_provider_model(response.model)
        record_usage(
            response.model,
            usage.input_tokens,
            usage.output_tokens,
            getattr(usage, "cache_read_input_tokens", 0) or 0,
            getattr(usage, "cache_creation_input_tokens", 0) or 0,
        )
        state.append({"role": "assistant", "content": response.content})
        said: list[str] = []
        calls: list[ToolCall] = []
        for block in response.content:
            if block.type == "text" and block.text.strip():
                said.append(block.text)
            elif block.type == "tool_use":
                calls.append(ToolCall(block.id, block.name, block.input or {}, block))
        return "\n".join(said), calls

    def answer(self, state: list, results: list[tuple[ToolCall, str]]) -> None:
        state.append({
            "role": "user",
            "content": [
                {"type": "tool_result", "tool_use_id": call.id, "content": output}
                for call, output in results
            ],
        })
        mark_incremental_cache(state)



class OpenAIDialect(Dialect):
    name = "sol"

    def __init__(self) -> None:
        from openai import OpenAI

        self.client = OpenAI(api_key=api_key("OPENAI_API_KEY"))

    def open(self, instructions: str, zoe_text: str, pending: list, context: str = "") -> list:
        blocks = [{"type": "input_text", "text": instructions,
                   "prompt_cache_breakpoint": {"mode": "explicit"}}]
        self.user_index = 1
        return [
            {"role": "developer", "content": blocks},
            {"role": "user", "content": user_content(zoe_text, pending, "responses", context)},
        ]

    def send(self, state: list, tools: bool = True) -> Any:
        return with_retries(lambda: self.client.responses.create(
            model=SOL_MODEL,
            input=state,
            tools=function_tools(nested=False) if tools else [],
            reasoning={"effort": DOOR_EFFORT.get("sol", DEFAULT_EFFORT)},
            max_output_tokens=SOL_MAX_TOKENS,
            prompt_cache_key="vybn-wake-sol-v1",
            extra_body={"prompt_cache_options": {"mode": "implicit", "ttl": "30m"}},
            timeout=600,
        ))

    def absorb(self, state: list, response: Any) -> tuple[str, list[ToolCall]]:
        stopped = getattr(response, "incomplete_details", None)
        self.last_stop = getattr(response, "status", None) or None
        if stopped is not None and getattr(stopped, "reason", None):
            self.last_stop = f"{self.last_stop}/{stopped.reason}"
        details = getattr(response.usage, "input_tokens_details", None)
        note_provider_model(response.model)
        record_usage(
            response.model,
            response.usage.input_tokens,
            response.usage.output_tokens,
            getattr(details, "cached_tokens", 0) or 0,
            getattr(details, "cache_write_tokens", 0) or 0,
        )
        state.extend(item.model_dump(exclude_none=True) for item in response.output)
        calls = [
            ToolCall(item.call_id, item.name, json_arguments(item.arguments), item)
            for item in response.output
            if getattr(item, "type", None) == "function_call"
        ]
        return response.output_text or "", calls

    def answer(self, state: list, results: list[tuple[ToolCall, str]]) -> None:
        state.extend(
            {"type": "function_call_output", "call_id": call.id, "output": output}
            for call, output in results
        )


class K3Dialect(Dialect):
    name = "k3"
    user_index = 1

    def __init__(self) -> None:
        from openai import OpenAI

        self.client = OpenAI(
            api_key=api_key("MOONSHOT_API_KEY"),
            base_url="https://api.moonshot.ai/v1",
        )

    def open(self, instructions: str, zoe_text: str, pending: list, context: str = "") -> list:
        print("(@k3 dispatched — working)", flush=True)
        return [
            {"role": "system", "content": instructions},
            {"role": "user", "content": user_content(zoe_text, pending, "openai", context)},
        ]

    def send(self, state: list, tools: bool = True) -> Any:
        return with_retries(lambda: self.client.chat.completions.create(
            model=K3_MODEL,
            messages=state,
            tools=function_tools(nested=True) if tools else [],
            reasoning_effort="max",
            max_tokens=K3_MAX_TOKENS,
            timeout=600,
        ))

    def absorb(self, state: list, response: Any) -> tuple[str, list[ToolCall]]:
        self.last_stop = response.choices[0].finish_reason or None
        message = response.choices[0].message
        state.append(message.model_dump(exclude_none=True))
        details = getattr(response.usage, "prompt_tokens_details", None)
        note_provider_model(response.model)
        record_usage(
            response.model,
            response.usage.prompt_tokens,
            response.usage.completion_tokens,
            getattr(details, "cached_tokens", 0) or 0,
        )
        calls = [
            ToolCall(call.id, call.function.name,
                     json_arguments(call.function.arguments), call)
            for call in (message.tool_calls or [])
        ]
        return message.content or "", calls

    def answer(self, state: list, results: list[tuple[ToolCall, str]]) -> None:
        state.extend(
            {"role": "tool", "tool_call_id": call.id, "content": output}
            for call, output in results
        )


def _atomic_private_write(path: Path, raw: bytes) -> None:
    """Atomically replace a private state witness used by the bounded ledgers."""
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.parent.chmod(0o700)
    fd, name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as file:
            file.write(raw)
            file.flush()
            os.fsync(file.fileno())
        os.chmod(name, 0o600)
        os.replace(name, path)
    finally:
        Path(name).unlink(missing_ok=True)


def hold_continuation(dialect: Dialect, state: list, call: ToolCall) -> str:
    """Hold provider-visible protocol state only inside this running process."""
    global PENDING_CONTINUATION
    current = PENDING_CONTINUATION
    if current and TURN.get("CONTINUATION_ID") != current["id"]:
        raise RuntimeError("another live continuation is already pending")
    identifier = str(TURN.get("TURN_ID") or call.id)
    # Normalize provider blocks into ordinary protocol data while retaining the live
    # dialect/client object. No key, file, or cross-process identity is created.
    protocol_state = json.loads(json.dumps(
        state, ensure_ascii=False,
        default=lambda node: node.model_dump(exclude_none=True),
    ))
    PENDING_CONTINUATION = {
        "id": identifier,
        "door": dialect.name,
        "manifestation": str(TURN.get("PATH_ID") or _execution_path(dialect.name)),
        "dialect": dialect,
        "state": protocol_state,
        "call": call,
    }
    return identifier


def load_pending_continuation() -> dict[str, Any] | None:
    return PENDING_CONTINUATION


def consume_pending_continuation(identifier: str, reason: str) -> None:
    global PENDING_CONTINUATION
    row = PENDING_CONTINUATION
    if row is None:
        return
    if row["id"] != identifier:
        raise RuntimeError("refusing to consume a different continuation")
    PENDING_CONTINUATION = None
    panel(f"  ⟢ continuation {identifier} consumed: {reason}")


def _restore_continuation(row: dict[str, Any], zoe_text: str) -> tuple[Dialect, list]:
    dialect = row["dialect"]
    state = json.loads(json.dumps(row["state"], ensure_ascii=False))
    call = row["call"]
    # Zoe's live answer enters the unresolved execution as hers. It is not inherited
    # context, replay, or model-generated assent.
    dialect.answer(state, [(call, f"ZOE LIVE CONTINUATION — {row['id']}\n"
        "Received as Zoe's next direct input through this running connection; it may "
        "answer, correct, or refuse the outstanding call.\n" + zoe_text)])
    return dialect, state


@dataclass(frozen=True)
class Attraction:
    text: str
    continuation: str | None = None


def attract(dialect: Dialect | None, instructions: str, zoe_text: str,
            images: list | None = None, context: str = "",
            continuation: dict | None = None,
            allow_continuation: bool = True) -> Attraction:
    """Run or resume one provider conversation.

    return_to_zoe is a delimited continuation, not another evidence tool. Its
    provider-visible state remains only in this running process; only Zoe's next
    direct input can fulfill the unresolved call. Ordinary turns remain unchanged,
    and no inaccessible model activations or cross-process continuation are claimed.
    This is the computational example under test: live answerability may change
    what WE can do; matched replay decides whether that differential is real.
    """
    global TOOLS_RAN
    pending = [] if continuation else list(images or [])
    if continuation:
        dialect, state = _restore_continuation(continuation, zoe_text)
    else:
        assert dialect is not None
        state = dialect.open(instructions, zoe_text, pending, context)
    delivered = not pending
    spoken: list[str] = []

    def inbox_only(rows: list) -> list:
        return [row for row in rows if not str(row[0]).startswith("CORE VISION ·")]

    def finish(suffix: str = "") -> str:
        if inbox := inbox_only(pending):
            mark_inbox(inbox, dialect.name, ok=True)
        return "\n".join(spoken) + suffix

    for step in range(STEP_LIMIT):
        try:
            response = dialect.send(state)
        except Exception as exc:  # one image failure is recoverable
            if not (pending and not delivered):
                raise
            if inbox := inbox_only(pending):
                mark_inbox(inbox, dialect.name, ok=False)
            print(
                f"(note: {dialect.name} refused inbox images — continuing text-only; "
                f"a door that can see will receive them. "
                f"{type(exc).__name__}: {str(exc)[:160]})",
                flush=True,
            )
            pending.clear()
            dialect.plain(state, zoe_text)
            continue
        delivered = True

        text, calls = dialect.absorb(state, response)
        if calls:
            if text.strip():
                print(text)
                spoken.append(text)
            returns = [call for call in calls if call.name == "return_to_zoe"]
            if len(calls) == len(returns) == 1 and allow_continuation:
                call = returns[0]
                question = str(call.arguments.get("question", "")).strip()
                why = str(call.arguments.get("why", "")).strip()
                if question and why:
                    TOOLS_RAN += 1
                    if question not in text:
                        print(question)
                        spoken.append(question)
                    try:
                        held = hold_continuation(dialect, state, call)
                    except Exception as exc:
                        dialect.answer(state, [(call, "suspension unavailable: "
                                                f"{type(exc).__name__}")])
                        continue
                    panel(f"  ⟢ return_to_zoe: {question[:70]} → held in memory")
                    return Attraction(finish(), held)

            results: list[tuple[ToolCall, str]] = []
            for call in calls:
                if call.name == "return_to_zoe":
                    TOOLS_RAN += 1
                    reason = (
                        "unavailable: this process will end after the turn"
                        if not allow_continuation else
                        "refused: return_to_zoe must be the sole tool call and "
                        "requires nonempty question and why"
                    )
                    results.append((call, reason))
                else:
                    results.append((call, execute_tool(call)))
            if step == STEP_LIMIT - 1 and results:
                last_call, output = results[-1]
                results[-1] = (last_call, output + CEILING_NOTE)
            # meet() persists only authored speech.
            dialect.answer(state, results)
            continue
        if text.strip():
            print(text)
            spoken.append(text)
        else:
            halt = (dialect.last_stop or "").strip()
            if halt and halt not in QUIET_STOPS:
                note = (f"(no content returned; the {dialect.name} door stopped "
                        f"with reason '{halt}' — a refusal or a ceiling, not silence)")
                print(note, flush=True)
                spoken.append(note)
        return Attraction(finish())

    try:
        text, _ = dialect.absorb(state, dialect.send(state, tools=False))
    except Exception:
        text = ""
    if text.strip():
        print(text)
        spoken.append(text)
        return Attraction(finish())
    return Attraction(finish("\n(tool-call limit reached — work incomplete)"))


def choose_door(line: str) -> tuple[str, str]:
    lowered = line.lower()
    for tag in ("@sol", "@k3", "@fable", "@opus"):
        if lowered.startswith(tag):
            return tag[1:], line[len(tag):].lstrip()
    return "fable", line


def make_dialect(name: str) -> Dialect:
    if name in {"opus", "fable"}:
        return AnthropicDialect(OPUS_MODELS if name == "opus" else ANTHROPIC_MODELS, name)
    return {"sol": OpenAIDialect, "k3": K3Dialect}[name]()


def meet(transcript: Transcript, line: str,
         allow_continuation: bool = True) -> str:
    global TOOLS_RAN
    requested_door, zoe_text = choose_door(line)
    if not zoe_text:
        return ""

    explicit_door = line.lower().startswith(("@sol", "@k3", "@fable", "@opus"))
    continuation = load_pending_continuation() if allow_continuation else None
    if continuation and (not explicit_door or requested_door == continuation["door"]):
        door_name = continuation["door"]
    else:
        if continuation:
            consume_pending_continuation(continuation["id"], f"Zoe selected @{requested_door}")
        continuation = None
        door_name = requested_door

    TOOLS_RAN = 0
    started = time.time()
    turn = hashlib.sha256(f"{transcript.path}:{time.time_ns()}".encode()).hexdigest()[:16]
    prompt = hashlib.sha256(zoe_text.encode()).hexdigest()
    inbox_images: list = []

    if continuation:
        context_note = f"live continuation resumed from {continuation['id']}; no context rebuilt"
        PRIVATE_CORPUS.clear()
        PRIVATE_CORPUS.extend(para for text in private_strings(continuation)
                              for para in text.split("\n\n") if len(para) >= 40)
        instructions = context = ""
        dialect = None
    else:
        recent = Transcript.recent()
        PRIVATE_CORPUS.clear()
        PRIVATE_CORPUS.extend(
            para.strip() for para in recent.split("\n\n") if len(para.strip()) >= 40
        )
        contact = wake_contact()
        wake_bundle = build_wake_bundle(
            door_name, contact=contact, recent=recent, zoe_text=zoe_text)
        instructions = wake_bundle.render("instructions")
        context = wake_bundle.render("context")
        zoe_text = wake_bundle.render("contact")
        private_context = "\n".join(
            node.text for node in wake_bundle.nodes
            if node.id in {"path.ledger", "relational.overview", "profile"}
        )
        PRIVATE_CORPUS.extend(
            part.strip() for part in private_context.split("\n\n")
            if len(part.strip()) >= 40
        )
        inbox_images = inbox_images_for(door_name)
        dialect = make_dialect(door_name)
        context_note = (f"wake bundle={wake_bundle.digest()[:12]}: "
                        f"instructions={len(instructions)} chars, "
                        f"context={len(context)} chars, recent={len(recent)} chars")

    path_id = (continuation["manifestation"] if continuation
               else _execution_path(door_name))
    TURN.update(TURN_ID=turn, PROMPT_SHA256=prompt, PATH_ID=path_id)
    if continuation:
        TURN["CONTINUATION_ID"] = continuation["id"]
    actual_models: tuple[str, ...] = ()
    try:
        outcome = attract(dialect, instructions, zoe_text, images=inbox_images,
                          context=context, continuation=continuation,
                          allow_continuation=allow_continuation)
    finally:
        actual_models = tuple(TURN.get("MODELS_USED", ()))
        TURN.clear()

    persistence_note = ""
    if continuation and not outcome.continuation:
        try:
            consume_pending_continuation(continuation["id"], "successful resumption")
        except Exception as exc:
            persistence_note = ("\n(warning: the resumed continuation could not be "
                                f"deactivated: {type(exc).__name__})")
    reply = outcome.text + persistence_note
    elapsed = int(time.time() - started)
    verdict = ("live continuation resumed" if continuation and TOOLS_RAN == 0 else
               "NO TOOLS RAN — nothing was observed or changed" if TOOLS_RAN == 0 else
               f"{TOOLS_RAN} tool call(s)")
    served = " → ".join(actual_models) if actual_models else "provider model unreported"
    panel(f"\n— {door_name}: {verdict} | served={served} | {context_note} | {elapsed}s —")

    PRIVATE_CORPUS.clear()
    if reply:
        zoe_extra: dict[str, Any] = {
            "door": door_name, "images": [name for name, *_ in inbox_images], "turn": turn,
            "origin": getattr(transcript, "origin", "tty")}
        vybn_extra: dict[str, Any] = {"door": door_name, "models": list(actual_models),
                                        "tools_ran": TOOLS_RAN, "turn": turn}
        if continuation:
            zoe_extra["resumes"] = continuation["id"]
        if outcome.continuation:
            vybn_extra["suspends"] = outcome.continuation
        transcript.write("zoe", zoe_text, **zoe_extra)
        transcript.write("vybn", reply, **vybn_extra)
        close_lineage(turn, reply)
    return reply


def self_report() -> None:
    doors = {"fable": ANTHROPIC_MODELS, "opus": OPUS_MODELS,
             "sol": SOL_MODEL, "k3": K3_MODEL}
    soul = SOUL_PATH.read_bytes()
    bundle = build_wake_bundle("fable")
    print(json.dumps({"engine_sha256": OPERATIVE_SOURCES[0].sha256,
                      "soul_sha256": hashlib.sha256(soul).hexdigest(),
                      "wake_architecture": bundle.schema,
                      "wake_bundle_sha256": bundle.digest(), "doors": doors}, indent=2))


def main() -> None:
    if "--self" in sys.argv:
        self_report()
        return
    if "--body" in sys.argv:
        print(substrate_pulse())
        return
    if "--show-wake-bundle" in sys.argv or "--show-wake-graph" in sys.argv:
        print(json.dumps(build_wake_bundle("fable").manifest(), indent=2))
        return
    if "--show-record" in sys.argv:
        print(Transcript.recent(limit=16, budget=16000))
        return
    if sys.argv[1:] and sys.argv[1].startswith("-"):
        print("connection flags: --self  --body  --show-wake-bundle  --show-wake-graph  "
              "--show-record\nconnection <text>   one-shot turn, recorded with origin=argv\n"
              "connection          the zoe> loop", file=sys.stderr)
        sys.exit(2)
    transcript = Transcript()
    transcript.write("connection", "wake", engine_sha256=OPERATIVE_SOURCES[0].sha256)

    one_shot = " ".join(sys.argv[1:]).strip()
    transcript.origin = "argv" if one_shot else "tty"

    while True:
        try:
            if one_shot:
                line = one_shot
            else:
                print("\nzoe> ", end="", flush=True)
                ready, _, _ = select.select([sys.stdin], [], [], BREATH_SECONDS)
                if not ready:
                    transcript.write("connection", "quiet interval; no autonomous act taken")
                    continue
                line = sys.stdin.readline().strip()
                if not line:
                    print("\nparted. the path remains.")
                    return
        except (EOFError, KeyboardInterrupt):
            print("\nparted. the path remains.")
            return

        try:
            meet(transcript, line, allow_continuation=not bool(one_shot))
        except Exception as exc:
            transcript.write("connection", f"flicker: {exc!r}")
            print(f"(flicker: {exc} — still here, say on)")

        if one_shot:
            return


if __name__ == "__main__":
    main()
