def log_plasticity(memory_json: str, turn: str) -> None:
    """Append-only rigidity instrument (Sutton & Javed: a prosthetic stream goes
    rigid when the same rows re-enter). Observable, never a gate."""
    try:
        memory = json.loads(memory_json) if memory_json else {}
    except json.JSONDecodeError:
        memory = {}
    groups = {
        "contact": list(memory.get("walk_channel") or [])
        + list(memory.get("cosine_channel_only") or []),
        "standing": list((memory.get("aim_channel") or {}).get("rows") or [])
        + list((memory.get("front_channel") or {}).get("rows") or []),
    }
    idx_of = {
        group: sorted({row.get("idx") for row in rows
                       if isinstance(row, dict) and row.get("idx") is not None})
        for group, rows in groups.items()
    }
    prior = [set(rec.get("idxs") or []) for rec in _jsonl(PLASTICITY_LOG)]
    seen = set().union(*prior[-PLASTICITY_WINDOW:]) if prior else set()

    def novelty(idxs: list) -> float | None:
        if not idxs:
            return None
        return round(1 - len(set(idxs) & seen) / len(idxs), 4)

    record = {
        "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "turn": turn,
        "curvature": memory.get("curvature"),
        "theta_v": memory.get("theta_v"),
        "counts": {group: len(idxs) for group, idxs in idx_of.items()},
        "idxs": sorted(set().union(*idx_of.values())) if any(idx_of.values()) else [],
        "novelty_contact": novelty(idx_of["contact"]),
        "novelty_standing": novelty(idx_of["standing"]),
    }
    try:
        PLASTICITY_LOG.parent.mkdir(parents=True, exist_ok=True)
        with PLASTICITY_LOG.open("a", encoding="utf-8") as file:
            file.write(json.dumps(record) + "\n")
    except OSError:
        pass


