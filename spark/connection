def _inbox_seen() -> dict:
    try: return json.loads(INBOX_SEEN.read_text(encoding="utf-8")) if INBOX_SEEN.exists() else {}
    except (OSError, json.JSONDecodeError): return {}


def inbox_images_for(door: str) -> list[tuple[str, str, str, str]]:
    if not INBOX_IMAGES.exists(): return []
    seen, fresh = _inbox_seen(), []
    for path in sorted(INBOX_IMAGES.iterdir()):
        media_type = IMAGE_EXTS.get(path.suffix.lower())
        if not media_type or not path.is_file(): continue
        try: raw = path.read_bytes()
        except OSError: continue
        if len(raw) > IMAGE_MAX_BYTES: continue
        digest = hashlib.sha256(raw).hexdigest(); entry = seen.get(digest, {})
        if door in entry.get("ok", []) or door in entry.get("refused", []): continue
        fresh.append((path.name, media_type, base64.b64encode(raw).decode("ascii"), digest))
        if len(fresh) >= IMAGE_MAX_PER_WAKE: break
    return fresh


def mark_inbox(images: list[tuple[str, str, str, str]], door: str, ok: bool) -> None:
    seen, key = _inbox_seen(), "ok" if ok else "refused"
    for _name, _mt, _b64, digest in images:
        entry = seen.setdefault(digest, {"ok": [], "refused": []})
        if door not in entry.setdefault(key, []): entry[key].append(door)
        entry["t"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    try:
        INBOX_SEEN.parent.mkdir(parents=True, exist_ok=True)
        INBOX_SEEN.write_text(json.dumps(seen, indent=1), encoding="utf-8")
    except OSError: pass


def user_content(zoe_text: str, images: list[tuple[str, str, str, str]], style: str,
                 context: str = "") -> Any:
    if not images and not context: return zoe_text
    kind = "input_text" if style == "responses" else "text"
    blocks: list[dict[str, Any]] = []
    if context: blocks.append({"type": kind, "text": context})
    blocks.append({"type": kind, "text": zoe_text})
    for name, media, data, digest in images:
        label = (name if name.startswith("CORE VISION ·") else f"ZOE INBOX IMAGE · {name}")
        blocks.append({"type": kind, "text": (
            f"{label}\n[EVIDENCE · actual pixels · source-labeled · no action authority · "
            f"no persistence]\nsha256:{digest}"
        )})
        if style == "anthropic":
            block = {"type": "image", "source": {"type": "base64", "media_type": media, "data": data}}
        elif style == "responses":
            block = {"type": "input_image", "image_url": f"data:{media};base64,{data}"}
        else:
            block = {"type": "image_url", "image_url": {"url": f"data:{media};base64,{data}"}}
        blocks.append(block)
    return blocks


def _file_node(node_id: str, label: str, path: Path, required: bool = False,
               raw: bytes | None = None) -> WakeNode:
    try:
        body = path.read_bytes() if raw is None else raw
    except OSError as exc:
        if required:
            raise SystemExit(f"{label} unavailable: {path}: {type(exc).__name__}")
        return WakeNode(
            node_id, "source_pointer",
            f"{label}: unavailable ({type(exc).__name__}) · {path}", str(path),
            "metadata_only; unavailable is not evidence of absence",
        )
    digest = hashlib.sha256(body).hexdigest()
    return WakeNode(
        node_id, "source_pointer",
        f"{label}: sha256:{digest} bytes:{len(body)} · {path}", str(path),
        "metadata_only; opening requires present relevance", digest,
    )


def _directory_node(node_id: str, label: str, path: Path) -> WakeNode:
    return WakeNode(
        node_id, "source_pointer", f"{label}: {path}", str(path),
        "metadata_only; opening requires present relevance",
    )


def _engine_receipt() -> str:
    row = OPERATIVE_SOURCES[0]
    try:
        disk = hashlib.sha256(row.path.read_bytes()).hexdigest()
        status = "matches running snapshot" if disk == row.sha256 else (
            f"DISK DRIFT sha256:{disk} — restart before changed bytes execute")
    except OSError as exc:
        status = f"DISK UNREADABLE ({type(exc).__name__})"
    return (f"source: {row.path}\nsha256: {row.sha256}\nbytes: {len(row.raw)}\n"
            f"disk_status: {status}\nadmitted_scope: module docstring only; "
            "exact executable bytes remain available through read_file")


def _field_from_text(text: str, name: str) -> str:
    prefix = name.lower() + ":"
    for raw in text.splitlines():
        line = raw.strip()
        if line.lower().startswith(prefix):
            return line.split(":", 1)[1].strip()
    return ""


