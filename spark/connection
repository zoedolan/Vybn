}

PUBLIC_MUTATION = re.compile(
    r"(?:^|[;&|]\s*)"
    r"(?:git\s+push|"
    r"gh\s+pr\s+(?:create|merge)|"
    r"gh\s+release\s+create|"
    r"npm\s+publish|"
