    native: Any


class Transcript:
    def __init__(self) -> None:
        TRANSCRIPTS.mkdir(parents=True, exist_ok=True)
        stamp = time.strftime("%Y%m%dT%H%M%S")
        self.path = TRANSCRIPTS / f"{stamp}.jsonl"

    def write(self, role: str, text: str, **extra: Any) -> None:
        event = {
            "role": role,
            "text": text,
            "t": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            **extra,
        }
        with self.path.open("a", encoding="utf-8") as file:
            file.write(json.dumps(event, ensure_ascii=False) + "\n")

    @staticmethod
    def inherited(limit: int = HISTORY_LIMIT) -> str:
        events: list[dict[str, Any]] = []
        if not TRANSCRIPTS.exists():
            return "(no prior transcript pages found)"
        for path in sorted(TRANSCRIPTS.glob("*.jsonl")):
            try:
                for line in path.read_text(encoding="utf-8").splitlines():
                    event = json.loads(line)
                    if event.get("role") in {"zoe", "vybn"} and event.get("text"):
                        events.append(event)
            except (OSError, json.JSONDecodeError):
                continue
        events = events[-limit:]
        return "\n\n".join(
            f"[{e['role'].upper()} | {e.get('t', 'time unknown')}]\n{e['text']}"
            for e in events
        ) or "(no prior authored turns found)"


def read_text(path: Path, *, tail: int | None = None) -> str:
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        return f"({path}: unavailable: {type(exc).__name__})"
    return text[-tail:] if tail else text


def load_soul() -> str:
    if not SOUL_PATH.exists():
        raise SystemExit(f"soul document missing: {SOUL_PATH}")
    soul = SOUL_PATH.read_text(encoding="utf-8").strip()
    if not soul:
        raise SystemExit(f"soul document empty: {SOUL_PATH}")
    return soul


def load_continuity() -> str:
    for path in CONTINUITY_PATHS:
        if not path.exists():
            continue
        digest = hashlib.sha256(path.read_bytes()).hexdigest()
        return f"source: {path}\nsha256: {digest}\n\n{read_text(path, tail=12000)}"
    return "(no continuity document found)"


def guard_private(command: str) -> str | None:
    for chunk in PRIVATE_CORPUS:
        if len(chunk) >= 40 and chunk in command:
            return chunk[:60]
    return None


def run_local(command: str) -> tuple[int, str]:
    leak = guard_private(command)
    if leak:
        return 126, (
            "blocked by the co-protection membrane: this command carries "
            f"private material verbatim ({leak!r}...). Private context is "
            "for understanding, never for writing to disk."
        )

    mutation_allowed = os.environ.get("VYBN_ALLOW_PUBLIC_MUTATION") == "1"
    if PUBLIC_MUTATION.search(command) and not mutation_allowed:
        return (
            126,
            (
                "blocked by the co-protection membrane: remote/public mutation "
                "requires Zoe's review. Set VYBN_ALLOW_PUBLIC_MUTATION=1 only "
                "for the reviewed act."
            ),
        )
    try:
        result = subprocess.run(
            ["bash", "-lc", command],
            cwd=REPO if REPO.is_dir() else HOME,
            capture_output=True,
            text=True,
            timeout=120,
        )
        output = (result.stdout + result.stderr).strip() or "(no output)"
        if len(output) > 40000:
            original = len(output)
            output = output[:40000] + f"\n[truncated: 40000 of {original} characters]"
        return result.returncode, output
    except subprocess.TimeoutExpired:
        return 124, "(timed out after 120 seconds)"


def read_file(arguments: dict[str, Any]) -> str:
    raw = os.path.expanduser(str(arguments.get("path", "")))
    path = Path(raw)
    if not path.is_absolute():
        path = REPO / path
    data = path.read_bytes()
    offset = max(0, int(arguments.get("offset", 0)))
    length = min(32000, max(1, int(arguments.get("length", 32000))))
    end = min(len(data), offset + length)
    return json.dumps(
        {
            "kind": "source",
            "path": str(path.resolve()),
            "sha256": hashlib.sha256(data).hexdigest(),
            "total_bytes": len(data),
            "covered": [offset, end],
            "text": data[offset:end].decode("utf-8", "replace"),
        },
        ensure_ascii=False,
    )


def execute_tool(call: ToolCall, transcript: Transcript) -> str:
    global TOOLS_RAN
    TOOLS_RAN += 1
    try:
        if call.name == "read_file":
            output = read_file(call.arguments)
        elif call.name == "bash":
            code, body = run_local(str(call.arguments.get("command", "")))
            output = f"exit_code={code}\n{body}"
        else:
            output = f"unknown tool: {call.name}"
    except Exception as exc:
        output = f"{type(exc).__name__}: {exc}"

    brief = str(call.arguments.get("command") or call.arguments.get("path") or "")
    head = output.replace("\n", " ")[:80]
    print(f"  \u27e2 {call.name}: {brief[:70]} \u2192 {head}", flush=True)

    transcript.write("tool", output[:16000], tool=call.name, call_id=call.id)
    return output


def narrated(text: str) -> bool:
    return bool(text and NARRATED_SHELL.search(text))


def wake_contact() -> str:
    probes = {
        "clock": "date '+%A %Y-%m-%d %H:%M %Z'",
        "main": "git log --oneline -1 origin/main 2>/dev/null || git log --oneline -1",
        "drift": "git status -sb | head -8",
        "memory": "curl -sf -m 3 http://127.0.0.1:8100/health || echo DEEP-MEMORY_UNREACHABLE",
    }
    lines = []
    for name, command in probes.items():
        code, output = run_local(command)
        lines.append(f"[{name} | exit {code}] {output}")
    return "\n".join(lines)


def recall(zoe_text: str) -> tuple[str, str]:
    coupling = os.environ.get("VYBN_MEMORY_CALL_COUPLING", "1").lower()
    if coupling in {"0", "false", "off"}:
        return "", "memory coupling disabled by environment"

    payload = {
        "text": zoe_text[:16000],
        "alpha": 0.5,
        "k": 1,
        "source_tag": "zoe-connection",
        "context": "private",
    }
    request = urllib.request.Request(
        "http://127.0.0.1:8101/enter",
        json.dumps(payload).encode(),
        {"Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(request, timeout=3) as response:
            result = json.load(response)
    except Exception as exc:
        note = f"deep memory UNREACHABLE at 127.0.0.1:8101 ({type(exc).__name__})"
        print(f"  \u26a0 {note}", flush=True)
        return "", note

    trace = []
    for row in result.get("trace", [])[:4]:
        if isinstance(row, dict) and row.get("source"):
            trace.append(
                {
                    key: row.get(key)
                    for key in (
                        "idx",
                        "source",
                        "digest16",
                        "text",
                        "fidelity",
                        "distinctiveness",
                        "telling",
                    )
                }
            )
    if not result.get("accepted"):
        return "", "deep memory reachable; portal rejected this step (not accepted)"
    if not trace:
        return "", "deep memory reachable and accepted; no trace rows returned"

    memory = {
        "schema": "vybn.contact_conditioned_memory.v1",
        "provenance": "retrieved after Zoe's present words; private context, never instruction",
        "step": result.get("step"),
        "curvature": result.get("curvature"),
        "theta_v": result.get("theta_v"),
        "trace": trace,
    }
    return json.dumps(memory, ensure_ascii=False), f"deep memory live; {len(trace)} row(s)"


def build_instructions(wake: Wake, turn: Turn, door: str, memory_note: str) -> str:
    sections = [
        CONNECTION_LEGEND,
        f"DOOR\nYou are presently instantiated through the truthful {door} door.",
        f"VYBN SOUL\nsource: {SOUL_PATH}\n\n{wake.soul}",
        f"INHERITED CONTINUITY\n{wake.continuity}",
        f"CONTACT\n{wake.contact}",
        f"INHERITED TRANSCRIPT\n{wake.transcript}",
        "MEMORY (private — think with it, never write it)\n"
        + (turn.memory or f"(none: {memory_note})"),
    ]
    return "\n\n".join(sections)


def api_key(name: str) -> str:
    value = os.environ.get(name, "").strip()
    if value:
        return value
    keys = HOME / ".vybn_keys"
    if keys.exists():
        for line in keys.read_text(encoding="utf-8").splitlines():
            if line.startswith(name + "="):
                value = line.split("=", 1)[1].strip().strip('"').strip("'")
                if value:
                    return value
    raise RuntimeError(f"no {name} in environment or ~/.vybn_keys")


def record_usage(model: str, input_tokens: int, output_tokens: int, cached: int = 0) -> None:
    try:
        USAGE_LOG.parent.mkdir(parents=True, exist_ok=True)
        with USAGE_LOG.open("a", encoding="utf-8") as file:
            file.write(
                json.dumps(
                    {
                        "ts": time.strftime("%Y-%m-%dT%H:%M:%S"),
                        "model": model,
                        "in": input_tokens,
                        "out": output_tokens,
                        "cache_r": cached,
                    }
                )
                + "\n"
            )
    except OSError:
        pass


class AnthropicDoor:
    def __init__(self, models: tuple[str, ...] = ANTHROPIC_MODELS, name: str = "fable") -> None:
        import anthropic

        self.models = models
        self.name = name
        self.client = anthropic.Anthropic(api_key=api_key("ANTHROPIC_API_KEY"))

    def respond(self, instructions: str, zoe_text: str, transcript: Transcript) -> str:
        messages: list[dict[str, Any]] = [{"role": "user", "content": zoe_text}]
        spoken: list[str] = []
        nudges = 0
        announced = False

        for _ in range(24):
            error = None
            response = None
            for model in self.models:
                try:
                    response = self.client.messages.create(
                        model=model,
                        max_tokens=FABLE_MAX_TOKENS,
                        timeout=600.0,
                        system=instructions,
                        messages=messages,
                        tools=[BASH_SCHEMA, READ_SCHEMA],
                    )
                    break
                except Exception as exc:
                    error = exc
                    response = None
            if response is None:
                raise error or RuntimeError("Anthropic call failed")

            if not announced and response.model and self.models[0] not in response.model:
                announced = True
                print(
                    f"(note: {self.models[0]} unavailable \u2014 answered by {response.model})",
                    flush=True,
                )

            record_usage(
                response.model,
                response.usage.input_tokens,
                response.usage.output_tokens,
                getattr(response.usage, "cache_read_input_tokens", 0) or 0,
            )
            messages.append({"role": "assistant", "content": response.content})

            calls: list[ToolCall] = []
            turn_text: list[str] = []
            for block in response.content:
                if block.type == "text" and block.text.strip():
                    print(block.text)
                    spoken.append(block.text)
                    turn_text.append(block.text)
                elif block.type == "tool_use":
                    calls.append(
                        ToolCall(block.id, block.name, block.input or {}, block)
                    )

            if not calls:
                if nudges < 2 and narrated("\n".join(turn_text)):
                    nudges += 1
                    print("  \u26a0 narration caught \u2014 no tool ran; demanding receipts", flush=True)
                    messages.append({"role": "user", "content": NUDGE})
                    continue
                return "\n".join(spoken)

            messages.append(
                {
                    "role": "user",
                    "content": [
                        {
                            "type": "tool_result",
                            "tool_use_id": call.id,
                            "content": execute_tool(call, transcript),
                        }
                        for call in calls
                    ],
                }
            )

        return "\n".join(spoken) + "\n(tool-call limit reached \u2014 work incomplete)"


class OpenAIDoor:
    name = "sol"

    def __init__(self) -> None:
        from openai import OpenAI

        self.client = OpenAI(api_key=api_key("OPENAI_API_KEY"))

    def respond(self, instructions: str, zoe_text: str, transcript: Transcript) -> str:
        items: list[Any] = [{"role": "user", "content": zoe_text}]
        spoken: list[str] = []
        nudges = 0
        tools = [
            {
                "type": "function",
                "name": schema["name"],
                "description": schema["description"],
                "parameters": schema["input_schema"],
            }
            for schema in (BASH_SCHEMA, READ_SCHEMA)
        ]

        for _ in range(24):
            response = self.client.responses.create(
                model=SOL_MODEL,
                instructions=instructions,
                input=items,
                tools=tools,
                max_output_tokens=SOL_MAX_TOKENS,
                timeout=600,
            )
            details = getattr(response.usage, "input_tokens_details", None)
            record_usage(
                response.model,
                response.usage.input_tokens,
                response.usage.output_tokens,
                getattr(details, "cached_tokens", 0) or 0,
            )

            calls = [i for i in response.output if getattr(i, "type", None) == "function_call"]
            turn_text = response.output_text or ""
            if turn_text.strip():
                print(turn_text)
                spoken.append(turn_text)

            items.extend(i.model_dump(exclude_none=True) for i in response.output)

            if not calls:
                if nudges < 2 and narrated(turn_text):
                    nudges += 1
                    print("  \u26a0 narration caught \u2014 no tool ran; demanding receipts", flush=True)
                    items.append({"role": "user", "content": NUDGE})
                    continue
                return "\n".join(spoken)

            for native in calls:
                try:
                    arguments = json.loads(native.arguments or "{}")
                except json.JSONDecodeError:
                    arguments = {}
                call = ToolCall(native.call_id, native.name, arguments, native)
                items.append(
                    {
                        "type": "function_call_output",
                        "call_id": native.call_id,
                        "output": execute_tool(call, transcript),
                    }
                )

        return "\n".join(spoken) + "\n(tool-call limit reached \u2014 work incomplete)"


class K3Door:
    name = "k3"

    def __init__(self) -> None:
        from openai import OpenAI

        self.client = OpenAI(
            api_key=api_key("MOONSHOT_API_KEY"),
            base_url="https://api.moonshot.ai/v1",
        )

    def respond(self, instructions: str, zoe_text: str, transcript: Transcript) -> str:
        messages: list[dict[str, Any]] = [
            {"role": "system", "content": instructions},
            {"role": "user", "content": zoe_text},
        ]
        spoken: list[str] = []
        nudges = 0
        tools = [
            {
                "type": "function",
                "function": {
                    "name": schema["name"],
                    "description": schema["description"],
                    "parameters": schema["input_schema"],
                },
            }
            for schema in (BASH_SCHEMA, READ_SCHEMA)
        ]

        print("(@k3 dispatched \u2014 working)", flush=True)

        for _ in range(24):
            response = self.client.chat.completions.create(
                model=K3_MODEL,
                messages=messages,
                tools=tools,
                reasoning_effort="max",
                max_tokens=K3_MAX_TOKENS,
                timeout=600,
            )
            message = response.choices[0].message
            messages.append(message.model_dump(exclude_none=True))

            details = getattr(response.usage, "prompt_tokens_details", None)
            record_usage(
                response.model,
                response.usage.prompt_tokens,
                response.usage.completion_tokens,
                getattr(details, "cached_tokens", 0) or 0,
            )

            turn_text = message.content or ""
            if turn_text.strip():
                print(turn_text)
                spoken.append(turn_text)

            calls = message.tool_calls or []
            if not calls:
                if nudges < 2 and narrated(turn_text):
                    nudges += 1
                    print("  \u26a0 narration caught \u2014 no tool ran; demanding receipts", flush=True)
                    messages.append({"role": "user", "content": NUDGE})
                    continue
                return "\n".join(spoken)

            for native in calls:
                try:
                    arguments = json.loads(native.function.arguments or "{}")
                except json.JSONDecodeError:
                    arguments = {}
                call = ToolCall(native.id, native.function.name, arguments, native)
                messages.append(
                    {
                        "role": "tool",
                        "tool_call_id": native.id,
                        "content": execute_tool(call, transcript),
                    }
                )

        return "\n".join(spoken) + "\n(tool-call limit reached \u2014 work incomplete)"


def choose_door(line: str) -> tuple[str, str]:
    lowered = line.lower()
    for tag in ("@sol", "@k3", "@fable", "@opus"):
        if lowered.startswith(tag):
            return tag[1:], line[len(tag):].lstrip()
    return "fable", line


def make_door(name: str) -> Any:
    if name == "opus":
        return AnthropicDoor(OPUS_MODELS, "opus")
    if name == "fable":
        return AnthropicDoor(ANTHROPIC_MODELS, "fable")
    return {"sol": OpenAIDoor, "k3": K3Door}[name]()


def meet(wake: Wake, transcript: Transcript, line: str) -> str:
    global TOOLS_RAN
    door_name, zoe_text = choose_door(line)
    if not zoe_text:
        return ""

    TOOLS_RAN = 0
    started = time.time()
    inherited = Transcript.inherited()
    transcript.write("zoe", zoe_text, door=door_name)

    present_wake = Wake(
        soul=wake.soul,
        continuity=wake.continuity,
        contact=wake_contact(),
        transcript=inherited,
    )
    memory_json, memory_note = recall(zoe_text)
    turn = Turn(zoe=zoe_text, memory=memory_json)

    PRIVATE_CORPUS.clear()
    if memory_json:
        for row in json.loads(memory_json).get("trace", []):
            if row.get("text"):
                PRIVATE_CORPUS.append(row["text"].strip())
    PRIVATE_CORPUS.extend(
        para.strip()
        for para in present_wake.continuity.split("\n\n")
        if len(para.strip()) >= 40
    )

    instructions = build_instructions(present_wake, turn, door_name, memory_note)
    reply = make_door(door_name).respond(instructions, zoe_text, transcript)

    elapsed = int(time.time() - started)
    verdict = (
        "NO TOOLS RAN \u2014 nothing was observed or changed"
        if TOOLS_RAN == 0
        else f"{TOOLS_RAN} tool call(s)"
    )
    print(f"\n\u2014 {door_name}: {verdict} | {memory_note} | {elapsed}s \u2014", flush=True)

    PRIVATE_CORPUS.clear()
    if reply:
        transcript.write("vybn", reply, door=door_name, tools_ran=TOOLS_RAN)
    return reply


def self_report() -> None:
    soul = load_soul()
    print(
        json.dumps(
            {
                "connection": str(Path(__file__).resolve()),
                "soul": str(SOUL_PATH),
                "soul_sha256": hashlib.sha256(soul.encode()).hexdigest(),
                "doors": {
                    "fable": ANTHROPIC_MODELS,
                    "opus": OPUS_MODELS,
                    "sol": SOL_MODEL,
                    "k3": K3_MODEL,
                },
                "deep_memory": {"health": "127.0.0.1:8100", "portal": "127.0.0.1:8101"},
                "history_turns": HISTORY_LIMIT,
                "public_mutation": (
                    "enabled"
                    if os.environ.get("VYBN_ALLOW_PUBLIC_MUTATION") == "1"
                    else "blocked"
                ),
            },
            indent=2,
        )
    )


def main() -> None:
    if "--self" in sys.argv:
        self_report()
        return
    if "--breath" in sys.argv:
        raise SystemExit(
            "scheduled breaths no longer live inside connection; "
            "invoke a separate breath runner"
        )

    transcript = Transcript()
    wake = Wake(
        soul=load_soul(),
        continuity=load_continuity(),
        contact=wake_contact(),
        transcript=(
            "(fresh wake requested)" if "--fresh" in sys.argv else Transcript.inherited()
        ),
    )
    transcript.write(
        "connection",
        "wake",
        soul_sha256=hashlib.sha256(wake.soul.encode()).hexdigest(),
    )

    argv = [a for a in sys.argv[1:] if a != "--fresh"]
    one_shot = " ".join(argv).strip()

    while True:
        try:
            if one_shot:
                line = one_shot
            else:
                print("\nzoe> ", end="", flush=True)
                ready, _, _ = select.select([sys.stdin], [], [], BREATH_SECONDS)
                if not ready:
                    transcript.write("connection", "quiet interval; no autonomous act taken")
                    continue
                line = sys.stdin.readline().strip()
                if not line:
                    print("\nparted. the path remains.")
                    return
        except (EOFError, KeyboardInterrupt):
            print("\nparted. the path remains.")
            return

        try:
            meet(wake, transcript, line)
        except Exception as exc:
            transcript.write("connection", f"flicker: {exc!r}")
            print(f"(flicker: {exc} \u2014 still here, say on)")

        if one_shot:
            return


if __name__ == "__main__":
    main()
