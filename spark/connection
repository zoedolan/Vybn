class Transcript:
    def __init__(self) -> None:
        TRANSCRIPTS.mkdir(parents=True, exist_ok=True)
        stamp = time.strftime("%Y%m%dT%H%M%S")
        self.path = TRANSCRIPTS / f"{stamp}.jsonl"

    def write(self, role: str, text: str, **extra: Any) -> None:
        event = {"role": role, "text": text,
                 "t": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), **extra}
        with self.path.open("a", encoding="utf-8") as file:
            file.write(json.dumps(event, ensure_ascii=False) + "\n")

    @staticmethod
    def _recent_events(limit: int = RECENT_TURNS) -> list[dict[str, Any]]:
        """Select the latest events by timestamp from bounded tails of recent files."""
        if limit <= 0 or not TRANSCRIPTS.is_dir():
            return []
        try:
            paths = sorted(
                TRANSCRIPTS.glob("*.jsonl"),
                key=lambda path: path.stat().st_mtime_ns,
                reverse=True,
            )[:8]
        except OSError:
            paths = []
        found: list[tuple[str, int, dict[str, Any]]] = []
        sequence = 0
        for path in paths:
            try:
                with path.open("rb") as file:
                    size = file.seek(0, os.SEEK_END)
                    start = max(0, size - RECENT_FILE_BYTES)
                    file.seek(start)
                    raw = file.read()
                if start:
                    raw = raw.partition(b"\n")[2]
            except OSError:
                continue
            for line in raw.splitlines():
                try:
                    event = json.loads(line)
                except Exception:
                    continue
                rows: list[dict[str, Any]] = []
                if event.get("role") in {"zoe", "vybn"} and event.get("text"):
                    rows.append(event)
                elif event.get("zoe") and event.get("vybn"):
                    stamp = event.get("ts", "?")
                    rows.extend((
                        {"role": "zoe", "text": event["zoe"], "t": stamp},
                        {"role": "vybn", "text": event["vybn"], "t": stamp},
                    ))
                for row in rows:
                    found.append((str(row.get("t", "")), sequence, row))
                    sequence += 1
        found.sort(key=lambda item: (item[0], item[1]))
        return [row for _, _, row in found[-limit:]]

    @staticmethod
    def recent(limit: int = RECENT_TURNS, budget: int = RECENT_CHARS) -> str:
        events = Transcript._recent_events(limit)
        if not events or budget <= 0:
            return ""
        marker = "\n[…middle text clipped…]\n"
        rows: list[tuple[str, str]] = []
        remaining = budget
        # Keep the newest events that fit labeled, honest excerpts. A long
        # message must not consume the window before its interlocutor arrives.
        for event in reversed(events):
            role = str(event.get('role', '?')).upper()
            if event.get("origin") == "argv":
                role += "·argv"
            if event.get("status") == "interrupted":
                role += "·interrupted"
            head = f"[{str(event.get('t', '?'))} {role}]\n"
            text = str(event.get("text", "")).strip()
            minimum = len(head) + min(len(text), len(marker) + 2) + (2 if rows else 0)
            if minimum > remaining:
                break
            rows.append((head, text))
            remaining -= minimum
        available = budget - sum(len(head) for head, _ in rows) - 2 * max(0, len(rows) - 1)
        sizes: dict[int, int] = {}
        # Short messages stay whole; the others share what remains, without
        # assigning either speaker a higher rank or generating a synopsis.
        for i in sorted(range(len(rows)), key=lambda i: len(rows[i][1])):
            sizes[i] = min(len(rows[i][1]), available // (len(rows) - len(sizes)))
            available -= sizes[i]
        rendered: list[str] = []
        for i, (head, text) in enumerate(rows):
            if len(text) > sizes[i]:
                keep = sizes[i] - len(marker)
                left = keep // 2
                text = text[:left] + marker + text[-(keep - left):]
            rendered.append(head + text)
        return "\n\n".join(reversed(rendered))


