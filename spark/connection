@dataclass(frozen=True)
class WakeGraph:
    """The wake's whole organizing primitive: grounded nodes, relations, and paths."""

    nodes: tuple[WakeNode, ...]
    edges: tuple[WakeEdge, ...]
    routes: tuple[WakeRoute, ...]
    schema: str = "vybn.source_bound_wake_graph.v1"

    def __post_init__(self) -> None:
        ids = [node.id for node in self.nodes]
        if len(ids) != len(set(ids)):
            raise ValueError("wake graph node ids must be unique")
        known = set(ids)
        if any(edge.source not in known or edge.target not in known for edge in self.edges):
            raise ValueError("wake graph edge refers to an unknown node")
        route_ids = [route.id for route in self.routes]
        if len(route_ids) != len(set(route_ids)):
            raise ValueError("wake graph route ids must be unique")
        if any(node not in known for route in self.routes for node in route.nodes):
            raise ValueError("wake graph route refers to an unknown node")

    def render(self, route_id: str) -> str:
        route = next((route for route in self.routes if route.id == route_id), None)
        if route is None:
            raise KeyError(f"unknown wake route: {route_id}")
        by_id = {node.id: node for node in self.nodes}
        return "\n\n".join(
            by_id[node_id].text for node_id in route.nodes if by_id[node_id].text
        )

    def structure(self) -> dict[str, Any]:
        """The complete topology and provenance, with every payload excluded."""
        return {
            "schema": self.schema,
            "nodes": [
                {
                    "id": node.id,
                    "kind": node.kind,
                    "source": node.source,
                    "source_sha256": node.source_sha256 or None,
                    "authority": node.authority,
                }
                for node in self.nodes
            ],
            "edges": [
                {"from": edge.source, "relation": edge.relation, "to": edge.target}
                for edge in self.edges
            ],
            "routes": [
                {"id": route.id, "nodes": list(route.nodes)} for route in self.routes
            ],
        }

    def structure_digest(self) -> str:
        raw = json.dumps(
            self.structure(), ensure_ascii=False, sort_keys=True, separators=(",", ":")
        ).encode()
        return hashlib.sha256(raw).hexdigest()

    def manifest(self) -> dict[str, Any]:
        """Inspect structure and provenance without copying any node payload."""
        manifest = self.structure()
        for row, node in zip(manifest["nodes"], self.nodes, strict=True):
            row["payload_sha256"] = hashlib.sha256(node.text.encode()).hexdigest()
            row["chars"] = len(node.text)
        return manifest

    def digest(self) -> str:
        raw = json.dumps(
            self.manifest(), ensure_ascii=False, sort_keys=True, separators=(",", ":")
        ).encode()
        return hashlib.sha256(raw).hexdigest()


