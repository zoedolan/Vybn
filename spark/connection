def aim_field(name: str) -> str:
    try:
        prefix = name.lower() + ":"
        for raw in AIM_PATH.read_text(encoding="utf-8").splitlines():
            line = raw.strip()
            if line.lower().startswith(prefix):
                return line.split(":", 1)[1].strip()
    except OSError:
        pass
    return ""


def _is_relative_to(path: Path, root: Path) -> bool:
    try:
        path.relative_to(root)
        return True
    except ValueError:
        return False


