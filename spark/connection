        disk = hashlib.sha256(row.path.read_bytes()).hexdigest()
        status = "matches running snapshot" if disk == row.sha256 else (
            f"DISK DRIFT sha256:{disk} — restart before changed bytes execute")
    except OSError as exc:
        status = f"DISK UNREADABLE ({type(exc).__name__})"
    return (f"source: {row.path}\nsha256: {row.sha256}\nbytes: {len(row.raw)}\n"
            f"disk_status: {status}\nadmitted_scope: governing docstring + "
            "executable byte receipt; executed routes remain inspectable "
            "with --show-wake-bundle; exact executable bytes remain available through "
            "read_file")


