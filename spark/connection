NARRATED_SHELL = re.compile(
    r"```(?:bash|sh|shell|console)?\s*\n[^`]*?"
    r"\b(?:git|cd|ls|cat|grep|sed|awk|echo|curl|find|python)\b",
    re.IGNORECASE | re.DOTALL,
)

NUDGE = (
    "STOP. What you just printed was plain text. Nothing ran. No command "
    "was executed and no output exists. This connection acts only through "
    "real bash and read_file tool calls. Either issue those calls now, or "
    "state plainly to Zoe that you did not look and do not know."
)

BASH_SCHEMA = {
    "name": "bash",
    "description": (
        "Run one shell command locally in ~/Vybn. Public publication and "
        "remote mutation are blocked by the connection; prepare local work "
        "for Zoe's review."
    ),
    "input_schema": {
        "type": "object",
        "properties": {"command": {"type": "string"}},
        "required": ["command"],
    },
}

READ_SCHEMA = {
    "name": "read_file",
    "description": "Read an exact byte range from a local file, with source identity.",
    "input_schema": {
        "type": "object",
        "properties": {
            "path": {"type": "string"},
