# Shell-text refusal is a backstop, not OS containment: unknown code stays data.
UNTRUSTED_ACQUISITION = re.compile(
    r"(?im)(?:^|[;&|]\s*|\n)\s*(?:env\s+|command\s+|sudo\s+)*(?:"
    r"(?:[\w./-]+/)?(?:git\s+(?:-\S+\s+)*clone|gh\s+repo\s+clone|"
    r"(?:python[0-9.]*\s+-m\s+)?pip[0-9.]*\s+install|uv\s+(?:pip\s+install|tool\s+install|sync)|"
    r"npm\s+(?:i|install|ci)|pnpm\s+(?:add|install)|yarn\s+(?:add|install)|"
    r"cargo\s+install|go\s+install|(?:apt(?:-get)?|dnf|yum|conda|mamba|gem)\s+install|"
    r"docker\s+(?:pull|run))\b|wget\b|curl\b[^\n]*(?:\|(?!\|)|>{1,2}\s*\S+|(?:^|\s)(?:-o|--output)(?:\s|=)))")


def guard_untrusted_acquisition(command: str) -> str | None:
    found = UNTRUSTED_ACQUISITION.search(command)
    return " ".join(found.group().split())[:100] if found else None


