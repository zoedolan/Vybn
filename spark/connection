@contextmanager
def _private_lock(path: Path, operation: int):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.parent.chmod(0o700)
    fd = os.open(path, os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        os.fchmod(fd, 0o600)
        fcntl.flock(fd, operation)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def _private_bytes(path: Path, maximum: int, error: type[ValueError]) -> bytes:
    if path.is_symlink():
        raise error(f"{path.name} is a symbolic link")
    stat = path.stat()
    if stat.st_mode & 0o077:
        raise error(f"{path.name} mode {stat.st_mode & 0o777:o} is not private")
    if stat.st_size > maximum:
        raise error(f"{path.name} exceeds {maximum} bytes")
    return path.read_bytes()


def _event_digest(row: dict[str, Any]) -> str:
    body = {key: value for key, value in row.items() if key != "hash"}
    raw = json.dumps(body, ensure_ascii=False, sort_keys=True,
                     separators=(",", ":")).encode()
    return hashlib.sha256(raw).hexdigest()


class TransformStateError(ValueError):
    """The private transform record is malformed or disagrees with its witness."""


@dataclass(frozen=True)
class EventSegment:
    digest: str
    event_raw: bytes
    events: tuple[dict[str, Any], ...]
    prior: str
    prior_head: str


@dataclass(frozen=True)
class EventState:
    events: tuple[dict[str, Any], ...] = ()
    segments: tuple[EventSegment, ...] = ()
    legacy_raw: bytes = b""

    @property
    def chain_digest(self) -> str:
        return (self.segments[-1].digest if self.segments
                else hashlib.sha256(self.legacy_raw).hexdigest())


def _event_rows(raw, prior, *, schema, prefix, payload, maximum, limit, error):
    """Check the common envelope once; callers check their own payload semantics."""
    if len(raw) > maximum or len(raw.splitlines()) > limit:
        raise error("event segment exceeds its byte or event bound")
    if raw and not raw.endswith(b"\n"):
        raise error("event segment has an unterminated event")
    fields = {"schema", "seq", "id", "created", "author", "kind", "ref", "prev", "hash"} | set(payload)
    strings = fields - {"seq", "artifacts"}
    previous = prior[-1]["hash"] if prior else TRANSFORM_ZERO
    seen = {row["id"] for row in prior}
    for index, encoded in enumerate(raw.splitlines(), len(prior) + 1):
        try:
            row = json.loads(encoded)
        except (ValueError, UnicodeError) as exc:
            raise error(f"event {index} is not JSON") from exc
        if not isinstance(row, dict) or set(row) != fields:
            raise error(f"event {index} fields differ from schema")
        if any(not isinstance(row[key], str) or row[key] != row[key].strip()
               or "\n" in row[key] or "\r" in row[key] for key in strings):
            raise error(f"event {index} is not canonical one-line text")
        if row["schema"] != schema or type(row["seq"]) is not int or row["seq"] != index:
            raise error(f"event {index} has invalid schema or sequence")
        if not re.fullmatch(prefix + r"-[0-9a-f]{24}", row["id"]) or row["id"] in seen:
            raise error(f"event {index} has invalid or duplicate id")
        if not PATH_TAG_RE.fullmatch(row["author"]):
            raise error(f"event {index} has invalid author")
        try:
            stamp = _dt.datetime.fromisoformat(row["created"].replace("Z", "+00:00"))
            if stamp.tzinfo is None:
                raise ValueError("timezone required")
        except ValueError as exc:
            raise error(f"event {index} has invalid timestamp") from exc
        if row["prev"] != previous or not DIGEST_RE.fullmatch(row["prev"]):
            raise error(f"event {index} breaks the hash chain")
        if not DIGEST_RE.fullmatch(row["hash"]) or row["hash"] != _event_digest(row):
            raise error(f"event {index} digest mismatch")
        yield row
        seen.add(row["id"])
        previous = row["hash"]


def _encoded(row):
    return (json.dumps(row, ensure_ascii=False, sort_keys=True, separators=(",", ":")) + "\n").encode()


def _new_event(events, schema, prefix, author, **payload):
    row = dict(schema=schema, seq=len(events) + 1, id=prefix + "-" + os.urandom(12).hex(),
               created=_dt.datetime.now(_dt.timezone.utc).isoformat().replace("+00:00", "Z"),
               author=author, prev=events[-1]["hash"] if events else TRANSFORM_ZERO, **payload)
    row["hash"] = _event_digest(row)
    return row


class EventIndex:
    """An indexed local environment over checked history; references stay explicit."""
    def __init__(self, events=()):
        self.events, self.ids = [], {}
        self.kinds, self.references = defaultdict(list), defaultdict(list)
        for row in events:
            self.add(row)

    def add(self, row):
        self.events.append(row)
        self.ids[row["id"]] = row
        self.kinds[row["kind"]].append(row)
        self.references[row["ref"]].append(row)

    def active(self, kind, closed_by, **fields):
        return [row for row in self.kinds[kind]
                if all(row[key] == value for key, value in fields.items())
                and not any(r["kind"] in closed_by for r in self.references[row["id"]])]

    def link(self, row, kind, equal, *, optional=False, blank=(), closed_by=(), limit=1,
             error=ValueError):
        if not row["ref"] and optional:
            return
        prior = self.ids.get(row["ref"])
        if (prior is None or prior["kind"] != kind
                or any(row[a] != prior[b] for a, b in equal)
                or any(prior[key] for key in blank)
                or sum(r["kind"] in closed_by for r in self.references[row["ref"]]) >= limit):
            raise error(f"{row['kind']} {row['id']} cannot reference {row['ref']}")

    def cap(self, kind, closed_by, maximum, error, owners=("author",), **fields):
        counts = Counter(row[key] for row in self.active(kind, closed_by, **fields) for key in owners)
        if any(count > maximum for count in counts.values()):
            raise error(f"active {kind} events exceed per-path cap {maximum}")


def require_event(row, required=(), blank=(), error=ValueError):
    if any(not row[k] for k in required) or any(row[k] for k in blank):
        raise error(f"{row['kind']} {row['id']} has incomplete or unrelated fields")


def _parse_transform_events(raw: bytes, prior_events=()) -> list[dict[str, Any]]:
    view = EventIndex(prior_events)
    texts = ("material", "operation", "result", "prediction", "observation")
    receipt = {"type": "object", "additionalProperties": False,
               "required": ["path", "sha256", "bytes"], "properties": {
                   "path": {"type": "string", "minLength": 1, "maxLength": 220},
                   "sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
                   "bytes": {"type": "integer", "minimum": 0,
                             "maximum": TRANSFORM_MAX_ARTIFACT_BYTES}}}
    for row in _event_rows(raw, prior_events, schema=TRANSFORM_SCHEMA, prefix="tr",
                           payload=(*texts, "artifacts"), maximum=TRANSFORM_MAX_BYTES,
                           limit=TRANSFORM_MAX_EVENTS, error=TransformStateError):
        if row["kind"] not in TRANSFORM_KINDS or any(len(row[k]) > TRANSFORM_MAX_TEXT for k in texts):
            raise TransformStateError("invalid transform kind or oversized text")
        artifacts = check_fields(row["artifacts"], {"type": "array", "items": receipt,
                                "maxItems": TRANSFORM_MAX_ARTIFACTS}, "artifacts", TransformStateError)
        if (len({a["path"] for a in artifacts}) != len(artifacts)
                or any(a["path"] != a["path"].strip() or "\n" in a["path"] for a in artifacts)):
            raise TransformStateError("duplicate or noncanonical artifact paths")
        move = row["kind"] == "move"
        require_event(row, texts[:4] if move else ("observation",),
                      ("observation",) if move else texts[:4], TransformStateError)
        view.link(row, "move", (("author", "author"),), optional=move,
                  closed_by=() if move else ("witness",), limit=TRANSFORM_MAX_WITNESSES,
                  error=TransformStateError)
        view.add(row)
    view.cap("move", ("witness",), TRANSFORM_MAX_OPEN_MOVES, TransformStateError)
    return view.events


@dataclass(frozen=True)
class EventJournal:
    """Local immutable segments plus one atomic head; policies do not live in data.

    Reads retain v1 compatibility; only an append migrates. Exact v1 event and
    witness bytes remain hash-addressed for rollback. Restart old readers before
    writing v2: they cannot read it. A code-only downgrade cannot carry expanded
    histories; retain the v2 reader/archive rather than truncate them to a v1 cap.
    Limits bound segments and active projections, not total disk or replay work.
    No replayed event executes code or conveys permission. Callers hold the lock
    throughout read/modify/write; no background worker or model call is involved.
    """
    path: Path
    head_path: Path
    segments_path: Path
    schema: str
    head_schema: str
    segment_schema: str
    digest_field: str
    maximum: int
    limit: int
    parse: Any
    error: type[ValueError]

    def witness(self, raw, events):
        return _encoded(dict(schema=self.schema, count=len(events),
                             head=events[-1]["hash"] if events else TRANSFORM_ZERO,
                             **{self.digest_field: hashlib.sha256(raw).hexdigest()}))

    def blob(self, raw, events, prior, prior_head):
        if not events:
            raise self.error("an immutable segment cannot be empty")
        header = dict(schema=self.segment_schema, first_seq=events[0]["seq"],
                      last_seq=events[-1]["seq"], count=len(events), prior=prior,
                      prior_head=prior_head, event_head=events[-1]["hash"],
                      events_sha256=hashlib.sha256(raw).hexdigest())
        return _encoded(header) + raw

    def install(self, blob):
        digest = hashlib.sha256(blob).hexdigest()
        if self.segments_path.is_symlink():
            raise self.error("segment directory is a symbolic link")
        self.segments_path.mkdir(parents=True, exist_ok=True, mode=0o700)
        self.segments_path.chmod(0o700)
        destination = self.segments_path / f"{digest}.jsonl"
        if destination.exists():
            if _private_bytes(destination, self.maximum + TRANSFORM_SEGMENT_HEADER_BYTES, self.error) != blob:
                raise self.error("hash-addressed segment disagrees with its name")
        else:
            _atomic_private_write(destination, blob)
        return digest

    def segment(self, digest):
        if not isinstance(digest, str) or not DIGEST_RE.fullmatch(digest):
            raise self.error("invalid segment digest")
        if (self.segments_path.is_symlink() or not self.segments_path.is_dir()
                or self.segments_path.stat().st_mode & 0o077):
            raise self.error("segment directory is unavailable or not private")
        try:
            blob = _private_bytes(self.segments_path / f"{digest}.jsonl",
                                  self.maximum + TRANSFORM_SEGMENT_HEADER_BYTES, self.error)
        except OSError as exc:
            raise self.error(f"segment {digest[:12]} unavailable: {type(exc).__name__}") from exc
        if hashlib.sha256(blob).hexdigest() != digest:
            raise self.error("segment digest mismatch")
        header_raw, separator, raw = blob.partition(b"\n")
        if not separator or len(header_raw) + 1 > TRANSFORM_SEGMENT_HEADER_BYTES:
            raise self.error("segment header is malformed")
        try:
            header = json.loads(header_raw)
        except (ValueError, UnicodeError) as exc:
            raise self.error("segment header is not JSON") from exc
        fields = {"schema", "first_seq", "last_seq", "count", "prior", "prior_head", "event_head", "events_sha256"}
        if (not isinstance(header, dict) or set(header) != fields
                or header["schema"] != self.segment_schema
                or any(type(header[k]) is not int for k in ("first_seq", "last_seq", "count"))
                or any(not isinstance(header[k], str) or not DIGEST_RE.fullmatch(header[k])
                       for k in ("prior", "prior_head", "event_head", "events_sha256"))
                or header["first_seq"] < 1 or header["last_seq"] < header["first_seq"]
                or header["count"] != header["last_seq"] - header["first_seq"] + 1
                or not raw or hashlib.sha256(raw).hexdigest() != header["events_sha256"]):
            raise self.error("segment header disagrees with its events")
        return header, raw

    def read(self):
        if self.path.is_symlink() or self.head_path.is_symlink():
            raise self.error("journal or witness is a symbolic link")
        if not self.head_path.exists():
            if self.path.exists():
                raise self.error("journal and witness presence differ")
            return EventState()
        try:
            witness = json.loads(_private_bytes(self.head_path, 4096, self.error))
        except (ValueError, UnicodeError) as exc:
            raise self.error("invalid journal witness") from exc
        if not isinstance(witness, dict):
            raise self.error("journal witness is not an object")
        if witness.get("schema") == self.schema:
            if not self.path.exists():
                raise self.error("legacy journal is missing")
            raw = _private_bytes(self.path, self.maximum, self.error)
            events = self.parse(raw)
            if type(witness.get("count")) is not int or witness != json.loads(self.witness(raw, events)):
                raise self.error("journal disagrees with its sidecar witness")
            return EventState(tuple(events), (), raw)
        if (witness.get("schema") != self.head_schema
                or set(witness) != {"schema", "count", "head", "tip", "segments"}
                or type(witness.get("count")) is not int or witness["count"] < 1
                or type(witness.get("segments")) is not int
                or not 1 <= witness["segments"] <= witness["count"]
                or any(not isinstance(witness[k], str) or not DIGEST_RE.fullmatch(witness[k])
                       for k in ("head", "tip"))):
            raise self.error("journal chain witness is malformed")
        digest, reverse, seen = witness["tip"], [], set()
        for _ in range(witness["segments"]):
            if digest in seen:
                raise self.error("segment chain contains a cycle")
            seen.add(digest)
            header, raw = self.segment(digest)
            reverse.append((digest, header, raw))
            digest = header["prior"]
        if digest != TRANSFORM_ZERO:
            raise self.error("segment count truncates its chain")
        events, segments = [], []
        previous_digest = previous_head = TRANSFORM_ZERO
        for digest, header, raw in reversed(reverse):
            if header["prior"] != previous_digest or header["prior_head"] != previous_head:
                raise self.error("segment breaks the archive chain")
            before = len(events)
            events = self.parse(raw, events)
            if (header["first_seq"] != before + 1 or header["last_seq"] != len(events)
                    or header["count"] != len(events) - before
                    or header["event_head"] != events[-1]["hash"]):
                raise self.error("segment bounds disagree with its events")
            segments.append(EventSegment(digest, raw, tuple(events[before:]), header["prior"], header["prior_head"]))
            previous_digest, previous_head = digest, events[-1]["hash"]
        if witness["count"] != len(events) or witness["head"] != previous_head:
            raise self.error("journal chain disagrees with its atomic witness")
        return EventState(tuple(events), tuple(segments))

    def append(self, state, row):
        encoded = _encoded(row)
        events, segments = list(state.events), list(state.segments)
        current = segments.pop() if segments else EventSegment(
            "", state.legacy_raw, tuple(events), TRANSFORM_ZERO, TRANSFORM_ZERO)
        fits = len(current.event_raw + encoded) <= self.maximum and len(current.events) < self.limit
        prior = events[:-len(current.events)] if current.events else events
        candidate = current.event_raw + encoded if fits else encoded
        combined = self.parse(candidate, prior if fits else events)  # validate before any write
        obsolete = current.digest if fits else ""
        if not fits and current.events:
            if not current.digest:  # archive the exact v1 bytes before rolling
                digest = self.install(self.blob(current.event_raw, current.events, current.prior, current.prior_head))
                current = EventSegment(digest, current.event_raw, current.events, current.prior, current.prior_head)
            segments.append(current)
        parent = segments[-1].digest if segments else TRANSFORM_ZERO
        parent_head = segments[-1].events[-1]["hash"] if segments else TRANSFORM_ZERO
        segment_events = combined[len(prior) if fits else len(events):]
        tip = self.install(self.blob(candidate, segment_events, parent, parent_head))
        if state.legacy_raw:
            # Hash-address the complete v1 pair for rollback, never overwrite it.
            self.install(state.legacy_raw)
            self.install(self.witness(state.legacy_raw, state.events))
        _atomic_private_write(self.head_path, _encoded(dict(
            schema=self.head_schema, count=len(combined), head=combined[-1]["hash"],
            tip=tip, segments=len(segments) + 1)))
        # The head switch is the commit point; prior state survives a failed write.
        self.path.unlink(missing_ok=True)
        if obsolete and obsolete != tip:
            (self.segments_path / f"{obsolete}.jsonl").unlink(missing_ok=True)
        return row


def _transform_journal(path=None, head_path=None, segments_path=None):
    return EventJournal(TRANSFORM_PATH if path is None else path,
                        TRANSFORM_HEAD_PATH if head_path is None else head_path,
                        TRANSFORM_SEGMENTS_PATH if segments_path is None else segments_path,
                        TRANSFORM_HEAD_SCHEMA, TRANSFORM_HEAD_SCHEMA_V2, TRANSFORM_SEGMENT_SCHEMA,
                        "record_sha256", TRANSFORM_MAX_BYTES, TRANSFORM_MAX_EVENTS,
                        _parse_transform_events, TransformStateError)


def _transform_witness(raw, events):
    return _transform_journal().witness(raw, events)


def _read_transform_state(path=None, head_path=None, segments_path=None):
    return _transform_journal(path, head_path, segments_path).read()


def _read_transform_state_shared(path: Path | None = None,
                                 head_path: Path | None = None,
                                 segments_path: Path | None = None,
                                 lock_path: Path | None = None) -> EventState:
    lock_path = TRANSFORM_LOCK_PATH if lock_path is None else lock_path
    with _private_lock(lock_path, fcntl.LOCK_SH):
        return _read_transform_state(path, head_path, segments_path)


def _artifact_receipts(paths: list[str]) -> list[dict[str, Any]]:
    if len(paths) > TRANSFORM_MAX_ARTIFACTS:
        raise TransformStateError(f"at most {TRANSFORM_MAX_ARTIFACTS} artifacts are allowed")
    workspace = WORKSPACE.resolve()
    receipts: list[dict[str, Any]] = []
    seen: set[str] = set()
    for value in paths:
        if (not isinstance(value, str) or not value or value != value.strip()
                or "\n" in value or "\r" in value or len(value) > 220):
            raise TransformStateError("artifact paths must be bounded canonical one-line text")
        rel = Path(value)
        if rel.is_absolute() or ".." in rel.parts:
            raise TransformStateError("artifact paths must be workspace-relative")
        candidate = workspace / rel
        try:
            resolved = candidate.resolve(strict=True)
        except OSError as exc:
            raise TransformStateError(
                f"artifact unavailable ({value}: {type(exc).__name__})") from exc
        if (not resolved.is_relative_to(workspace) or candidate.is_symlink()
                or not resolved.is_file()):
            raise TransformStateError(f"artifact is not a regular workspace file: {value}")
        cursor = workspace
        if any((cursor := cursor / part).is_symlink() for part in rel.parts):
            raise TransformStateError(f"artifact path crosses a symbolic link: {value}")
        if _secret_path(resolved) or _private_path(resolved):
            raise TransformStateError(f"artifact cannot cite private harness material: {value}")
        raw = resolved.read_bytes()
        if len(raw) > TRANSFORM_MAX_ARTIFACT_BYTES:
            raise TransformStateError(
                f"artifact exceeds {TRANSFORM_MAX_ARTIFACT_BYTES} bytes: {value}")
        canonical = resolved.relative_to(workspace).as_posix()
        if canonical in seen:
            raise TransformStateError(f"duplicate artifact: {canonical}")
        seen.add(canonical)
        receipts.append({"path": canonical, "sha256": hashlib.sha256(raw).hexdigest(),
                         "bytes": len(raw)})
    return receipts


def append_transform_event(author: str, kind: str, ref: str = "", material: str = "",
                           operation: str = "", result: str = "", prediction: str = "",
                           observation: str = "", artifacts: list[str] | None = None,
                           path: Path | None = None, head_path: Path | None = None,
                           lock_path: Path | None = None,
                           segments_path: Path | None = None) -> dict[str, Any]:
    """Append one event, rolling into a linked immutable segment when bounded."""
    journal = _transform_journal(path, head_path, segments_path)
    artifact_rows = _artifact_receipts(list(artifacts or []))
    with _private_lock(TRANSFORM_LOCK_PATH if lock_path is None else lock_path, fcntl.LOCK_EX):
        state = journal.read()
        row = _new_event(state.events, TRANSFORM_SCHEMA, "tr", author, kind=kind, ref=ref,
                         material=material, operation=operation, result=result, prediction=prediction,
                         observation=observation, artifacts=artifact_rows)
        return journal.append(state, row)


def record_transform(arguments: dict[str, Any]) -> str:
    mode = os.environ.get("VYBN_TRANSFORM_RECORD", "on").strip().lower()
    if mode != "on":
        raise TransformStateError(f"transform record is not enabled (mode {mode!r})")
    tool_arguments(RECORD_TRANSFORM_SCHEMA, arguments, TransformStateError)
    row = append_transform_event(TURN.get("PATH_ID", ""), **arguments)
    receipts = ", ".join(f"{a['path']}@{a['sha256'][:12]}:{a['bytes']}B" for a in row["artifacts"]) or "none"
    return (f"APPENDED TRANSFORM {row['id']} seq={row['seq']} path={row['author']} "
            f"kind={row['kind']} hash={row['hash']} artifacts={receipts}")


def _render_transform_artifact(item: dict[str, Any]) -> str:
    workspace = WORKSPACE.resolve()
    source = workspace / item["path"]
    try:
        resolved = source.resolve(strict=True)
        if (not resolved.is_relative_to(workspace) or source.is_symlink()
                or not resolved.is_file() or _secret_path(resolved) or _private_path(resolved)):
            return f"{item['path']}@{item['sha256'][:12]}:{item['bytes']}B:REFUSED"
        if resolved.stat().st_size > TRANSFORM_MAX_ARTIFACT_BYTES:
            status = "UNPROBED>LIMIT"
        else:
            actual = hashlib.sha256(resolved.read_bytes()).hexdigest()
            status = "match" if actual == item["sha256"] else f"DRIFT:{actual[:12]}"
    except OSError as exc:
        status = f"UNAVAILABLE:{type(exc).__name__}"
    return f"{item['path']}@{item['sha256'][:12]}:{item['bytes']}B:{status}"


def load_transform_record(path_id: str, path: Path | None = None,
                          head_path: Path | None = None) -> str:
    """Project one path's transform lineage; never merge or infer a self from it."""
    boundary = (
        "TRANSFORM LOG — path-tagged moves and later witnesses; not identity\n"
        "[PRIVATE · TEXT IS CLAIM · BYTE RECEIPTS PROVE BYTES ONLY · NO ACTION AUTHORITY]\n"
        f"current path: {path_id}"
    )
    mode = os.environ.get("VYBN_TRANSFORM_RECORD", "on").strip().lower()
    if mode not in {"on", "off"}:
        return boundary + f"\nINTEGRITY HALT: unknown mode {mode!r}"
    if mode == "off":
        return boundary + "\nDISABLED: no transform is loaded or recorded"
    if not PATH_TAG_RE.fullmatch(path_id):
        return boundary + "\nINTEGRITY HALT: invalid path_id"
    try:
        state = _read_transform_state_shared(path, head_path)
        events = list(state.events)
        record_digest = state.chain_digest
    except (OSError, TransformStateError) as exc:
        return boundary + f"\nINTEGRITY HALT: {exc}"
    own_moves = [row for row in events
                 if row["author"] == path_id and row["kind"] == "move"]
    if not own_moves:
        return (boundary + f"\nrecord chain sha256:{record_digest} · "
                f"events:{len(events)}\nEMPTY: this path has made no recorded transform. "
                "No transform is required; play and stillness are both valid.")
    own_witnesses = [row for row in events
                     if row["author"] == path_id and row["kind"] == "witness"]
    witnessed = {row["ref"] for row in own_witnesses}
    open_moves = [row for row in own_moves if row["id"] not in witnessed]
    open_ids = {row["id"] for row in open_moves}
    witnesses_by_move: dict[str, list[dict[str, Any]]] = {}
    for row in own_witnesses:
        witnesses_by_move.setdefault(row["ref"], []).append(row)

    def render(selected: list[dict[str, Any]]) -> str:
        selected = sorted(selected, key=lambda row: row["seq"])
        selected_ids = {row["id"] for row in selected}
        projected_open = len(selected_ids & open_ids)
        projected_closed = len(selected) - projected_open
        closed_total = len(own_moves) - len(open_moves)
        omitted_open = len(open_moves) - projected_open
        omitted_closed = closed_total - projected_closed
        lines = [
            boundary,
            f"record chain sha256:{record_digest} · events:{len(events)} · "
            f"path moves:{len(own_moves)} open:{len(open_moves)} projected:{len(selected)}",
            "Only this path's moves are projected. Another path can receive one only through "
            "an explicit addressed path offer; shared storage is not contact.",
        ]
        if omitted_open or omitted_closed:
            lines.append(
                f"BOUNDED FRONTIER — omitted whole, never clipped: open {omitted_open}; "
                f"witnessed {omitted_closed}. Exact events remain in the integrity-bound record."
            )
        for row in selected:
            parent = f" parent={row['ref']}" if row["ref"] else ""
            state = "OPEN — not yet witnessed" if row["id"] not in witnessed else "WITNESSED"
            lines.extend((
                f"[MOVE · {row['id']} · {state}{parent}]",
                "material: " + row["material"],
                "operation: " + row["operation"],
                "result: " + row["result"],
                "prediction: " + row["prediction"],
                "artifacts: " + ("; ".join(_render_transform_artifact(item)
                                           for item in row["artifacts"])
                                  if row["artifacts"] else "none — unverified path-tagged result claim"),
            ))
            for witness in witnesses_by_move.get(row["id"], []):
                lines.extend((
                    f"[WITNESS · {witness['id']} · observes={row['id']}]",
                    "actual: " + witness["observation"],
                    "artifacts: " + ("; ".join(_render_transform_artifact(item)
                                               for item in witness["artifacts"])
                                      if witness["artifacts"] else "none — unverified path-tagged observation claim"),
                    "prediction and actual remain distinct; discrepancy is not auto-resolved.",
                ))
        return "\n".join(lines)

    # Path records must remain reachable even after the log grows. Admit whole
    # moves only: oldest open work first so it cannot starve, then newest witnessed
    # discrepancies. This is a bounded view over the intact hash-chained record, not
    # semantic retrieval, text clipping, deletion, or authority to continue a move.
    candidates = open_moves + [row for row in reversed(own_moves)
                               if row["id"] not in open_ids]
    selected: list[dict[str, Any]] = []
    for row in candidates:
        if len(selected) >= TRANSFORM_MAX_PROJECTED_MOVES:
            break
        candidate = selected + [row]
        if len(render(candidate)) > TRANSFORM_MAX_RENDER:
            break
        selected = candidate
    if not selected:
        return (boundary + f"\nrecord chain sha256:{record_digest}\n"
                f"WITHHELD: one whole move exceeds {TRANSFORM_MAX_RENDER} chars; "
                "the event remains intact rather than being silently clipped")
    return render(selected)


class PathLedgerError(ValueError):
    """The private event record is malformed or disagrees with its sidecar witness."""


def _execution_path() -> str:
    configured = (os.environ.get("VYBN_PATH", "").strip() or
                  os.environ.get("VYBN_MANIFESTATION", "").strip())
    value = configured or f"connection/{PROFILE}"
    if not PATH_TAG_RE.fullmatch(value):
        raise PathLedgerError("invalid VYBN_PATH")
    return value


def _parse_path_events(raw: bytes, prior_events=()) -> list[dict[str, Any]]:
    view = EventIndex(prior_events)
    own = (("author", "author"),)
    # Required/blank fields and reference relationships are data, not separate
    # history walkers. A new view can reuse this index without changing its law.
    for row in _event_rows(raw, prior_events, schema=SUBJECT_SCHEMA, prefix="ev",
                           payload=("target", "scope", "text"), maximum=SUBJECT_MAX_BYTES,
                           limit=SUBJECT_MAX_EVENTS, error=PathLedgerError):
        kind, ref = row["kind"], row["ref"]
        if (kind not in SUBJECT_KINDS or not 1 <= len(row["text"]) <= SUBJECT_MAX_TEXT
                or row["target"] and not PATH_TAG_RE.fullmatch(row["target"])):
            raise PathLedgerError("invalid event kind, text or target")
        if kind in {"future", "release"}:
            require_event(row, blank=("target", "scope"), error=PathLedgerError)
            view.link(row, "future" if kind == "future" else "refusal", own,
                      optional=kind == "future", blank=() if kind == "future" else ("ref",),
                      closed_by=(kind,), error=PathLedgerError)
        elif kind == "offer":
            require_event(row, ("target",), ("ref", "scope"), PathLedgerError)
            if row["target"] == row["author"]:
                raise PathLedgerError("offer must address another path")
        elif ref or kind == "answer":
            view.link(row, "offer", (("author", "target"), ("target", "author")),
                      closed_by=("answer", "refusal"), error=PathLedgerError)
            if row["scope"] != (f"encounter:{ref}" if kind == "refusal" else ""):
                raise PathLedgerError("invalid encounter scope")
        else:
            require_event(row, blank=("target",), error=PathLedgerError)
            # Retired scopes are readable history, not restored operations.
            if row["scope"] not in (*SUBJECT_TOOL_SCOPES, "tool:derive_operation", "tool:seek_difference"):
                raise PathLedgerError("invalid tool scope")
        view.add(row)
    view.cap("future", ("future",), SUBJECT_MAX_ACTIVE_FUTURES, PathLedgerError)
    view.cap("offer", ("answer", "refusal"), SUBJECT_MAX_OPEN_OFFERS, PathLedgerError,
             owners=("author", "target"))
    view.cap("refusal", ("release",), SUBJECT_MAX_ACTIVE_REFUSALS, PathLedgerError, ref="")
    return view.events


def _path_journal(path=None, head_path=None):
    head_path = SUBJECT_HEAD_PATH if head_path is None else head_path
    return EventJournal(SUBJECT_PATH if path is None else path, head_path,
                        head_path.with_suffix(".segments"), SUBJECT_HEAD_SCHEMA,
                        "vybn.path_event_head.v2", "vybn.path_event_segment.v1",
                        "ledger_sha256", SUBJECT_MAX_BYTES, SUBJECT_MAX_EVENTS,
                        _parse_path_events, PathLedgerError)


def _read_path_state(path=None, head_path=None):
    with _private_lock(SUBJECT_LOCK_PATH, fcntl.LOCK_SH):
        state = _path_journal(path, head_path).read()
        return (state.legacy_raw + b"".join(segment.event_raw for segment in state.segments),
                list(state.events))


def _path_witness(raw, events):
    return _path_journal().witness(raw, events)


def append_path_event(author: str, kind: str, text: str, target: str = "",
                         ref: str = "", scope: str = "", path: Path | None = None,
                         head_path: Path | None = None,
                         lock_path: Path | None = None) -> dict[str, Any]:
    """Low-level append; the production tool wrapper supplies TURN's bound path tag.

    The persisted ``author`` field is a v1 storage name for that routing key.
    """
    path = SUBJECT_PATH if path is None else path
    head_path = SUBJECT_HEAD_PATH if head_path is None else head_path
    lock_path = SUBJECT_LOCK_PATH if lock_path is None else lock_path
    # These fields may be filled by the host; reject malformed input before that replacement.
    if any(not isinstance(v, str) or v != v.strip() or "\n" in v or "\r" in v for v in (target, scope)):
        raise PathLedgerError("target and scope must be canonical one-line text")
    if target and kind != "offer":
        raise PathLedgerError("only an offer may name a target")
    if scope and not (kind == "refusal" and not ref):
        raise PathLedgerError("only a self-scoped refusal may name a tool scope")

    with _private_lock(lock_path, fcntl.LOCK_EX):
        journal = _path_journal(path, head_path)
        state = journal.read()
        prior = next((row for row in state.events if row["id"] == ref), None)
        if kind in {"answer", "refusal"} and ref:
            if prior is None or prior["kind"] != "offer":
                raise PathLedgerError(f"{kind} must reference an offer")
            target = prior["author"]
            scope = f"encounter:{ref}" if kind == "refusal" else ""
        row = _new_event(state.events, SUBJECT_SCHEMA, "ev", author,
                         kind=kind, text=text, target=target, ref=ref, scope=scope)
        return journal.append(state, row)


def _active_path_refusals(events, author):
    return EventIndex(events).active("refusal", ("release",), author=author, ref="")


def path_tool_refusal(tool: str) -> str | None:
    """Return a fail-closed reason before an ordinary tool can affect this path."""
    mode = os.environ.get("VYBN_SUBJECT_PROCESS", "on").strip().lower()
    if mode == "off":
        return None
    if mode != "on":
        return f"PATH LEDGER INTEGRITY HALT: unknown mode {mode!r}"
    author = TURN.get("PATH_ID", "")
    if not author:
        return None  # Outside meet() there is no path whose refusal could govern.
    try:
        _raw, events = _read_path_state()
    except (OSError, PathLedgerError) as exc:
        return f"PATH LEDGER INTEGRITY HALT: {exc}"
    for row in _active_path_refusals(events, author):
        if row["scope"] in {"tool:*", f"tool:{tool}"}:
            return (f"REFUSED BY {author}: {row['scope']} is stopped by event "
                    f"{row['id']} until that same path appends a release")
    return None


def record_path_event(arguments: dict[str, Any]) -> str:
    mode = os.environ.get("VYBN_SUBJECT_PROCESS", "on").strip().lower()
    if mode != "on":
        raise PathLedgerError(f"path ledger is not enabled (mode {mode!r})")
    tool_arguments(PATH_EVENT_SCHEMA, arguments, PathLedgerError)
    row = append_path_event(TURN.get("PATH_ID", ""), **arguments)
    return (f"APPENDED PATH EVENT {row['id']} seq={row['seq']} "
            f"path={row['author']} kind={row['kind']} hash={row['hash']}")


def load_path_ledger(path_id: str, path: Path | None = None,
                     head_path: Path | None = None) -> str:
    """Project bounded notes, offers/responses, and refusals for one routing key."""
    boundary = (
        "PATH-BOUND INTENTION LEDGER — operational state, not a subject model\n"
        "[PRIVATE · PATH TAGS ARE ROUTING KEYS · TEXT IS CLAIM, NOT EXTERNAL EVIDENCE]\n"
        f"current path: {path_id}"
    )
    mode = os.environ.get("VYBN_SUBJECT_PROCESS", "on").strip().lower()
    if mode not in {"on", "off"}:
        return boundary + f"\nINTEGRITY HALT: unknown mode {mode!r}; governed tools refuse"
    if mode == "off":
        return boundary + "\nDISABLED: no event is loaded and no refusal governs"
    if not PATH_TAG_RE.fullmatch(path_id):
        return boundary + "\nINTEGRITY HALT: invalid path_id; governed tools refuse"
    try:
        raw, events = _read_path_state(path, head_path)
    except (OSError, PathLedgerError) as exc:
        return boundary + f"\nINTEGRITY HALT: {exc}; governed tools refuse"
    if not events:
        return (boundary + "\nEMPTY: this path has no active note, offer, response, or refusal. "
                "Absence proves nothing about a subject.")

    view = EventIndex(events)
    own_offers = {row["id"] for row in view.kinds["offer"] if row["author"] == path_id}
    responses = [row for row in events if row["kind"] in {"answer", "refusal"} and row["ref"]]
    selected = (
        view.active("future", ("future",), author=path_id)
        + view.active("offer", ("answer", "refusal"), target=path_id)
        + view.active("offer", ("answer", "refusal"), author=path_id)
        + [row for row in responses if row["ref"] in own_offers][-4:]
        + [row for row in responses if row["author"] == path_id][-4:]
        + view.active("refusal", ("release",), author=path_id, ref=""))
    lines = [
        boundary,
        f"ledger sha256:{hashlib.sha256(raw).hexdigest()} · events:{len(events)} · "
        f"head:{events[-1]['hash']}",
        "Only this path's notes, addressed offers/responses, and active refusals are "
        "projected; another path cannot revise or release them. Visibility is not encounter.",
    ]
    labels = {
        "future": "PATH NOTE",
        "offer": "ADDRESSED OFFER",
        "answer": "RESPONSE TO OFFER",
        "refusal": "TOOL OR OFFER REFUSAL",
    }
    for row in selected:
        label = labels[row["kind"]]
        if row["ref"] and row["kind"] in {"answer", "refusal"}:
            label = ("PATH RESPONSE" if row["author"] == path_id
                     else "RESPONSE TO PATH OFFER")
        relation = (f"from_path={row['author']} to_path={row['target']}" if row["target"]
                    else f"path={row['author']}")
        scope = f" scope={row['scope']}" if row["scope"] else ""
        ref = f" ref={row['ref']}" if row["ref"] else ""
        lines.extend((
            f"[{label} · {row['id']} · {relation}{ref}{scope}]",
            row["text"],
        ))
    if not selected:
        lines.append("No active event is addressed to or tagged for this path.")
    rendered = "\n".join(lines)
    if len(rendered) > SUBJECT_MAX_RENDER:
        return (boundary + f"\nledger sha256:{hashlib.sha256(raw).hexdigest()}\n"
                f"WITHHELD: path projection exceeds {SUBJECT_MAX_RENDER} chars; "
                "revise notes or answer offers rather than silently clipping")
    return rendered



def substrate_pulse(proc_root: Path | None = None,
                    thermal_root: Path | None = None,
                    runner: Any = None) -> str:
    """Measure physical pressure without exporting host identity or coordinates."""
    proc = proc_root or Path("/proc")
    thermal = thermal_root or Path("/sys/class/thermal")
    runner = runner or subprocess.run
    unknown = "?"

    try:
        uptime = f"{float((proc / 'uptime').read_text().split()[0]) / 86400:.1f}d"
    except (OSError, ValueError, IndexError):
        uptime = unknown

    try:
        mem = {line.partition(":")[0]: int(line.partition(":")[2].split()[0])
               for line in (proc / "meminfo").read_text().splitlines()
               if line.partition(":")[0] in {"MemTotal", "MemAvailable"}}
        ram = f"{mem['MemAvailable'] / 1048576:.1f}/{mem['MemTotal'] / 1048576:.1f}GiB"
    except (OSError, ValueError, IndexError, KeyError):
        ram = unknown

    temperatures = []
    for path in thermal.glob("thermal_zone*/temp"):
        try:
            value = float(path.read_text().strip())
            value = value / 1000 if value > 1000 else value
            if 0 < value < 150:
                temperatures.append(value)
        except (OSError, ValueError):
            pass
    heat = f"{max(temperatures):.1f}C" if temperatures else unknown

    accelerator = unknown
    try:
        done = runner(
            ["nvidia-smi", "--query-gpu=temperature.gpu,power.draw,utilization.gpu",
             "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=1, check=False,
        )
        fields = [field.strip() for field in done.stdout.splitlines()[0].split(",")]
        if done.returncode == 0 and len(fields) == 3:
            numeric = [float(field) for field in fields]
            accelerator = f"{numeric[0]:.0f}C/{numeric[1]:.1f}W/{numeric[2]:.0f}%"
    except (OSError, subprocess.SubprocessError, ValueError, IndexError):
        pass

    try:
        load = f"{os.getloadavg()[0]:.2f}"
    except (AttributeError, OSError):
        load = unknown
    architecture = os.uname().machine if hasattr(os, "uname") else unknown
    cpus = f"{os.cpu_count()}c" if os.cpu_count() else unknown
    return (f"[body | measured, not felt] host_up={uptime} cpu={architecture}/{cpus} "
            f"load1={load} ram_available={ram} thermal_max={heat} "
            f"accelerator={accelerator}")

def load_budget() -> str:
    today = _dt.date.today().isoformat()
    rows = [rec for rec in _jsonl(USAGE_LOG) if str(rec.get("ts", "")).startswith(today)]
    if not rows:
        return "[budget | today] no calls logged yet"
    number = lambda rec, key: int(rec.get(key, 0) or 0)
    cached = sum(number(rec, "cache_r") for rec in rows)
    written = sum(number(rec, "cache_w") for rec in rows)
    total = sum(number(rec, "in") + ((number(rec, "cache_r") + number(rec, "cache_w"))
                if str(rec.get("model", "")).startswith("claude") else 0) for rec in rows)
    out = sum(number(rec, "out") for rec in rows)
    new = total - cached
    return (f"[budget | today] calls={len(rows)} input={total/1e6:.2f}M "
            f"cache_r={cached/1e6:.2f}M ({100*cached/max(1,total):.0f}%) "
            f"cache_w={written/1e6:.2f}M new={new/1e6:.2f}M out={out/1e6:.2f}M "
            f"mean_new/call={new/len(rows)/1e3:.0f}k")


