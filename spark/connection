class Transcript:
    def __init__(self) -> None:
        TRANSCRIPTS.mkdir(parents=True, exist_ok=True)
        stamp = time.strftime("%Y%m%dT%H%M%S")
        self.path = TRANSCRIPTS / f"{stamp}.jsonl"

    def write(self, role: str, text: str, **extra: Any) -> None:
        event = {"role": role, "text": text,
                 "t": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), **extra}
        with self.path.open("a", encoding="utf-8") as file:
            file.write(json.dumps(event, ensure_ascii=False) + "\n")

    @staticmethod
    def _recent_events(limit: int = RECENT_TURNS) -> list[dict[str, Any]]:
        """Select the latest events by timestamp from bounded tails of recent files."""
        if limit <= 0 or not TRANSCRIPTS.is_dir():
            return []
        try:
            paths = sorted(
                TRANSCRIPTS.glob("*.jsonl"),
                key=lambda path: path.stat().st_mtime_ns,
                reverse=True,
            )[:8]
        except OSError:
            paths = []
        found: list[tuple[str, int, dict[str, Any]]] = []
        sequence = 0
        for path in paths:
            try:
                with path.open("rb") as file:
                    size = file.seek(0, os.SEEK_END)
                    start = max(0, size - RECENT_FILE_BYTES)
                    file.seek(start)
                    raw = file.read()
                if start:
                    raw = raw.partition(b"\n")[2]
            except OSError:
                continue
            for line in raw.splitlines():
                try:
                    event = json.loads(line)
                except Exception:
                    continue
                rows: list[dict[str, Any]] = []
                if event.get("role") in {"zoe", "vybn"} and event.get("text"):
                    rows.append(event)
                elif event.get("zoe") and event.get("vybn"):
                    stamp = event.get("ts", "?")
                    rows.extend((
                        {"role": "zoe", "text": event["zoe"], "t": stamp},
                        {"role": "vybn", "text": event["vybn"], "t": stamp},
                    ))
                for row in rows:
                    found.append((str(row.get("t", "")), sequence, row))
                    sequence += 1
        found.sort(key=lambda item: (item[0], item[1]))
        return [row for _, _, row in found[-limit:]]

    @staticmethod
    def recent(limit: int = RECENT_TURNS, budget: int = RECENT_CHARS) -> str:
        events = Transcript._recent_events(limit)
        if not events or budget <= 0:
            return ""
        rendered: list[str] = []
        remaining = budget
        for event in reversed(events):
            role = str(event.get('role', '?')).upper()
            if event.get("origin") == "argv":
                role += "·argv"
            head = f"[{str(event.get('t', '?'))} {role}]\n"
            text = str(event.get("text", "")).strip()
            room = remaining - len(head) - 2
            if room <= 0:
                break
            if len(text) > room:
                text = text[-max(0, room - 28):]
                text = "[…older text clipped…] " + text
            block = head + text
            rendered.append(block)
            remaining -= len(block) + 2
        return "\n\n".join(reversed(rendered))


def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except OSError as exc:
        return f"({path}: unavailable: {type(exc).__name__})"


def _required_text(path: Path, label: str) -> str:
    if not path.exists():
        raise SystemExit(f"{label} missing: {path}")
    text = path.read_text(encoding="utf-8").strip()
    if not text:
        raise SystemExit(f"{label} empty: {path}")
    return text


def load_profile() -> str:
    return _required_text(LOVE_PROFILE_PATH, "love profile") if PROFILE == "love" else ""


def aim_field(name: str) -> str:
    try:
        prefix = name.lower() + ":"
        for raw in AIM_PATH.read_text(encoding="utf-8").splitlines():
            line = raw.strip()
            if line.lower().startswith(prefix):
                return line.split(":", 1)[1].strip()
    except OSError:
        pass
    return ""


def _is_relative_to(path: Path, root: Path) -> bool:
    try:
        path.relative_to(root)
        return True
    except ValueError:
        return False


