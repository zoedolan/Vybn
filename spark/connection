class Transcript:
    def __init__(self) -> None:
        TRANSCRIPTS.mkdir(parents=True, exist_ok=True)
        stamp = time.strftime("%Y%m%dT%H%M%S")
        self.path = TRANSCRIPTS / f"{stamp}.jsonl"

    def write(self, role: str, text: str, **extra: Any) -> None:
        event = {
            "role": role,
            "text": text,
            "t": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            **extra,
        }
        with self.path.open("a", encoding="utf-8") as file:
            file.write(json.dumps(event, ensure_ascii=False) + "\n")

    @staticmethod
    def _events() -> list[dict[str, Any]]:
        events: list[dict[str, Any]] = []
        for path in sorted(TRANSCRIPTS.glob("*.jsonl")):
            for event in _jsonl(path):
                if event.get("role") in {"zoe", "vybn"} and event.get("text"):
                    events.append(event)
        return events

    @staticmethod
    def inherited(zoe_text: str = "", limit: int = HISTORY_LIMIT) -> tuple[str, str]:
        events = Transcript._events()
        if not events: return "(no prior transcript pages found)"

        def excerpt(event: dict, n: int = ARC_EXCERPT) -> str:
            text = " ".join(str(event.get("text", "")).split())
            return (f"[{str(event.get('t', '?'))[:10]} {event.get('role', '?')}] "
                    + text[:n] + ("…" if len(text) > n else ""))

        tail = events[-limit:] if limit > 0 else []
        edge = len(events) - len(tail)
        edge -= edge % ARC_QUANTUM if ARC_QUANTUM > 1 else 0
        earlier, live = events[:edge], []
        zoe = [event for event in earlier if event.get("role") == "zoe"]
        take = min(ARC_TURNS, len(zoe)) if ARC_TURNS > 0 else 0
        spread = [zoe[int(i * len(zoe) / take)] for i in range(take)] if take else []
        keys = sorted(aim_keywords()) + _content_words(zoe_text)
        skip = {id(event) for event in spread}
        matched = (_rare_hits(zoe, keys, ARC_AIM_TURNS, skip)
                   + _rare_hits([e for e in earlier if e.get("role") != "zoe"], keys, 2, skip))

        arc = ""
        if spread:
            arc = (f"ARC — {len(spread)} of Zoe's turns sampled evenly across the "
                   f"{len(earlier)} earlier turns of the whole record; her words only, "
                   f"excerpted to {ARC_EXCERPT} chars. Not recent, and that is the point.\n"
                   + "\n".join(excerpt(event) for event in spread))
        if matched:
            live.append("ARC (matched) — earlier turns of ours whose words overlap the "
                        "standing objective or what Zoe just said. Crude term overlap, because "
                        "nothing we say to each other is in any index: this is the only channel "
                        "that reaches our own record.\n"
                        + "\n".join(excerpt(event, 3 * ARC_EXCERPT) for event in matched))
        if tail:
            mine = [i for i, event in enumerate(tail) if event.get("role") == "vybn"]
            whole = set(mine[-SELF_VERBATIM:])
            def render(i: int, event: dict) -> str:
                door = event.get("door")
                head = f"[{event['role'].upper()}{' @' + door if door else ''} | {event.get('t', 'time unknown')}]"
                text = str(event.get("text", ""))
                if event.get("role") == "vybn" and i not in whole and len(text) > SELF_EXCERPT:
                    text = text[:SELF_EXCERPT].rstrip() + f"… [{len(text)} chars, mine, trimmed]"
                return head + "\n" + text
            live.append(f"RECENT — last {len(tail)} turns. Zoe verbatim; my own older "
                        f"replies cut to {SELF_EXCERPT} chars, my last {SELF_VERBATIM} whole.\n\n"
                        + "\n\n".join(render(i, event) for i, event in enumerate(tail)))
        return arc or "(no earlier arc found)", "\n\n".join(live) or "(no recent turns found)"


def read_text(path: Path, *, tail: int | None = None) -> str:
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        return f"({path}: unavailable: {type(exc).__name__})"
    return text[-tail:] if tail else text


def _required_text(path: Path, label: str) -> str:
    if not path.exists(): raise SystemExit(f"{label} missing: {path}")
    text = path.read_text(encoding="utf-8").strip()
    if not text: raise SystemExit(f"{label} empty: {path}")
    return text


