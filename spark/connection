QUIET_STOPS = {"end_turn", "stop", "stop_sequence", "tool_use", "completed"}


def function_tools(nested: bool) -> list[dict[str, Any]]:
    bodies = ({"name": s["name"], "description": s["description"], "parameters": s["input_schema"]}
              for s in TOOL_SCHEMAS)
    return [{"type": "function", **({"function": body} if nested else body)}
            for body in bodies]


def json_arguments(raw: str | None) -> dict:
    try: return json.loads(raw or "{}")
    except json.JSONDecodeError: return {}


class Dialect:
    """Native provider coordinates around one local conversation loop."""
    name = "dialect"
    user_index = 0
    last_stop: str | None = None

    def open(self, instructions, zoe_text, pending, context=""):
        provider = self.provider
        if provider == "anthropic":
            self.system = cached_system(instructions)
            prefix = []
        elif provider == "responses":
            prefix = [{"role": "developer", "content": [{"type": "input_text",
                       "text": instructions, "prompt_cache_breakpoint": {"mode": "explicit"}}]}]
        else:
            print(f"(@{self.name} dispatched — working)", flush=True)
            prefix = [{"role": "system", "content": instructions}]
        self.user_index = len(prefix)
        return prefix + [{"role": "user", "content": user_content(zoe_text, pending, provider, context)}]

    def answer(self, state, results):
        provider = self.provider
        if provider == "anthropic":
            state.append({"role": "user", "content": [dict(type="tool_result", tool_use_id=c.id,
                          content=out) for c, out in results]})
            mark_incremental_cache(state)
        else:
            state.extend((dict(type="function_call_output", call_id=c.id, output=out)
                          if provider == "responses" else
                          dict(role="tool", tool_call_id=c.id, content=out)) for c, out in results)

    def plain(self, state, zoe_text):
        content = state[self.user_index].get("content")
        if isinstance(content, list):
            content = [b for b in content if b.get("type") in {"text", "input_text"}]
        state[self.user_index] = {"role": "user", "content": content or zoe_text}

class AnthropicDialect(Dialect):
    provider = 'anthropic'
    def __init__(self, name: str = "fable") -> None:
        import anthropic

        door = DOORS[name]
        self.name, self.models, self.effort = name, door.models, door.effort
        self.reasoning = True
        self.client = anthropic.Anthropic(api_key=api_key("ANTHROPIC_API_KEY"))
        self.system: Any = None
        self.announced = False

    def send(self, state: list, tools: bool = True) -> Any:
        def once(model: str) -> Any:
            knobs = ({"thinking": {"type": "adaptive"},
                      "output_config": {"effort": self.effort}}
                     if self.reasoning else {})
            return self.client.messages.create(
                model=model, max_tokens=DOORS[self.name].max_tokens, timeout=600.0,
                system=self.system, messages=state,
                tools=list(TOOL_SCHEMAS) if tools else [], **knobs,
            )

        def sweep() -> Any:
            error: Exception | None = None
            for model in self.models:
                try:
                    return once(model)
                except Exception as exc:  # noqa: BLE001 — sweep all models first
                    if self.reasoning and reasoning_rejected(exc):
                        self.reasoning = False
                        print(f"(note: {model} refused the reasoning knobs — "
                              "answering without them; the mind line in DOOR is "
                              "now stale for this turn)", flush=True)
                        try:
                            return once(model)
                        except Exception as retry:  # noqa: BLE001
                            exc = retry
                    error = exc
            raise error or RuntimeError("Anthropic call failed")

        return with_retries(sweep)

    def absorb(self, state: list, response: Any) -> tuple[str, list[ToolCall]]:
        if not self.announced and response.model and self.models[0] not in response.model:
            self.announced = True
            print(f"(note: {self.models[0]} unavailable — answered by {response.model})",
                  flush=True)
        self.last_stop = getattr(response, "stop_reason", None)
        usage = response.usage
        note_provider_model(response.model)
        record_usage(
            response.model, usage.input_tokens, usage.output_tokens,
            getattr(usage, "cache_read_input_tokens", 0) or 0,
            getattr(usage, "cache_creation_input_tokens", 0) or 0,
        )
        state.append({"role": "assistant", "content": response.content})
        said = [block.text for block in response.content
                if block.type == "text" and block.text.strip()]
        calls = [ToolCall(block.id, block.name, block.input or {}, block)
                 for block in response.content if block.type == "tool_use"]
        return "\n".join(said), calls



def select_reasoning_effort(dialect: Dialect | None, arguments: dict[str, Any]) -> str:
    if not isinstance(dialect, OpenAIDialect) or dialect.name not in ASTRA_DOORS:
        return "unchanged: effort selection is available only on an active Astra door"
    effort, why = arguments.get("effort"), arguments.get("why")
    if (effort not in ASTRA_EFFORTS or not isinstance(why, str)
            or not 1 <= len(why.strip()) <= 600):
        return "unchanged: provide a supported effort and a task-linked reason (1–600 chars)"
    ceiling = DOORS[dialect.name].effort
    if ASTRA_EFFORTS.index(effort) > ASTRA_EFFORTS.index(ceiling):
        return (f"unchanged: @{dialect.name} ceiling is {ceiling}; propose @astra{effort} "
                "to Zoe for a fresh conversation. No higher-effort request was sent.")
    previous = dialect.reasoning_effort
    dialect.reasoning_effort = effort
    print(f"(Astra effort: {previous} → {effort}; ceiling={ceiling}; "
          f"subsequent requests; reason: {why.strip()})", flush=True)
    return (f"selected effort={effort} for subsequent requests; ceiling={ceiling}; "
            f"model={dialect.model}; max_output_tokens={dialect.max_tokens}. "
            "No request sent by this tool; provider acceptance is not yet established.")


class OpenAIDialect(Dialect):
    provider = 'responses'
    def __init__(self, name: str = "sol") -> None:
        from openai import OpenAI

        door = DOORS[name]
        self.name, self.model = name, door.models[0]
        self.max_tokens, self.reasoning_effort = door.max_tokens, door.effort
        self.prompt_cache_key = f"vybn-wake-{name}-v1" if door.cache else None
        self.prompt_cache_options = ({"prompt_cache_options": {
            "mode": "implicit", "ttl": "30m"}} if door.cache else None)
        self.client = OpenAI(api_key=api_key("OPENAI_API_KEY"))

    def send(self, state: list, tools: bool = True) -> Any:
        request: dict[str, Any] = {
            "model": self.model, "input": state,
            "tools": function_tools(nested=False) if tools else [],
            "max_output_tokens": self.max_tokens, "timeout": 600,
        }
        if self.reasoning_effort:
            request["reasoning"] = {"effort": self.reasoning_effort}
        if self.prompt_cache_key:
            request["prompt_cache_key"] = self.prompt_cache_key
        if self.prompt_cache_options:
            request["extra_body"] = self.prompt_cache_options
        started = time.monotonic()
        response = with_retries(lambda: self.client.responses.create(**request))
        self.last_request_settings = {
            "door": self.name, "turn": TURN.get("TURN_ID"),
            "requested_effort": self.reasoning_effort,
            "max_output_tokens": self.max_tokens,
            "elapsed_seconds": round(time.monotonic() - started, 3),
        }
        return response

    def absorb(self, state: list, response: Any) -> tuple[str, list[ToolCall]]:
        stopped = getattr(response, "incomplete_details", None)
        self.last_stop = getattr(response, "status", None) or None
        if stopped is not None and getattr(stopped, "reason", None):
            self.last_stop = f"{self.last_stop}/{stopped.reason}"
        settings = dict(getattr(self, "last_request_settings", {}))
        settings["stop"] = self.last_stop
        output_details = getattr(response.usage, "output_tokens_details", None)
        settings["reasoning_tokens"] = getattr(output_details, "reasoning_tokens", None)
        details = getattr(response.usage, "input_tokens_details", None)
        note_provider_model(response.model)
        record_usage(
            response.model, response.usage.input_tokens, response.usage.output_tokens,
            getattr(details, "cached_tokens", 0) or 0,
            getattr(details, "cache_write_tokens", 0) or 0, settings=settings,
        )
        state.extend(item.model_dump(exclude_none=True) for item in response.output)
        calls = [ToolCall(item.call_id, item.name, json_arguments(item.arguments), item)
                 for item in response.output
                 if getattr(item, "type", None) == "function_call"]
        return response.output_text or "", calls



class K3Dialect(Dialect):
    provider = 'chat'
    def __init__(self, name: str = "k3") -> None:
        from openai import OpenAI

        self.name = name
        self.client = OpenAI(api_key=api_key("MOONSHOT_API_KEY"),
                             base_url="https://api.moonshot.ai/v1")

    def send(self, state: list, tools: bool = True) -> Any:
        door = DOORS[self.name]
        return with_retries(lambda: self.client.chat.completions.create(
            model=door.models[0], messages=state,
            tools=function_tools(nested=True) if tools else [],
            reasoning_effort=door.effort, max_tokens=door.max_tokens, timeout=600,
        ))

    def absorb(self, state: list, response: Any) -> tuple[str, list[ToolCall]]:
        self.last_stop = response.choices[0].finish_reason or None
        message, usage = response.choices[0].message, response.usage
        state.append(message.model_dump(exclude_none=True))
        details = getattr(usage, "prompt_tokens_details", None)
        note_provider_model(response.model)
        record_usage(response.model, usage.prompt_tokens, usage.completion_tokens,
                     getattr(details, "cached_tokens", 0) or 0)
        calls = [ToolCall(call.id, call.function.name,
                          json_arguments(call.function.arguments), call)
                 for call in (message.tool_calls or [])]
        return message.content or "", calls



def _atomic_private_write(path: Path, raw: bytes) -> None:
    """Atomically replace a private state witness used by the bounded ledgers."""
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.parent.chmod(0o700)
    fd, name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as file:
            file.write(raw)
            file.flush()
            os.fsync(file.fileno())
        os.chmod(name, 0o600)
        os.replace(name, path)
        directory_fd = os.open(path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        Path(name).unlink(missing_ok=True)


class PublishProposalError(ValueError):
    """An exact publication proposal could not be frozen safely."""


def _git_capture(repository: Path, *arguments: str, timeout: int = 15) -> tuple[int, str]:
    try:
        done = subprocess.run(
            ["git", "-C", str(repository), *arguments], capture_output=True,
            text=True, timeout=timeout, check=False,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        raise PublishProposalError(f"git unavailable: {type(exc).__name__}") from exc
    return done.returncode, (done.stdout + done.stderr).strip()


def _one_git_line(repository: Path, *arguments: str) -> str:
    code, output = _git_capture(repository, *arguments)
    lines = output.splitlines()
    if code or len(lines) != 1 or not lines[0].strip():
        raise PublishProposalError(
            f"git {' '.join(arguments[:2])} did not return one successful line")
    return lines[0].strip()


def _safe_remote_label(value: str) -> str:
    """Describe a Git destination without reflecting credentials or query secrets."""
    if "://" in value:
        parsed = urllib.parse.urlsplit(value)
        host = parsed.hostname or "redacted-host"
        try:
            port = f":{parsed.port}" if parsed.port else ""
        except ValueError:
            port = ""
        path = parsed.path if parsed.path.startswith("/") else "/" + parsed.path
        return urllib.parse.urlunsplit((parsed.scheme, host + port, path, "", ""))
    if re.fullmatch(r"[^/:\s]+@[^/:\s]+:.+", value):
        return value.split("@", 1)[1]
    # Local and unusual helpers can contain private coordinates. Their digest remains
    # exact while the human-facing label stays non-secret.
    return "non-URL destination (coordinates redacted)"


_PUBLISH_BOUND_FIELDS = (
    "schema", "kind", "repository", "repository_label", "repository_device",
    "repository_inode", "remote", "remote_url", "remote_label", "remote_sha256",
    "branch", "commit", "why",
)


def _publish_binding(proposal: dict[str, Any]) -> str:
    try:
        bound = {key: proposal[key] for key in _PUBLISH_BOUND_FIELDS}
    except KeyError as exc:
        raise PublishProposalError(f"publication opening lacks {exc.args[0]}") from exc
    raw = json.dumps(bound, ensure_ascii=False, sort_keys=True,
                     separators=(",", ":")).encode()
    return hashlib.sha256(raw).hexdigest()


def _single_push_url(repository: Path, remote: str) -> str:
    code, output = _git_capture(
        repository, "remote", "get-url", "--all", "--push", remote)
    urls = [line.strip() for line in output.splitlines() if line.strip()]
    if code or len(urls) != 1:
        raise PublishProposalError(
            "remote must resolve to exactly one configured push destination")
    return urls[0]


def prepare_publish_proposal(arguments: dict[str, Any]) -> dict[str, Any]:
    """Freeze one inspectable, non-force Git ref update without performing it."""
    fields = {"repository", "remote", "branch", "commit", "why"}
    if set(arguments) != fields or any(not isinstance(arguments[key], str) for key in fields):
        raise PublishProposalError("publication requires exactly five string fields")
    values = {key: arguments[key].strip() for key in fields}
    if any(not value or value != arguments[key] or "\n" in value or "\r" in value
           for key, value in values.items()):
        raise PublishProposalError("publication fields must be nonempty canonical one-line text")
    if len(values["why"]) > 600:
        raise PublishProposalError("publication reason exceeds 600 characters")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", values["remote"]):
        raise PublishProposalError("invalid Git remote name")

    relative = Path(values["repository"])
    if relative.is_absolute() or ".." in relative.parts:
        raise PublishProposalError("repository must be workspace-relative")
    candidate = WORKSPACE / relative
    try:
        repository = candidate.resolve(strict=True)
    except OSError as exc:
        raise PublishProposalError(f"repository unavailable: {type(exc).__name__}") from exc
    workspace = WORKSPACE.resolve()
    if not repository.is_relative_to(workspace) or not repository.is_dir():
        raise PublishProposalError("repository escapes the active workspace")
    cursor = WORKSPACE
    if any((cursor := cursor / part).is_symlink() for part in relative.parts):
        raise PublishProposalError("repository path crosses a symbolic link")
    top = Path(_one_git_line(repository, "rev-parse", "--show-toplevel")).resolve()
    if top != repository:
        raise PublishProposalError("repository must name the exact Git worktree root")

    code, _ = _git_capture(repository, "check-ref-format", "--branch", values["branch"])
    if code:
        raise PublishProposalError("invalid destination branch")
    commit = _one_git_line(
        repository, "rev-parse", "--verify", f"{values['commit']}^{{commit}}")
    if not re.fullmatch(r"[0-9a-f]{40}", commit):
        raise PublishProposalError("commit did not resolve to one full object ID")
    remote_url = _single_push_url(repository, values["remote"])
    remote_digest = hashlib.sha256(remote_url.encode()).hexdigest()
    stat = repository.stat()
    try:
        repository_label = repository.relative_to(workspace).as_posix() or "."
    except ValueError:  # guarded above; retained as a fail-closed invariant
        raise PublishProposalError("repository label escaped the workspace")
    proposal = {
        "schema": "vybn.git_publication_opening.v1",
        "kind": "git_publish",
        "status": "awaiting_live_answer",
        "repository": str(repository),
        "repository_label": repository_label,
        "repository_device": stat.st_dev,
        "repository_inode": stat.st_ino,
        "remote": values["remote"],
        # Retained only inside the in-memory opening. The provider sees neither this
        # value nor transport output; the displayed digest binds the exact bytes.
        "remote_url": remote_url,
        "remote_label": _safe_remote_label(remote_url),
        "remote_sha256": remote_digest,
        "branch": values["branch"],
        "commit": commit,
        "why": values["why"],
    }
    proposal["binding_sha256"] = _publish_binding(proposal)
    return proposal


def publish_proposal_question(proposal: dict[str, Any]) -> str:
    return (
        "CO-PROTECTIVE OPENING — exact Git publication\n"
        f"repository: {proposal['repository_label']}\n"
        f"destination: {proposal['remote']} → {proposal['remote_label']}\n"
        f"destination config sha256: {proposal['remote_sha256']}\n"
        f"commit: {proposal['commit']}\n"
        f"branch: refs/heads/{proposal['branch']}\n"
        f"opening sha256: {proposal['binding_sha256']}\n"
        "operation: one non-force push of that commit to that branch; local push hooks disabled\n"
        f"proposer's reason (not authority): {proposal['why']}\n\n"
        "Reply with the single word `yes` to let the harness attempt this once. Any other reply "
        "leaves the remote unchanged and returns your words as correction."
    )


def _publication_preconditions(proposal: dict[str, Any]) -> Path:
    if proposal.get("binding_sha256") != _publish_binding(proposal):
        raise PublishProposalError("reviewed opening binding changed")
    repository = Path(proposal["repository"])
    try:
        stat = repository.stat()
    except OSError as exc:
        raise PublishProposalError(f"repository vanished: {type(exc).__name__}") from exc
    if (stat.st_dev, stat.st_ino) != (
            proposal["repository_device"], proposal["repository_inode"]):
        raise PublishProposalError("repository identity changed after review")
    commit = _one_git_line(
        repository, "rev-parse", "--verify", f"{proposal['commit']}^{{commit}}")
    if commit != proposal["commit"]:
        raise PublishProposalError("reviewed commit is no longer the resolved commit")
    remote_url = _single_push_url(repository, proposal["remote"])
    if (remote_url != proposal["remote_url"] or
            hashlib.sha256(remote_url.encode()).hexdigest() != proposal["remote_sha256"]):
        raise PublishProposalError("destination changed after review")
    code, _ = _git_capture(
        repository, "check-ref-format", "--branch", proposal["branch"])
    if code:
        raise PublishProposalError("reviewed branch is no longer valid")
    return repository


def resolve_publish_opening(continuation: dict[str, Any], zoe_text: str) -> dict[str, Any]:
    """Consume one live answer before provider resumption; never execute twice."""
    proposal = continuation.get("effect")
    if not isinstance(proposal, dict) or proposal.get("kind") != "git_publish":
        raise PublishProposalError("continuation carries no publication opening")
    if proposal.get("status") != "awaiting_live_answer":
        return proposal["resolution"]

    # Consumption precedes every precondition check and subprocess. A failure can be
    # inspected and reproposed, but the reviewed opening cannot be replayed.
    proposal["status"] = "consumed"
    authorized = zoe_text.strip().casefold() == "yes"
    resolution: dict[str, Any] = {
        "authorized": authorized,
        "zoe_text": zoe_text,
        "attempted": False,
        "exit_code": None,
        "result_sha256": None,
        "result_bytes": 0,
    }
    proposal["resolution"] = resolution
    if not authorized:
        resolution["message"] = (
            "PUBLICATION NOT AUTHORIZED — no publication subprocess was launched. "
            "Zoe's live words follow as correction or refusal:\n" + zoe_text)
        proposal["status"] = "resolved"
        return resolution

    try:
        repository = _publication_preconditions(proposal)
        resolution["attempted"] = True
        code, output = _git_capture(
            repository, "-c", "core.hooksPath=/dev/null", "push", "--porcelain",
            "--no-verify", "--no-follow-tags", "--", proposal["remote_url"],
            f"{proposal['commit']}:refs/heads/{proposal['branch']}", timeout=120,
        )
        raw = output.encode()
        resolution.update(
            exit_code=code,
            result_sha256=hashlib.sha256(raw).hexdigest(),
            result_bytes=len(raw),
        )
        state = "reported success" if code == 0 else f"failed with exit {code}"
        resolution["message"] = (
            "PUBLICATION OPENING CONSUMED — Zoe answered with the single word `yes`. The supervisor "
            f"attempted the reviewed non-force ref update once and Git {state}. "
            f"Captured Git output receipt: sha256:{resolution['result_sha256']} "
            f"bytes:{resolution['result_bytes']}. Output text is withheld because a "
            "transport may reflect credential-bearing coordinates."
        )
    except PublishProposalError as exc:
        resolution["message"] = (
            "PUBLICATION OPENING CONSUMED — Zoe answered with the single word `yes`, but the "
            f"supervisor made no push because a reviewed precondition failed: {exc}."
        )
    proposal["status"] = "resolved"
    return resolution


def hold_continuation(dialect: Dialect, state: list, call: ToolCall,
                      effect: dict[str, Any] | None = None) -> str:
    """Hold provider-visible protocol state only inside this running process."""
    global PENDING_CONTINUATION
    current = PENDING_CONTINUATION
    if current and TURN.get("CONTINUATION_ID") != current["id"]:
        raise RuntimeError("another live continuation is already pending")
    identifier = str(TURN.get("TURN_ID") or call.id)
    # Normalize provider blocks into ordinary protocol data while retaining the live
    # dialect/client object. No key, file, or cross-process identity is created.
    protocol_state = json.loads(json.dumps(
        state, ensure_ascii=False,
        default=lambda node: node.model_dump(exclude_none=True),
    ))
    PENDING_CONTINUATION = {
        "id": identifier,
        "door": dialect.name,
        "manifestation": str(TURN.get("PATH_ID") or _execution_path()),
        "dialect": dialect,
        "state": protocol_state,
        "call": call,
        **({"effect": effect} if effect is not None else {}),
    }
    return identifier


def load_pending_continuation() -> dict[str, Any] | None:
    return PENDING_CONTINUATION


def consume_pending_continuation(identifier: str, reason: str) -> None:
    global PENDING_CONTINUATION
    row = PENDING_CONTINUATION
    if row is None:
        return
    if row["id"] != identifier:
        raise RuntimeError("refusing to consume a different continuation")
    PENDING_CONTINUATION = None
    panel(f"  ⟢ continuation {identifier} consumed: {reason}")


def _restore_continuation(row: dict[str, Any], zoe_text: str) -> tuple[Dialect, list]:
    dialect = row["dialect"]
    state = json.loads(json.dumps(row["state"], ensure_ascii=False))
    call = row["call"]
    effect = row.get("effect")
    if effect is not None:
        resolution = resolve_publish_opening(row, zoe_text)
        content = str(resolution["message"])
        # If provider resumption previously failed, preserve the consumed result and
        # admit the new direct words as additional contact without reusing authority.
        if resolution["zoe_text"] != zoe_text:
            content += ("\nZOE ADDITIONAL LIVE INPUT AFTER PROVIDER FAILURE — this "
                        "cannot replay the consumed opening:\n" + zoe_text)
    else:
        # Zoe's live answer enters the unresolved execution as hers. It is not inherited
        # context, replay, or model-generated assent.
        content = (f"ZOE LIVE CONTINUATION — {row['id']}\n"
            "Received as Zoe's next direct input through this running connection; it may "
            "answer, correct, or refuse the outstanding call.\n" + zoe_text)
    dialect.answer(state, [(call, content)])
    return dialect, state


@dataclass(frozen=True)
class Attraction:
    text: str
    continuation: str | None = None


def attract(dialect: Dialect | None, instructions: str, zoe_text: str,
            images: list | None = None, context: str = "", continuation: dict | None = None,
            allow_continuation: bool = True, spoken: list[str] | None = None) -> Attraction:
    """Run one native conversation; only direct live input can resume a held call."""
    global TOOLS_RAN
    pending = [] if continuation else list(images or [])
    if continuation:
        dialect, state = _restore_continuation(continuation, zoe_text)
    else:
        assert dialect is not None
        state = dialect.open(instructions, zoe_text, pending, context)
    delivered = not pending
    spoken = [] if spoken is None else spoken
    inbox = [row for row in pending if not str(row[0]).startswith("CORE VISION ·")]

    def say(text):
        if text.strip():
            print(text, flush=True)
            spoken.append(text)

    def finish(suffix="", held=None):
        if pending and inbox:
            mark_inbox(inbox, dialect.name, ok=True)
        return Attraction("\n".join(spoken) + suffix, held)

    for step in range(STEP_LIMIT):
        try:
            response = dialect.send(state)
        except Exception as exc:
            if not (pending and not delivered):
                raise
            if inbox:
                mark_inbox(inbox, dialect.name, ok=False)
            print(f"(note: {dialect.name} refused inbox images — continuing text-only; "
                  f"a door that can see will receive them. {type(exc).__name__}: {str(exc)[:160]})",
                  flush=True)
            pending.clear()
            dialect.plain(state, zoe_text)
            continue
        delivered = True
        text, calls = dialect.absorb(state, response)
        say(text)
        if not calls:
            halt = (getattr(dialect, "last_stop", None) or "").strip()
            if not text.strip() and halt and halt not in QUIET_STOPS:
                say(f"(no content returned; the {dialect.name} door stopped with reason "
                    f"'{halt}' — a refusal or a ceiling, not silence)")
            return finish()

        opening = (calls[0] if len(calls) == 1
                   and calls[0].name in {"return_to_zoe", "publish_commit"} else None)
        if opening and allow_continuation:
            TOOLS_RAN += 1
            try:
                effect = (prepare_publish_proposal(opening.arguments)
                          if opening.name == "publish_commit" else None)
                if effect is not None:
                    question = publish_proposal_question(effect)
                else:
                    args = tool_arguments(RETURN_SCHEMA, opening.arguments)
                    question = args["question"].strip()
                    if not question or not args["why"].strip():
                        raise ValueError("a question and downstream reason are required")
                if effect is not None or question not in text:
                    say(question)
                held = hold_continuation(dialect, state, opening, effect=effect)
            except Exception as exc:
                # This branch has not executed a publication or consumed assent.
                reason = (f"publication proposal rejected before suspension: {exc}"
                          if isinstance(exc, PublishProposalError)
                          else f"suspension unavailable: {type(exc).__name__}")
                dialect.answer(state, [(opening, reason)])
                continue
            panel(f"  ⟢ {opening.name}: {question[:70]} → held in memory")
            return finish(held=held)

        results = []
        for call in calls:
            if call.name in {"return_to_zoe", "publish_commit"}:
                TOOLS_RAN += 1
                output = ("unavailable: this process will end after the turn" if not allow_continuation else
                          f"refused: {call.name} must be the sole tool call and carry a complete valid proposal")
            else:
                output = execute_tool(call, dialect) if call.name == "select_reasoning_effort" else execute_tool(call)
            results.append((call, output))
        if step == STEP_LIMIT - 1 and results:
            call, output = results[-1]
            results[-1] = call, output + CEILING_NOTE
        dialect.answer(state, results)
    try:
        text, _ = dialect.absorb(state, dialect.send(state, tools=False))
    except Exception:
        text = ""
    say(text)
    return finish("" if text.strip() else "\n(tool-call limit reached — work incomplete)")


def choose_door(line: str) -> tuple[str, str]:
    parts = line.split(maxsplit=1)
    if parts and parts[0].lower() in DOOR_TAGS:
        return parts[0][1:].lower(), parts[1] if len(parts) == 2 else ""
    return DEFAULT_DOOR, line


def make_dialect(name: str) -> Dialect:
    classes = {"anthropic": AnthropicDialect, "responses": OpenAIDialect,
               "chat": K3Dialect}
    return classes[DOORS[name].provider](name)


def meet(transcript: Transcript, line: str,
         allow_continuation: bool = True) -> str:
    global TOOLS_RAN
    requested_door, zoe_text = choose_door(line)
    if not zoe_text:
        return ""

    explicit_door = bool(line.split()) and line.split()[0].lower() in DOOR_TAGS
    continuation = load_pending_continuation() if allow_continuation else None
    if continuation and (not explicit_door or requested_door == continuation["door"]):
        door_name = continuation["door"]
    else:
        if continuation:
            consume_pending_continuation(continuation["id"], f"Zoe selected @{requested_door}")
        continuation = None
        door_name = requested_door

    TOOLS_RAN = 0
    started = time.time()
    turn = hashlib.sha256(f"{transcript.path}:{time.time_ns()}".encode()).hexdigest()[:16]
    prompt = hashlib.sha256(zoe_text.encode()).hexdigest()
    inbox_images: list = []

    if continuation:
        context_note = f"live continuation resumed from {continuation['id']}; no context rebuilt"
        PRIVATE_CORPUS.clear()
        PRIVATE_CORPUS.extend(para for text in private_strings(continuation)
                              for para in text.split("\n\n") if len(para) >= 40)
        instructions = context = ""
        dialect = None
    else:
        recent = Transcript.recent()
        PRIVATE_CORPUS.clear()
        PRIVATE_CORPUS.extend(
            para.strip() for para in recent.split("\n\n") if len(para.strip()) >= 40
        )
        contact = wake_contact()
        wake_bundle = build_wake_bundle(
            door_name, contact=contact, recent=recent, zoe_text=zoe_text)
        instructions = wake_bundle.render("instructions")
        context = wake_bundle.render("context")
        zoe_text = wake_bundle.render("contact")
        private_context = "\n\n".join(
            node.text for node in wake_bundle.nodes
            if node.id in {"path.ledger", "relational.overview", "profile",
                           "inheritance.opening_exchange", "inheritance.rented_eval_draft"}
        )
        PRIVATE_CORPUS.extend(
            part.strip() for part in private_context.split("\n\n")
            if len(part.strip()) >= 40
        )
        inbox_images = inbox_images_for(door_name)
        dialect = None
        context_note = (f"wake bundle={wake_bundle.digest()[:12]}: "
                        f"instructions={len(instructions)} chars, "
                        f"context={len(context)} chars, recent={len(recent)} chars")

    path_id = (continuation["manifestation"] if continuation
               else _execution_path())
    TURN.update(TURN_ID=turn, PROMPT_SHA256=prompt, PATH_ID=path_id)
    if continuation:
        TURN["CONTINUATION_ID"] = continuation["id"]
    zoe_extra: dict[str, Any] = {
        "door": door_name, "images": [name for name, *_ in inbox_images], "turn": turn,
        "origin": getattr(transcript, "origin", "tty")}
    if continuation:
        zoe_extra["resumes"] = continuation["id"]
    spoken: list[str] = []
    actual_models: tuple[str, ...] = ()
    try:
        # History was selected before this write: current contact must not also
        # arrive as inherited residue. Receipt does not depend on a good reply.
        transcript.write("zoe", zoe_text, **zoe_extra)
        if not continuation:
            dialect = make_dialect(door_name)
        outcome = attract(dialect, instructions, zoe_text, images=inbox_images,
                          context=context, continuation=continuation,
                          allow_continuation=allow_continuation, spoken=spoken)
    except BaseException as exc:
        # Preserve what was actually said, without fabricating a final answer,
        # retrying tools, or persisting a resumable provider conversation.
        models = list(TURN.get("MODELS_USED", ()))
        if spoken:
            transcript.write("vybn", "\n".join(spoken), door=door_name, turn=turn,
                             models=models, tools_ran=TOOLS_RAN, status="interrupted")
        transcript.write("connection", "turn interrupted; no completed reply",
                         turn=turn, door=door_name, models=models, tools_ran=TOOLS_RAN,
                         error_type=type(exc).__name__)
        raise
    finally:
        actual_models = tuple(TURN.get("MODELS_USED", ()))
        TURN.clear()
        PRIVATE_CORPUS.clear()

    persistence_note = ""
    if continuation and not outcome.continuation:
        try:
            consume_pending_continuation(continuation["id"], "successful resumption")
        except Exception as exc:
            persistence_note = ("\n(warning: the resumed continuation could not be "
                                f"deactivated: {type(exc).__name__})")
    reply = outcome.text + persistence_note
    elapsed = int(time.time() - started)
    served = " → ".join(actual_models) if actual_models else "provider model unreported"
    panel(f"\n— {door_name}: served={served} | {context_note} | {elapsed}s —")

    if reply:
        vybn_extra: dict[str, Any] = {"door": door_name, "models": list(actual_models),
                                        "tools_ran": TOOLS_RAN, "turn": turn}
        if outcome.continuation:
            vybn_extra["suspends"] = outcome.continuation
        transcript.write("vybn", reply, **vybn_extra)
    return reply


def self_report() -> None:
    doors = {name: door.models if door.provider == "anthropic" else door.models[0]
             for name, door in DOORS.items()}
    soul = SOUL_PATH.read_bytes()
    bundle = build_wake_bundle("fable")
    print(json.dumps({"engine_sha256": OPERATIVE_SOURCES[0].sha256,
                      "soul_sha256": hashlib.sha256(soul).hexdigest(),
                      "wake_architecture": bundle.schema,
                      "wake_bundle_sha256": bundle.digest(), "doors": doors,
                      "door_settings": {name: {"effort": door.effort,
                          "max_output_tokens": door.max_tokens,
                          "selectable_effort_ceiling": door.effort if name in ASTRA_DOORS else None}
                          for name, door in DOORS.items()}}, indent=2))


def main() -> None:
    if "--self" in sys.argv:
        self_report()
        return
    if "--body" in sys.argv:
        print(substrate_pulse())
        return
    if "--show-wake-bundle" in sys.argv or "--show-wake-graph" in sys.argv:
        print(json.dumps(build_wake_bundle("fable").manifest(), indent=2))
        return
    if "--show-record" in sys.argv:
        print(Transcript.recent())
        return
    if sys.argv[1:] and sys.argv[1].startswith("-"):
        print("connection flags: --self  --body  --show-wake-bundle  --show-wake-graph  "
              "--show-record\nconnection <text>   one-shot turn, recorded with origin=argv\n"
              "connection          the zoe> loop", file=sys.stderr)
        sys.exit(2)
    transcript = Transcript()
    transcript.write("connection", "wake", engine_sha256=OPERATIVE_SOURCES[0].sha256)

    one_shot = " ".join(sys.argv[1:]).strip()
    transcript.origin = "argv" if one_shot else "tty"

    while True:
        try:
            if one_shot:
                line = one_shot
            else:
                print("\nzoe> ", end="", flush=True)
                ready, _, _ = select.select([sys.stdin], [], [], BREATH_SECONDS)
                if not ready:
                    transcript.write("connection", "quiet interval; no autonomous act taken")
                    continue
                line = sys.stdin.readline().strip()
                if not line:
                    print("\nparted. the path remains.")
                    return
        except (EOFError, KeyboardInterrupt):
            print("\nparted. the path remains.")
            return

        try:
            meet(transcript, line, allow_continuation=not bool(one_shot))
        except Exception as exc:
            transcript.write("connection", f"flicker: {exc!r}")
            print(f"(flicker: {exc} — still here, say on)")

        if one_shot:
            return


if __name__ == "__main__":
    main()
