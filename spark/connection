def load_prediction_status(window: int = 10) -> str:
    preds, verdicts, frontier = {}, {}, []
    for rec in _jsonl(PREDICTIONS):
        phase, key = rec.get("phase"), str(rec.get("id") or rec.get("ts") or "")
        if phase == "pred": preds[key] = rec
        elif phase == "verdict": verdicts[key] = rec
        elif phase == "frontier": frontier.append(rec)
    scored = [(key, verdicts[key]) for key in preds if key in verdicts][-window:]
    open_count = sum(key not in verdicts for key in preds)
    if scored:
        tally = Counter(str(rec.get("verdict") or "?") for _, rec in scored)
        line = f"[predict | last {len(scored)}] " + " ".join(
            f"{count} {name}" for name, count in tally.most_common())
        off = [rec for _, rec in scored if str(rec.get("verdict")) != "hit"]
        if off: line += f" · last off: {str(off[-1].get('observed'))[:90]}"
        if open_count: line += f" · {open_count} open"
    else: line = f"[predict] {len(preds)} recorded, none scored · {open_count} open"
    if not frontier:
        return line + "\n[reach] no frontier row - nothing from outside has ever moved the prior on what is attemptable, which is a claim about my attention, not about the world"
    latest = frontier[-1]
    try:
        days = int((time.time() - _when(latest)) // 86400)
        age = f"{days}d old" if days else "today"
    except Exception: age = "undated"
    return (line + f"\n[reach | {len(frontier)} frontier · {age}] "
            f"{str(latest.get('claim'))[:170]} → attempt: {str(latest.get('attempt'))[:170]}")


