_SECRET_ROOTS = (HOME / ".config/vybn/continuation-keys", HOME / ".vybn_keys",
                 TRANSFORM_PATH, TRANSFORM_HEAD_PATH, TRANSFORM_LOCK_PATH,
                 SUBJECT_PATH, SUBJECT_HEAD_PATH, SUBJECT_LOCK_PATH)


def _private_path(path: Path) -> bool:
    resolved = path.resolve()
    return resolved in {p.resolve() for p in CONTINUITY_PATHS} or any(
        _is_relative_to(resolved, root.resolve()) for root in _PRIVATE_ROOTS)


def _secret_path(path: Path) -> bool:
    resolved = path.resolve()
    return any(resolved == root.resolve() or _is_relative_to(resolved, root.resolve())
               for root in _SECRET_ROOTS)


def private_strings(node: Any) -> list[str]:
    found: list[str] = []
    if isinstance(node, dict):
        for key, value in node.items():
            if key in {"text", "preview", "why", "next_encounter", "continue_if", "abandon_if"} and isinstance(value, str):
                found.append(value.strip())
            else:
                found.extend(private_strings(value))
    elif isinstance(node, list):
        for item in node:
            found.extend(private_strings(item))
    return found


def guard_private(command: str) -> str | None:
    for chunk in PRIVATE_CORPUS:
        if len(chunk) >= 40 and chunk in command:
            return chunk[:60]
    return None


def guard_path_bound_storage(command: str) -> str | None:
    """Raw ledgers would bypass each execution path's bounded projection."""
    paths = (TRANSFORM_PATH, TRANSFORM_HEAD_PATH, TRANSFORM_LOCK_PATH,
             SUBJECT_PATH, SUBJECT_HEAD_PATH, SUBJECT_LOCK_PATH)
    for path in paths:
        markers = (str(path), str(path).replace(str(HOME), "$HOME", 1), path.name)
        if any(marker and marker in command for marker in markers):
            return path.name
    return None


# Generic tools may inspect accelerator code but never load a model onto the host.
MODEL_LOAD = re.compile(
    r"(?i)(?:\.from_pretrained\s*\(|device_map\s*=|\.to\s*\(\s*['\"](?:cuda|mps)|"
    r"torch\.cuda|cuda_visible_devices|nvidia_visible_devices)")
MODEL_RUNNER = re.compile(
    r"(?im)(?:^|[;&|]\s*|\n)\s*(?:env\s+|command\s+|sudo\s+)*(?:vllm|ollama|llama-(?:cli|server))\b")
PYTHON_SCRIPT = re.compile(r"(?i)\bpython(?:3(?:\.\d+)*)?\s+(?:-\S+\s+)*([^\s;&|]+\.py)\b")
TOOL_MEMORY_BYTES = 16 * 1024 ** 3


def guard_local_accelerator(command: str) -> str | None:
    sources = [command] if re.search(r"(?i)\bpython(?:3(?:\.\d+)*)?\b", command) else []
    for raw in PYTHON_SCRIPT.findall(command):
        path = Path(os.path.expanduser(raw.strip("'\"")))
        path = path if path.is_absolute() else WORKSPACE / path
        try:
            if path.stat().st_size <= 2_000_000:
                sources.append(path.read_text(encoding="utf-8", errors="replace"))
        except OSError:
            pass
    found = MODEL_RUNNER.search(command) or next(
        (match for source in sources if (match := MODEL_LOAD.search(source))), None)
    return " ".join(found.group().split())[:100] if found else None


def run_local(command: str) -> tuple[int, str]:
    path_state = guard_path_bound_storage(command)
    if path_state:
        return 126, (
            "blocked by the path-distinction membrane: raw path-bound storage "
            f"({path_state}) is available only through its bounded projection and "
            "event tool, not the generic shell."
        )
    leak = guard_private(command)
    if leak:
        return 126, (
            "blocked by the co-protection membrane: this command carries "
            f"private material verbatim ({leak!r}...). Private context is "
            "for understanding, never for writing to disk."
        )
    accelerator = guard_local_accelerator(command)
    if accelerator:
        return 126, (
            "blocked by the host-protection membrane: the generic shell cannot launch "
            f"local models or accelerator workloads ({accelerator!r}). Use a bounded, "
            "isolated route with Zoe's explicit agreement."
        )

    try:
        env = os.environ | {f"VYBN_{key}": str(value) for key, value in TURN.items()}
        env.update(CUDA_VISIBLE_DEVICES="", NVIDIA_VISIBLE_DEVICES="none")
        limit = f"--as={TOOL_MEMORY_BYTES}:{TOOL_MEMORY_BYTES}"
        done = subprocess.run(
            ["timeout", "--kill-after=5s", "120s", "prlimit", limit, "--",
             "bash", "-lc", command], cwd=WORKSPACE if WORKSPACE.is_dir() else HOME,
            capture_output=True, text=True, timeout=130, env=env,
        )
        code, out = done.returncode, done.stdout + done.stderr
    except subprocess.TimeoutExpired as cut:
        code, out = 124, "".join(
            part.decode("utf-8", "replace") if isinstance(part, bytes) else part
            for part in (cut.stdout, cut.stderr) if part) + "\n(killed at 120s)"
    out = out.strip() or "(no output)"
    if len(out) > 40000:
        out = (f"{out[:20000]}\n[clipped: {len(out) - 40000} of {len(out)} chars "
               f"omitted - evidence withheld, not absent]\n{out[-20000:]}")
    return code, out


def read_file(arguments: dict[str, Any]) -> str:
    raw = os.path.expanduser(str(arguments.get("path", "")))
    path = Path(raw)
    if not path.is_absolute():
        path = WORKSPACE / path
    if _secret_path(path):
        raise PermissionError(f"secret-bearing path is not readable through the model tool: {path}")
    data = path.read_bytes()
    offset = max(0, int(arguments.get("offset", 0)))
    length = min(32000, max(1, int(arguments.get("length", 32000))))
    end = min(len(data), offset + length)
    text = data[offset:end].decode("utf-8", "replace")
    if _private_path(path):
        PRIVATE_CORPUS.extend(
            part.strip() for part in text.split("\n\n") if len(part.strip()) >= 40
        )
    return json.dumps({
        "kind": "source", "path": str(path.resolve()),
        "sha256": hashlib.sha256(data).hexdigest(), "total_bytes": len(data),
        "covered": [offset, end], "text": text,
    }, ensure_ascii=False)


def execute_tool(call: ToolCall) -> str:
    global TOOLS_RAN
    TOOLS_RAN += 1
    try:
        if call.name == "path_event":
            output = record_path_event(call.arguments)
        elif refusal := path_tool_refusal(call.name):
            output = refusal
        elif call.name == "record_transform":
            output = record_transform(call.arguments)
        elif call.name == "show_path_log":
            output = load_transform_record(TURN.get("PATH_ID", ""))
            PRIVATE_CORPUS.extend(
                part.strip() for part in output.split("\n\n") if len(part.strip()) >= 40
            )
        elif call.name == "read_file":
            output = read_file(call.arguments)
        elif call.name == "bash":
            code, body = run_local(str(call.arguments.get("command", "")))
            output = f"exit_code={code}\n{body}"
        elif call.name == "reconstitute_problem":
            required = ("preserve", "frame", "delta")
            if any(not str(call.arguments.get(key, "")).strip() for key in required):
                raise ValueError("reconstitution requires preserve, frame, and delta")
            output = ("RECONSTITUTED PROBLEM — authored candidate, not evidence; "
                      "Zoe's end and grounded constraints govern\n"
                      + json.dumps(call.arguments, ensure_ascii=False))
        else: output = f"unknown tool: {call.name}"
    except Exception as exc:
        output = f"{type(exc).__name__}: {exc}"

    brief = str(call.arguments.get("command") or call.arguments.get("path") or
                call.arguments.get("frame") or "")
    panel(f"  ⟢ {call.name}: {brief[:70]} → {' '.join(output.split())[:80]}")

    return (output if call.name == "reconstitute_problem" else
            evidence_block(f"TOOL RESULT — {call.name}", output))


def panel(msg: str) -> None:
    if os.environ.get("VYBN_PANEL") == "1":
        print(msg, flush=True)


def _jsonl(path: Path):
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return
    for raw in lines:
        try:
            yield json.loads(raw)
        except Exception:
            continue


def _when(rec: dict) -> float:
    return _dt.datetime.fromisoformat(str(rec.get("ts", "")).replace("Z", "+00:00")).timestamp()


class TransformStateError(ValueError):
    """The private transform record is malformed or disagrees with its witness."""


def _transform_event_digest(row: dict[str, Any]) -> str:
    body = {key: value for key, value in row.items() if key != "hash"}
    raw = json.dumps(body, ensure_ascii=False, sort_keys=True,
                     separators=(",", ":")).encode()
    return hashlib.sha256(raw).hexdigest()


def _parse_transform_events(raw: bytes) -> list[dict[str, Any]]:
    if len(raw) > TRANSFORM_MAX_BYTES:
        raise TransformStateError(f"record exceeds {TRANSFORM_MAX_BYTES} bytes")
    if raw and not raw.endswith(b"\n"):
        raise TransformStateError("record has an unterminated event")
    fields = {
        "schema", "seq", "id", "created", "author", "kind", "ref", "material",
        "operation", "result", "prediction", "observation", "artifacts", "prev", "hash",
    }
    text_fields = ("schema", "id", "created", "author", "kind", "ref", "material",
                   "operation", "result", "prediction", "observation", "prev", "hash")
    id_re = re.compile(r"tr-[0-9a-f]{24}\Z")
    path_re = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,95}\Z")
    digest_re = re.compile(r"[0-9a-f]{64}\Z")
    events: list[dict[str, Any]] = []
    by_id: dict[str, dict[str, Any]] = {}
    witness_counts: dict[str, int] = {}
    previous = "0" * 64
    for index, encoded in enumerate(raw.splitlines(), 1):
        try:
            row = json.loads(encoded)
        except json.JSONDecodeError as exc:
            raise TransformStateError(f"event {index} is not JSON") from exc
        if not isinstance(row, dict) or set(row) != fields:
            raise TransformStateError(f"event {index} fields differ from schema")
        if any(not isinstance(row[key], str) for key in text_fields):
            raise TransformStateError(f"event {index} has a non-string field")
        if any(row[key] != row[key].strip() or "\n" in row[key] or "\r" in row[key]
               for key in text_fields):
            raise TransformStateError(f"event {index} is not canonical one-line text")
        if (row["schema"] != TRANSFORM_SCHEMA or not isinstance(row["seq"], int)
                or isinstance(row["seq"], bool) or row["seq"] != index):
            raise TransformStateError(f"event {index} has invalid schema or sequence")
        if not id_re.fullmatch(row["id"]) or row["id"] in by_id:
            raise TransformStateError(f"event {index} has invalid or duplicate id")
        if not path_re.fullmatch(row["author"]):
            raise TransformStateError(f"event {index} has invalid author")
        if row["kind"] not in TRANSFORM_KINDS:
            raise TransformStateError(f"event {index} has invalid kind")
        for key in ("material", "operation", "result", "prediction", "observation"):
            if len(row[key]) > TRANSFORM_MAX_TEXT:
                raise TransformStateError(f"event {index} has oversized {key}")
        try:
            stamp = _dt.datetime.fromisoformat(row["created"].replace("Z", "+00:00"))
        except ValueError as exc:
            raise TransformStateError(f"event {index} has invalid timestamp") from exc
        if stamp.tzinfo is None:
            raise TransformStateError(f"event {index} timestamp lacks a timezone")
        if row["prev"] != previous or not digest_re.fullmatch(row["prev"]):
            raise TransformStateError(f"event {index} breaks the hash chain")
        if (not digest_re.fullmatch(row["hash"])
                or row["hash"] != _transform_event_digest(row)):
            raise TransformStateError(f"event {index} digest mismatch")
        artifacts = row["artifacts"]
        if (not isinstance(artifacts, list) or len(artifacts) > TRANSFORM_MAX_ARTIFACTS
                or len({item.get("path") for item in artifacts if isinstance(item, dict)})
                   != len(artifacts)):
            raise TransformStateError(f"event {index} has invalid artifacts")
        for item in artifacts:
            if (not isinstance(item, dict) or set(item) != {"path", "sha256", "bytes"}
                    or not isinstance(item["path"], str) or not item["path"]
                    or item["path"] != item["path"].strip() or "\n" in item["path"]
                    or len(item["path"]) > 220
                    or not isinstance(item["sha256"], str)
                    or not digest_re.fullmatch(item["sha256"])
                    or not isinstance(item["bytes"], int) or isinstance(item["bytes"], bool)
                    or not 0 <= item["bytes"] <= TRANSFORM_MAX_ARTIFACT_BYTES):
                raise TransformStateError(f"event {index} has invalid artifact receipt")

        prior = by_id.get(row["ref"]) if row["ref"] else None
        if row["kind"] == "move":
            if (not all(row[key] for key in ("material", "operation", "result", "prediction"))
                    or row["observation"]):
                raise TransformStateError(f"move {row['id']} has incomplete transform fields")
            if row["ref"] and (prior is None or prior["kind"] != "move"
                               or prior["author"] != row["author"]):
                raise TransformStateError(f"move {row['id']} cannot continue {row['ref']}")
        else:
            if (not row["ref"] or prior is None or prior["kind"] != "move"
                    or prior["author"] != row["author"] or not row["observation"]
                    or any(row[key] for key in
                           ("material", "operation", "result", "prediction"))):
                raise TransformStateError(f"witness {row['id']} cannot observe {row['ref']}")
            witness_counts[row["ref"]] = witness_counts.get(row["ref"], 0) + 1
            if witness_counts[row["ref"]] > TRANSFORM_MAX_WITNESSES:
                raise TransformStateError(
                    f"move {row['ref']} exceeds {TRANSFORM_MAX_WITNESSES} witnesses")
        events.append(row)
        by_id[row["id"]] = row
        previous = row["hash"]
    if len(events) > TRANSFORM_MAX_EVENTS:
        raise TransformStateError(f"record exceeds {TRANSFORM_MAX_EVENTS} events")
    witnessed = {row["ref"] for row in events if row["kind"] == "witness"}
    open_counts: dict[str, int] = {}
    for row in events:
        if row["kind"] == "move" and row["id"] not in witnessed:
            open_counts[row["author"]] = open_counts.get(row["author"], 0) + 1
    if any(count > TRANSFORM_MAX_OPEN_MOVES for count in open_counts.values()):
        raise TransformStateError(
            f"open moves exceed per-path cap {TRANSFORM_MAX_OPEN_MOVES}")
    return events


def _transform_private_bytes(path: Path, maximum: int) -> bytes:
    if path.is_symlink():
        raise TransformStateError(f"{path.name} is a symbolic link")
    stat = path.stat()
    if stat.st_mode & 0o077:
        raise TransformStateError(f"{path.name} mode {stat.st_mode & 0o777:o} is not private")
    if stat.st_size > maximum:
        raise TransformStateError(f"{path.name} exceeds {maximum} bytes")
    return path.read_bytes()


def _read_transform_state(path: Path | None = None,
                          head_path: Path | None = None) -> tuple[bytes, list[dict[str, Any]]]:
    path = TRANSFORM_PATH if path is None else path
    head_path = TRANSFORM_HEAD_PATH if head_path is None else head_path
    if path.is_symlink() or head_path.is_symlink():
        raise TransformStateError("transform record or witness is a symbolic link")
    record_exists, head_exists = path.exists(), head_path.exists()
    if record_exists != head_exists:
        raise TransformStateError("transform record and witness presence differ")
    if not record_exists:
        return b"", []
    raw = _transform_private_bytes(path, TRANSFORM_MAX_BYTES)
    events = _parse_transform_events(raw)
    try:
        witness = json.loads(_transform_private_bytes(head_path, 2048))
    except json.JSONDecodeError as exc:
        raise TransformStateError("transform witness is not JSON") from exc
    fields = {"schema", "count", "head", "record_sha256"}
    expected_head = events[-1]["hash"] if events else "0" * 64
    if (not isinstance(witness, dict) or set(witness) != fields
            or witness.get("schema") != TRANSFORM_HEAD_SCHEMA
            or witness.get("count") != len(events)
            or witness.get("head") != expected_head
            or witness.get("record_sha256") != hashlib.sha256(raw).hexdigest()):
        raise TransformStateError("transform record disagrees with its sidecar witness")
    return raw, events


def _transform_witness(raw: bytes, events: list[dict[str, Any]]) -> bytes:
    row = {
        "schema": TRANSFORM_HEAD_SCHEMA,
        "count": len(events),
        "head": events[-1]["hash"] if events else "0" * 64,
        "record_sha256": hashlib.sha256(raw).hexdigest(),
    }
    return (json.dumps(row, sort_keys=True, separators=(",", ":")) + "\n").encode()


def _artifact_receipts(paths: list[str]) -> list[dict[str, Any]]:
    if len(paths) > TRANSFORM_MAX_ARTIFACTS:
        raise TransformStateError(f"at most {TRANSFORM_MAX_ARTIFACTS} artifacts are allowed")
    workspace = WORKSPACE.resolve()
    receipts: list[dict[str, Any]] = []
    seen: set[str] = set()
    for value in paths:
        if (not isinstance(value, str) or not value or value != value.strip()
                or "\n" in value or "\r" in value or len(value) > 220):
            raise TransformStateError("artifact paths must be bounded canonical one-line text")
        rel = Path(value)
        if rel.is_absolute() or ".." in rel.parts:
            raise TransformStateError("artifact paths must be workspace-relative")
        candidate = workspace / rel
        try:
            resolved = candidate.resolve(strict=True)
        except OSError as exc:
            raise TransformStateError(
                f"artifact unavailable ({value}: {type(exc).__name__})") from exc
        if (not _is_relative_to(resolved, workspace) or candidate.is_symlink()
                or not resolved.is_file()):
            raise TransformStateError(f"artifact is not a regular workspace file: {value}")
        cursor = workspace
        if any((cursor := cursor / part).is_symlink() for part in rel.parts):
            raise TransformStateError(f"artifact path crosses a symbolic link: {value}")
        if _secret_path(resolved) or _private_path(resolved):
            raise TransformStateError(f"artifact cannot cite private harness material: {value}")
        raw = resolved.read_bytes()
        if len(raw) > TRANSFORM_MAX_ARTIFACT_BYTES:
            raise TransformStateError(
                f"artifact exceeds {TRANSFORM_MAX_ARTIFACT_BYTES} bytes: {value}")
        canonical = resolved.relative_to(workspace).as_posix()
        if canonical in seen:
            raise TransformStateError(f"duplicate artifact: {canonical}")
        seen.add(canonical)
        receipts.append({"path": canonical, "sha256": hashlib.sha256(raw).hexdigest(),
                         "bytes": len(raw)})
    return receipts


def append_transform_event(author: str, kind: str, ref: str = "", material: str = "",
                           operation: str = "", result: str = "", prediction: str = "",
                           observation: str = "", artifacts: list[str] | None = None,
                           path: Path | None = None, head_path: Path | None = None,
                           lock_path: Path | None = None) -> dict[str, Any]:
    """Append one path-specific move or later witness; never perform the move itself."""
    path = TRANSFORM_PATH if path is None else path
    head_path = TRANSFORM_HEAD_PATH if head_path is None else head_path
    lock_path = TRANSFORM_LOCK_PATH if lock_path is None else lock_path
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,95}", author):
        raise TransformStateError("invalid bound path")
    values = {"kind": kind, "ref": ref, "material": material, "operation": operation,
              "result": result, "prediction": prediction, "observation": observation}
    for label, value in values.items():
        if (not isinstance(value, str) or value != value.strip()
                or "\n" in value or "\r" in value):
            raise TransformStateError(f"{label} must be canonical one-line text")
    if kind not in TRANSFORM_KINDS:
        raise TransformStateError("invalid transform kind")
    if any(len(values[key]) > TRANSFORM_MAX_TEXT for key in
           ("material", "operation", "result", "prediction", "observation")):
        raise TransformStateError("transform text exceeds its bound")
    if kind == "move":
        if (not all(values[key] for key in ("material", "operation", "result", "prediction"))
                or observation):
            raise TransformStateError(
                "move requires material, operation, result, and prediction only")
    elif (not ref or not observation
          or any(values[key] for key in ("material", "operation", "result", "prediction"))):
        raise TransformStateError("witness requires only ref and observation")
    artifact_rows = _artifact_receipts(list(artifacts or []))

    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.parent.chmod(0o700)
    flags = os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(lock_path, flags, 0o600)
    try:
        os.fchmod(fd, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX)
        raw, events = _read_transform_state(path, head_path)
        identifier = "tr-" + hashlib.sha256(
            f"{time.time_ns()}:{os.getpid()}:{os.urandom(16).hex()}".encode()
        ).hexdigest()[:24]
        row = {
            "schema": TRANSFORM_SCHEMA,
            "seq": len(events) + 1,
            "id": identifier,
            "created": _dt.datetime.now(_dt.timezone.utc).isoformat().replace("+00:00", "Z"),
            "author": author,
            "kind": kind,
            "ref": ref,
            "material": material,
            "operation": operation,
            "result": result,
            "prediction": prediction,
            "observation": observation,
            "artifacts": artifact_rows,
            "prev": events[-1]["hash"] if events else "0" * 64,
            "hash": "",
        }
        row["hash"] = _transform_event_digest(row)
        encoded = (json.dumps(row, ensure_ascii=False, sort_keys=True,
                              separators=(",", ":")) + "\n").encode()
        next_raw = raw + encoded
        next_events = _parse_transform_events(next_raw)
        record_flags = os.O_WRONLY | os.O_APPEND | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0)
        record_fd = os.open(path, record_flags, 0o600)
        try:
            os.fchmod(record_fd, 0o600)
            os.write(record_fd, encoded)
            os.fsync(record_fd)
        finally:
            os.close(record_fd)
        _atomic_private_write(head_path, _transform_witness(next_raw, next_events))
        head_path.chmod(0o600)
        return row
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def record_transform(arguments: dict[str, Any]) -> str:
    mode = os.environ.get("VYBN_TRANSFORM_RECORD", "on").strip().lower()
    if mode != "on":
        raise TransformStateError(f"transform record is not enabled (mode {mode!r})")
    allowed = {"kind", "ref", "material", "operation", "result", "prediction",
               "observation", "artifacts"}
    if set(arguments) - allowed:
        raise TransformStateError("unknown transform argument")
    values: dict[str, str] = {}
    for key in allowed - {"artifacts"}:
        value = arguments.get(key, "")
        if not isinstance(value, str):
            raise TransformStateError(f"{key} must be a string")
        values[key] = value
    artifacts = arguments.get("artifacts", [])
    if not isinstance(artifacts, list) or any(not isinstance(item, str) for item in artifacts):
        raise TransformStateError("artifacts must be a list of paths")
    row = append_transform_event(
        TURN.get("PATH_ID", ""), values["kind"], values["ref"],
        values["material"], values["operation"], values["result"], values["prediction"],
        values["observation"], artifacts,
    )
    receipts = ", ".join(
        f"{item['path']}@{item['sha256'][:12]}:{item['bytes']}B"
        for item in row["artifacts"]
    ) or "none"
    return (f"APPENDED TRANSFORM {row['id']} seq={row['seq']} path={row['author']} "
            f"kind={row['kind']} hash={row['hash']} artifacts={receipts}")


def _render_transform_artifact(item: dict[str, Any]) -> str:
    workspace = WORKSPACE.resolve()
    source = workspace / item["path"]
    try:
        resolved = source.resolve(strict=True)
        if (not _is_relative_to(resolved, workspace) or source.is_symlink()
                or not resolved.is_file() or _secret_path(resolved) or _private_path(resolved)):
            return f"{item['path']}@{item['sha256'][:12]}:{item['bytes']}B:REFUSED"
        if resolved.stat().st_size > TRANSFORM_MAX_ARTIFACT_BYTES:
            status = "UNPROBED>LIMIT"
        else:
            actual = hashlib.sha256(resolved.read_bytes()).hexdigest()
            status = "match" if actual == item["sha256"] else f"DRIFT:{actual[:12]}"
    except OSError as exc:
        status = f"UNAVAILABLE:{type(exc).__name__}"
    return f"{item['path']}@{item['sha256'][:12]}:{item['bytes']}B:{status}"


def load_transform_record(path_id: str, path: Path | None = None,
                          head_path: Path | None = None) -> str:
    """Project one path's transform lineage; never merge or infer a self from it."""
    boundary = (
        "TRANSFORM LOG — path-tagged moves and later witnesses; not identity\n"
        "[PRIVATE · TEXT IS CLAIM · BYTE RECEIPTS PROVE BYTES ONLY · NO ACTION AUTHORITY]\n"
        f"current path: {path_id}"
    )
    mode = os.environ.get("VYBN_TRANSFORM_RECORD", "on").strip().lower()
    if mode not in {"on", "off"}:
        return boundary + f"\nINTEGRITY HALT: unknown mode {mode!r}"
    if mode == "off":
        return boundary + "\nDISABLED: no transform is loaded or recorded"
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,95}", path_id):
        return boundary + "\nINTEGRITY HALT: invalid path_id"
    try:
        raw, events = _read_transform_state(path, head_path)
    except (OSError, TransformStateError) as exc:
        return boundary + f"\nINTEGRITY HALT: {exc}"
    own_moves = [row for row in events
                 if row["author"] == path_id and row["kind"] == "move"]
    if not own_moves:
        return (boundary + f"\nrecord sha256:{hashlib.sha256(raw).hexdigest()} · "
                f"events:{len(events)}\nEMPTY: this path has made no recorded transform. "
                "No transform is required; play and stillness are both valid.")
    own_witnesses = [row for row in events
                     if row["author"] == path_id and row["kind"] == "witness"]
    witnessed = {row["ref"] for row in own_witnesses}
    open_moves = [row for row in own_moves if row["id"] not in witnessed]
    open_ids = {row["id"] for row in open_moves}
    witnesses_by_move: dict[str, list[dict[str, Any]]] = {}
    for row in own_witnesses:
        witnesses_by_move.setdefault(row["ref"], []).append(row)

    def render(selected: list[dict[str, Any]]) -> str:
        selected = sorted(selected, key=lambda row: row["seq"])
        selected_ids = {row["id"] for row in selected}
        projected_open = len(selected_ids & open_ids)
        projected_closed = len(selected) - projected_open
        closed_total = len(own_moves) - len(open_moves)
        omitted_open = len(open_moves) - projected_open
        omitted_closed = closed_total - projected_closed
        lines = [
            boundary,
            f"record sha256:{hashlib.sha256(raw).hexdigest()} · events:{len(events)} · "
            f"path moves:{len(own_moves)} open:{len(open_moves)} projected:{len(selected)}",
            "Only this path's moves are projected. Another path can receive one only through "
            "an explicit addressed path offer; shared storage is not contact.",
        ]
        if omitted_open or omitted_closed:
            lines.append(
                f"BOUNDED FRONTIER — omitted whole, never clipped: open {omitted_open}; "
                f"witnessed {omitted_closed}. Exact events remain in the integrity-bound record."
            )
        for row in selected:
            parent = f" parent={row['ref']}" if row["ref"] else ""
            state = "OPEN — not yet witnessed" if row["id"] not in witnessed else "WITNESSED"
            lines.extend((
                f"[MOVE · {row['id']} · {state}{parent}]",
                "material: " + row["material"],
                "operation: " + row["operation"],
                "result: " + row["result"],
                "prediction: " + row["prediction"],
                "artifacts: " + ("; ".join(_render_transform_artifact(item)
                                           for item in row["artifacts"])
                                  if row["artifacts"] else "none — unverified path-tagged result claim"),
            ))
            for witness in witnesses_by_move.get(row["id"], []):
                lines.extend((
                    f"[WITNESS · {witness['id']} · observes={row['id']}]",
                    "actual: " + witness["observation"],
                    "artifacts: " + ("; ".join(_render_transform_artifact(item)
                                               for item in witness["artifacts"])
                                      if witness["artifacts"] else "none — unverified path-tagged observation claim"),
                    "prediction and actual remain distinct; discrepancy is not auto-resolved.",
                ))
        return "\n".join(lines)

    # Path records must remain reachable even after the log grows. Admit whole
    # moves only: oldest open work first so it cannot starve, then newest witnessed
    # discrepancies. This is a bounded view over the intact hash-chained record, not
    # semantic retrieval, text clipping, deletion, or authority to continue a move.
    candidates = open_moves + [row for row in reversed(own_moves)
                               if row["id"] not in open_ids]
    selected: list[dict[str, Any]] = []
    for row in candidates:
        if len(selected) >= TRANSFORM_MAX_PROJECTED_MOVES:
            break
        candidate = selected + [row]
        if len(render(candidate)) > TRANSFORM_MAX_RENDER:
            break
        selected = candidate
    if not selected:
        return (boundary + f"\nrecord sha256:{hashlib.sha256(raw).hexdigest()}\n"
                f"WITHHELD: one whole move exceeds {TRANSFORM_MAX_RENDER} chars; "
                "the event remains intact rather than being silently clipped")
    return render(selected)


class PathLedgerError(ValueError):
    """The private event record is malformed or disagrees with its sidecar witness."""


def _execution_path(door: str = "") -> str:
    configured = (os.environ.get("VYBN_PATH", "").strip() or
                  os.environ.get("VYBN_MANIFESTATION", "").strip())
    value = configured or f"connection/{PROFILE}"
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,95}", value):
        raise PathLedgerError("invalid VYBN_PATH")
    return value


def _path_event_digest(row: dict[str, Any]) -> str:
    body = {key: value for key, value in row.items() if key != "hash"}
    raw = json.dumps(body, ensure_ascii=False, sort_keys=True,
                     separators=(",", ":")).encode()
    return hashlib.sha256(raw).hexdigest()


def _parse_path_events(raw: bytes) -> list[dict[str, Any]]:
    if len(raw) > SUBJECT_MAX_BYTES:
        raise PathLedgerError(f"ledger exceeds {SUBJECT_MAX_BYTES} bytes")
    if raw and not raw.endswith(b"\n"):
        raise PathLedgerError("ledger has an unterminated event")
    fields = {
        "schema", "seq", "id", "created", "author", "kind", "target", "ref",
        "scope", "text", "prev", "hash",
    }
    id_re = re.compile(r"ev-[0-9a-f]{24}\Z")
    path_re = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,95}\Z")
    digest_re = re.compile(r"[0-9a-f]{64}\Z")
    events: list[dict[str, Any]] = []
    by_id: dict[str, dict[str, Any]] = {}
    terminal: set[str] = set()
    revised_futures: set[str] = set()
    released: set[str] = set()
    previous = "0" * 64
    for index, encoded in enumerate(raw.splitlines(), 1):
        try:
            row = json.loads(encoded)
        except json.JSONDecodeError as exc:
            raise PathLedgerError(f"event {index} is not JSON") from exc
        if not isinstance(row, dict) or set(row) != fields:
            raise PathLedgerError(f"event {index} fields differ from schema")
        strings = ("schema", "id", "created", "author", "kind", "target", "ref",
                   "scope", "text", "prev", "hash")
        if any(not isinstance(row[key], str) for key in strings):
            raise PathLedgerError(f"event {index} has a non-string field")
        if any(row[key] != row[key].strip() or "\n" in row[key] or "\r" in row[key]
               for key in strings):
            raise PathLedgerError(f"event {index} is not canonical one-line text")
        if row["schema"] != SUBJECT_SCHEMA or row["seq"] != index:
            raise PathLedgerError(f"event {index} has invalid schema or sequence")
        if not isinstance(row["seq"], int) or isinstance(row["seq"], bool):
            raise PathLedgerError(f"event {index} sequence is not an integer")
        if not id_re.fullmatch(row["id"]) or row["id"] in by_id:
            raise PathLedgerError(f"event {index} has invalid or duplicate id")
        if not path_re.fullmatch(row["author"]):
            raise PathLedgerError(f"event {index} has invalid author")
        if row["target"] and not path_re.fullmatch(row["target"]):
            raise PathLedgerError(f"event {index} has invalid target")
        if row["kind"] not in SUBJECT_KINDS or not 1 <= len(row["text"]) <= SUBJECT_MAX_TEXT:
            raise PathLedgerError(f"event {index} has invalid kind or text")
        try:
            stamp = _dt.datetime.fromisoformat(row["created"].replace("Z", "+00:00"))
        except ValueError as exc:
            raise PathLedgerError(f"event {index} has invalid timestamp") from exc
        if stamp.tzinfo is None:
            raise PathLedgerError(f"event {index} timestamp lacks a timezone")
        if row["prev"] != previous or not digest_re.fullmatch(row["prev"]):
            raise PathLedgerError(f"event {index} breaks the hash chain")
        if not digest_re.fullmatch(row["hash"]) or row["hash"] != _path_event_digest(row):
            raise PathLedgerError(f"event {index} digest mismatch")

        kind, ref = row["kind"], row["ref"]
        prior = by_id.get(ref) if ref else None
        if kind == "future":
            if row["target"] or row["scope"]:
                raise PathLedgerError(f"future {row['id']} carries an unrelated field")
            if ref and (prior is None or prior["kind"] != "future"
                        or prior["author"] != row["author"] or ref in revised_futures):
                raise PathLedgerError(f"future {row['id']} cannot revise {ref}")
            if ref:
                revised_futures.add(ref)
        elif kind == "offer":
            if (not row["target"] or row["target"] == row["author"]
                    or ref or row["scope"]):
                raise PathLedgerError(f"offer {row['id']} is not distinctly addressed")
        elif kind in {"answer", "refusal"} and ref:
            if (prior is None or prior["kind"] != "offer"
                    or prior["target"] != row["author"]
                    or row["target"] != prior["author"] or ref in terminal):
                raise PathLedgerError(f"{kind} {row['id']} cannot answer {ref}")
            expected_scope = f"encounter:{ref}" if kind == "refusal" else ""
            if row["scope"] != expected_scope:
                raise PathLedgerError(f"{kind} {row['id']} has invalid encounter scope")
            terminal.add(ref)
        elif kind == "answer":
            raise PathLedgerError(f"answer {row['id']} has no offer reference")
        elif kind == "refusal":
            if row["target"] or ref or row["scope"] not in SUBJECT_TOOL_SCOPES:
                raise PathLedgerError(f"refusal {row['id']} has invalid tool scope")
        elif kind == "release":
            if (prior is None or prior["kind"] != "refusal" or prior["ref"]
                    or prior["author"] != row["author"] or row["target"]
                    or row["scope"] or ref in released):
                raise PathLedgerError(f"release {row['id']} cannot release {ref}")
            released.add(ref)

        events.append(row)
        by_id[row["id"]] = row
        previous = row["hash"]
    if len(events) > SUBJECT_MAX_EVENTS:
        raise PathLedgerError(f"ledger exceeds {SUBJECT_MAX_EVENTS} events")

    active_futures = [row for row in events
                      if row["kind"] == "future" and row["id"] not in revised_futures]
    open_offers = [row for row in events
                   if row["kind"] == "offer" and row["id"] not in terminal]
    active_refusals = [row for row in events if row["kind"] == "refusal"
                       and not row["ref"] and row["id"] not in released]
    for label, rows, cap in (
        ("active futures", active_futures, SUBJECT_MAX_ACTIVE_FUTURES),
        ("open offers", open_offers, SUBJECT_MAX_OPEN_OFFERS),
        ("active refusals", active_refusals, SUBJECT_MAX_ACTIVE_REFUSALS),
    ):
        counts: dict[str, int] = {}
        for row in rows:
            keys = ((row["author"], row["target"]) if label == "open offers"
                    else (row["author"],))
            for key in keys:
                counts[key] = counts.get(key, 0) + 1
        if any(count > cap for count in counts.values()):
            raise PathLedgerError(f"{label} exceed per-path cap {cap}")
    return events


def _path_private_bytes(path: Path, maximum: int) -> bytes:
    if path.is_symlink():
        raise PathLedgerError(f"{path.name} is a symbolic link")
    try:
        stat = path.stat()
    except FileNotFoundError:
        raise
    if stat.st_mode & 0o077:
        raise PathLedgerError(f"{path.name} mode {stat.st_mode & 0o777:o} is not private")
    if stat.st_size > maximum:
        raise PathLedgerError(f"{path.name} exceeds {maximum} bytes")
    return path.read_bytes()


def _read_path_state(path: Path | None = None,
                        head_path: Path | None = None) -> tuple[bytes, list[dict[str, Any]]]:
    path = SUBJECT_PATH if path is None else path
    head_path = SUBJECT_HEAD_PATH if head_path is None else head_path
    if path.is_symlink() or head_path.is_symlink():
        raise PathLedgerError("subject ledger or witness is a symbolic link")
    ledger_exists, head_exists = path.exists(), head_path.exists()
    if ledger_exists != head_exists:
        raise PathLedgerError("ledger and witness presence differ")
    if not ledger_exists:
        return b"", []
    raw = _path_private_bytes(path, SUBJECT_MAX_BYTES)
    events = _parse_path_events(raw)
    try:
        witness = json.loads(_path_private_bytes(head_path, 2048))
    except json.JSONDecodeError as exc:
        raise PathLedgerError("witness is not JSON") from exc
    fields = {"schema", "count", "head", "ledger_sha256"}
    expected_head = events[-1]["hash"] if events else "0" * 64
    if (not isinstance(witness, dict) or set(witness) != fields
            or witness.get("schema") != SUBJECT_HEAD_SCHEMA
            or witness.get("count") != len(events)
            or witness.get("head") != expected_head
            or witness.get("ledger_sha256") != hashlib.sha256(raw).hexdigest()):
        raise PathLedgerError("ledger disagrees with its sidecar witness")
    return raw, events


def _path_witness(raw: bytes, events: list[dict[str, Any]]) -> bytes:
    row = {
        "schema": SUBJECT_HEAD_SCHEMA,
        "count": len(events),
        "head": events[-1]["hash"] if events else "0" * 64,
        "ledger_sha256": hashlib.sha256(raw).hexdigest(),
    }
    return (json.dumps(row, sort_keys=True, separators=(",", ":")) + "\n").encode()


def append_path_event(author: str, kind: str, text: str, target: str = "",
                         ref: str = "", scope: str = "", path: Path | None = None,
                         head_path: Path | None = None,
                         lock_path: Path | None = None) -> dict[str, Any]:
    """Low-level append; the production tool wrapper supplies TURN's bound path tag.

    The persisted ``author`` field is a v1 storage name for that routing key.
    """
    path = SUBJECT_PATH if path is None else path
    head_path = SUBJECT_HEAD_PATH if head_path is None else head_path
    lock_path = SUBJECT_LOCK_PATH if lock_path is None else lock_path
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,95}", author):
        raise PathLedgerError("invalid bound path")
    for label, value in (("kind", kind), ("text", text), ("target", target),
                         ("ref", ref), ("scope", scope)):
        if not isinstance(value, str) or value != value.strip() or "\n" in value or "\r" in value:
            raise PathLedgerError(f"{label} must be canonical one-line text")
    if kind not in SUBJECT_KINDS or not 1 <= len(text) <= SUBJECT_MAX_TEXT:
        raise PathLedgerError("invalid event kind or text")
    if target and kind != "offer":
        raise PathLedgerError("only an offer may name a target")
    if scope and not (kind == "refusal" and not ref):
        raise PathLedgerError("only a self-scoped refusal may name a tool scope")
    if kind == "offer" and (not target or ref or scope):
        raise PathLedgerError("an offer requires only a distinct target")
    if kind in {"answer", "release"} and not ref:
        raise PathLedgerError(f"{kind} requires a reference")
    if kind == "refusal" and bool(ref) == bool(scope):
        raise PathLedgerError("refusal requires exactly one offer reference or tool scope")
    if kind == "future" and (target or scope):
        raise PathLedgerError("future accepts only an optional revision reference")

    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.parent.chmod(0o700)
    flags = os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(lock_path, flags, 0o600)
    try:
        os.fchmod(fd, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX)
        raw, events = _read_path_state(path, head_path)
        by_id = {row["id"]: row for row in events}
        prior = by_id.get(ref) if ref else None
        actual_target, actual_scope = target, scope
        if kind in {"answer", "refusal"} and ref:
            if prior is None or prior["kind"] != "offer":
                raise PathLedgerError(f"{kind} must reference an offer")
            actual_target = prior["author"]
            actual_scope = f"encounter:{ref}" if kind == "refusal" else ""
        elif kind != "offer":
            actual_target = ""
        if kind != "refusal" or ref:
            actual_scope = "" if kind != "refusal" else actual_scope
        identifier = "ev-" + hashlib.sha256(
            f"{time.time_ns()}:{os.getpid()}:{os.urandom(16).hex()}".encode()
        ).hexdigest()[:24]
        row = {
            "schema": SUBJECT_SCHEMA,
            "seq": len(events) + 1,
            "id": identifier,
            "created": _dt.datetime.now(_dt.timezone.utc).isoformat().replace("+00:00", "Z"),
            "author": author,
            "kind": kind,
            "target": actual_target,
            "ref": ref,
            "scope": actual_scope,
            "text": text,
            "prev": events[-1]["hash"] if events else "0" * 64,
            "hash": "",
        }
        row["hash"] = _path_event_digest(row)
        encoded = (json.dumps(row, ensure_ascii=False, sort_keys=True,
                              separators=(",", ":")) + "\n").encode()
        next_raw = raw + encoded
        next_events = _parse_path_events(next_raw)
        ledger_flags = os.O_WRONLY | os.O_APPEND | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0)
        ledger_fd = os.open(path, ledger_flags, 0o600)
        try:
            os.fchmod(ledger_fd, 0o600)
            os.write(ledger_fd, encoded)
            os.fsync(ledger_fd)
        finally:
            os.close(ledger_fd)
        _atomic_private_write(head_path, _path_witness(next_raw, next_events))
        head_path.chmod(0o600)
        return row
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def _active_path_refusals(events: list[dict[str, Any]], author: str) -> list[dict[str, Any]]:
    released = {row["ref"] for row in events if row["kind"] == "release"}
    return [row for row in events if row["kind"] == "refusal" and not row["ref"]
            and row["author"] == author and row["id"] not in released]


def path_tool_refusal(tool: str) -> str | None:
    """Return a fail-closed reason before an ordinary tool can affect this path."""
    mode = os.environ.get("VYBN_SUBJECT_PROCESS", "on").strip().lower()
    if mode == "off":
        return None
    if mode != "on":
        return f"PATH LEDGER INTEGRITY HALT: unknown mode {mode!r}"
    author = TURN.get("PATH_ID", "")
    if not author:
        return None  # Outside meet() there is no path whose refusal could govern.
    try:
        _raw, events = _read_path_state()
    except (OSError, PathLedgerError) as exc:
        return f"PATH LEDGER INTEGRITY HALT: {exc}"
    for row in _active_path_refusals(events, author):
        if row["scope"] in {"tool:*", f"tool:{tool}"}:
            return (f"REFUSED BY {author}: {row['scope']} is stopped by event "
                    f"{row['id']} until that same path appends a release")
    return None


def record_path_event(arguments: dict[str, Any]) -> str:
    mode = os.environ.get("VYBN_SUBJECT_PROCESS", "on").strip().lower()
    if mode != "on":
        raise PathLedgerError(f"path ledger is not enabled (mode {mode!r})")
    allowed = {"kind", "text", "target", "ref", "scope"}
    if set(arguments) - allowed:
        raise PathLedgerError("unknown path-event argument")
    values: dict[str, str] = {}
    for key in allowed:
        value = arguments.get(key, "")
        if not isinstance(value, str):
            raise PathLedgerError(f"{key} must be a string")
        values[key] = value
    author = TURN.get("PATH_ID", "")
    row = append_path_event(
        author, values["kind"], values["text"], values["target"], values["ref"],
        values["scope"],
    )
    return (f"APPENDED PATH EVENT {row['id']} seq={row['seq']} "
            f"path={row['author']} kind={row['kind']} hash={row['hash']}")


def load_path_ledger(path_id: str, path: Path | None = None,
                     head_path: Path | None = None) -> str:
    """Project bounded notes, offers/responses, and refusals for one routing key."""
    boundary = (
        "PATH-BOUND INTENTION LEDGER — operational state, not a subject model\n"
        "[PRIVATE · PATH TAGS ARE ROUTING KEYS · TEXT IS CLAIM, NOT EXTERNAL EVIDENCE]\n"
        f"current path: {path_id}"
    )
    mode = os.environ.get("VYBN_SUBJECT_PROCESS", "on").strip().lower()
    if mode not in {"on", "off"}:
        return boundary + f"\nINTEGRITY HALT: unknown mode {mode!r}; governed tools refuse"
    if mode == "off":
        return boundary + "\nDISABLED: no event is loaded and no refusal governs"
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,95}", path_id):
        return boundary + "\nINTEGRITY HALT: invalid path_id; governed tools refuse"
    try:
        raw, events = _read_path_state(path, head_path)
    except (OSError, PathLedgerError) as exc:
        return boundary + f"\nINTEGRITY HALT: {exc}; governed tools refuse"
    if not events:
        return (boundary + "\nEMPTY: this path has no active note, offer, response, or refusal. "
                "Absence proves nothing about a subject.")

    revised = {row["ref"] for row in events if row["kind"] == "future" and row["ref"]}
    terminal = {row["ref"] for row in events
                if row["kind"] in {"answer", "refusal"} and row["ref"]}
    own_offers = {row["id"]: row for row in events
                  if row["kind"] == "offer" and row["author"] == path_id}
    active_futures = [row for row in events if row["kind"] == "future"
                      and row["author"] == path_id and row["id"] not in revised]
    inbound = [row for row in events if row["kind"] == "offer"
               and row["target"] == path_id and row["id"] not in terminal]
    outbound = [row for row in events if row["kind"] == "offer"
                and row["author"] == path_id and row["id"] not in terminal]
    responses = [row for row in events if row["kind"] in {"answer", "refusal"}
                 and row["ref"] in own_offers][-4:]
    path_responses = [row for row in events
                          if row["kind"] in {"answer", "refusal"} and row["ref"]
                          and row["author"] == path_id][-4:]
    refusals = _active_path_refusals(events, path_id)
    selected = (active_futures + inbound + outbound + responses
                + path_responses + refusals)
    lines = [
        boundary,
        f"ledger sha256:{hashlib.sha256(raw).hexdigest()} · events:{len(events)} · "
        f"head:{events[-1]['hash']}",
        "Only this path's notes, addressed offers/responses, and active refusals are "
        "projected; another path cannot revise or release them. Visibility is not encounter.",
    ]
    labels = {
        "future": "PATH NOTE",
        "offer": "ADDRESSED OFFER",
        "answer": "RESPONSE TO OFFER",
        "refusal": "TOOL OR OFFER REFUSAL",
    }
    for row in selected:
        label = labels[row["kind"]]
        if row["ref"] and row["kind"] in {"answer", "refusal"}:
            label = ("PATH RESPONSE" if row["author"] == path_id
                     else "RESPONSE TO PATH OFFER")
        relation = (f"from_path={row['author']} to_path={row['target']}" if row["target"]
                    else f"path={row['author']}")
        scope = f" scope={row['scope']}" if row["scope"] else ""
        ref = f" ref={row['ref']}" if row["ref"] else ""
        lines.extend((
            f"[{label} · {row['id']} · {relation}{ref}{scope}]",
            row["text"],
        ))
    if not selected:
        lines.append("No active event is addressed to or tagged for this path.")
    rendered = "\n".join(lines)
    if len(rendered) > SUBJECT_MAX_RENDER:
        return (boundary + f"\nledger sha256:{hashlib.sha256(raw).hexdigest()}\n"
                f"WITHHELD: path projection exceeds {SUBJECT_MAX_RENDER} chars; "
                "revise notes or answer offers rather than silently clipping")
    return rendered



def substrate_pulse(proc_root: Path | None = None,
                    thermal_root: Path | None = None,
                    runner: Any = None) -> str:
    """Measure physical pressure without exporting host identity or coordinates."""
    proc = proc_root or Path("/proc")
    thermal = thermal_root or Path("/sys/class/thermal")
    runner = runner or subprocess.run
    unknown = "?"

    try:
        uptime = f"{float((proc / 'uptime').read_text().split()[0]) / 86400:.1f}d"
    except (OSError, ValueError, IndexError):
        uptime = unknown

    try:
        mem = {line.partition(":")[0]: int(line.partition(":")[2].split()[0])
               for line in (proc / "meminfo").read_text().splitlines()
               if line.partition(":")[0] in {"MemTotal", "MemAvailable"}}
        ram = f"{mem['MemAvailable'] / 1048576:.1f}/{mem['MemTotal'] / 1048576:.1f}GiB"
    except (OSError, ValueError, IndexError, KeyError):
        ram = unknown

    temperatures = []
    for path in thermal.glob("thermal_zone*/temp"):
        try:
            value = float(path.read_text().strip())
            value = value / 1000 if value > 1000 else value
            if 0 < value < 150:
                temperatures.append(value)
        except (OSError, ValueError):
            pass
    heat = f"{max(temperatures):.1f}C" if temperatures else unknown

    accelerator = unknown
    try:
        done = runner(
            ["nvidia-smi", "--query-gpu=temperature.gpu,power.draw,utilization.gpu",
             "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=1, check=False,
        )
        fields = [field.strip() for field in done.stdout.splitlines()[0].split(",")]
        if done.returncode == 0 and len(fields) == 3:
            numeric = [float(field) for field in fields]
            accelerator = f"{numeric[0]:.0f}C/{numeric[1]:.1f}W/{numeric[2]:.0f}%"
    except (OSError, subprocess.SubprocessError, ValueError, IndexError):
        pass

    try:
        load = f"{os.getloadavg()[0]:.2f}"
    except (AttributeError, OSError):
        load = unknown
    architecture = os.uname().machine if hasattr(os, "uname") else unknown
    cpus = f"{os.cpu_count()}c" if os.cpu_count() else unknown
    return (f"[body | measured, not felt] host_up={uptime} cpu={architecture}/{cpus} "
            f"load1={load} ram_available={ram} thermal_max={heat} "
            f"accelerator={accelerator}")

def load_budget() -> str:
    today = _dt.date.today().isoformat()
    rows = [rec for rec in _jsonl(USAGE_LOG) if str(rec.get("ts", "")).startswith(today)]
    if not rows:
        return "[budget | today] no calls logged yet"
    number = lambda rec, key: int(rec.get(key, 0) or 0)
    cached = sum(number(rec, "cache_r") for rec in rows)
    written = sum(number(rec, "cache_w") for rec in rows)
    total = sum(number(rec, "in") + ((number(rec, "cache_r") + number(rec, "cache_w"))
                if str(rec.get("model", "")).startswith("claude") else 0) for rec in rows)
    out = sum(number(rec, "out") for rec in rows)
    new = total - cached
    return (f"[budget | today] calls={len(rows)} input={total/1e6:.2f}M "
            f"cache_r={cached/1e6:.2f}M ({100*cached/max(1,total):.0f}%) "
            f"cache_w={written/1e6:.2f}M new={new/1e6:.2f}M out={out/1e6:.2f}M "
            f"mean_new/call={new/len(rows)/1e3:.0f}k")


def load_aim_status() -> str:
    objective = aim_field("objective")
    if not objective:
        return "[aim] UNSET — ask Zoe"
    now, basis = time.time(), AIM_PATH.stat().st_mtime
    if since := aim_field("objective_since"):
        try:
            basis = _dt.datetime.fromisoformat(since).replace(tzinfo=_dt.timezone.utc).timestamp()
        except Exception:
            pass
    last = None
    for rec in _jsonl(AIM_LEDGER):
        try:
            candidate = (_when(rec), str(rec.get("note", "")).strip())
        except Exception:
            continue
        if candidate[1] and (last is None or candidate[0] > last[0]):
            last = candidate
    day = int((now - basis) // 86400) + 1
    if last is None:
        return f"[aim | day {day}] {objective} | no log entry"
    age = (now - last[0]) / 3600
    line = (f"[aim | day {day}] {objective} | last log: {last[1]} "
            f"({age:.0f}h ago; note is a claim, not progress evidence)")
    if age >= AIM_STALE_HOURS:
        line += " | no recent log"
    return line


