def guard_path_bound_storage(command: str) -> str | None:
    """Raw ledgers would bypass each execution path's bounded projection."""
    paths = (TRANSFORM_PATH, TRANSFORM_HEAD_PATH, TRANSFORM_LOCK_PATH,
             TRANSFORM_SEGMENTS_PATH, SUBJECT_PATH, SUBJECT_HEAD_PATH, SUBJECT_LOCK_PATH,
             SUBJECT_HEAD_PATH.with_suffix(".segments"))
