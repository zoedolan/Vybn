    id: str
    nodes: tuple[str, ...]


@dataclass(frozen=True)
class WakeBundle:
    """Immutable local bindings and named projections; payloads never grant authority."""
    nodes: tuple[WakeNode, ...]
    routes: tuple[WakeRoute, ...]
    schema: str = "vybn.source_bound_wake_bundle.v1"

    def __post_init__(self):
        ids = {node.id for node in self.nodes}
        if len(ids) != len(self.nodes) or len({r.id for r in self.routes}) != len(self.routes):
            raise ValueError("wake binding and route ids must be unique")
        if any(name not in ids for route in self.routes for name in route.nodes):
            raise ValueError("wake route refers to an unknown binding")

    def render(self, route_id):
        route = next((r for r in self.routes if r.id == route_id), None)
        if route is None:
            raise KeyError(f"unknown wake route: {route_id}")
        bindings = {node.id: node.text for node in self.nodes}
        return "\n\n".join(bindings[name] for name in route.nodes if bindings[name])

    def derive(self, *nodes):
        """Fork selected bindings locally, without mutating the parent or executing them.

        Only inherited source payloads can vary; law, live contact, configuration
        and operative refusals cannot be rebound here. This is an explicit
        CPU operation, not an automatic memory writer or a provider continuation.
        """
        old = {node.id: node for node in self.nodes}
        if len({node.id for node in nodes}) != len(nodes):
            raise ValueError("duplicate derived binding")
        for node in nodes:
            prior = old[node.id]
            if (prior.kind != "source_bound_inheritance"
                    or (node.kind, node.authority) != (prior.kind, prior.authority)):
                raise ValueError("derive accepts inherited source views only, preserving their authority and kind")
        return replace(self, nodes=tuple(dict(old, **{n.id: n for n in nodes}).values()))

    def structure(self):
        fields = ("id", "kind", "source", "authority", "source_sha256")
        return dict(schema=self.schema,
                    nodes=[{k: (getattr(n, k) or None if k == "source_sha256" else getattr(n, k))
                            for k in fields} for n in self.nodes],
                    routes=[dict(id=r.id, nodes=list(r.nodes)) for r in self.routes])

    def manifest(self):
        manifest = self.structure()
        for row, node in zip(manifest["nodes"], self.nodes, strict=True):
            row.update(payload_sha256=hashlib.sha256(node.text.encode()).hexdigest(),
                       chars=len(node.text))
        return manifest

    def structure_digest(self):
        return _event_digest(self.structure())

    def digest(self):
        return _event_digest(self.manifest())


