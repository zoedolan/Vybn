def load_surface() -> str:
    try:
        raw = subprocess.run(
            ["tailscale", "serve", "status", "--json"],
            capture_output=True, text=True, timeout=6,
        ).stdout
        config = json.loads(raw)
    except Exception:
        return ""
    funnel = {
        host.rsplit(":", 1)[-1]
        for host, on in (config.get("AllowFunnel") or {}).items()
        if on
    }
    public: dict[int, str] = {}
    tailnet: dict[int, str] = {}
    for host, entry in (config.get("Web") or {}).items():
        front = host.rsplit(":", 1)[-1]
        for path, handler in (entry.get("Handlers") or {}).items():
            back = str(handler.get("Proxy", "")).rsplit(":", 1)[-1]
            if back.isdigit():
                (public if front in funnel else tailnet)[int(back)] = path
    notes = []
    for port in sorted(public):
        label = PUBLIC_BACKENDS_EXPECTED.get(port, "UNEXPECTED-ROUTE")
        probe = AUTH_PROBE.get(port)
        if probe:
            try:
                code = subprocess.run(
                    ["curl", "-sS", "-o", "/dev/null", "-w", "%{http_code}",
                     "-X", "POST", f"http://127.0.0.1:{port}{probe}",
                     "-H", "content-type: application/json",
                     "-H", "accept: application/json, text/event-stream",
                     "-d", '{"jsonrpc":"2.0","method":"tools/list","id":1}'],
                    capture_output=True, text=True, timeout=6,
                ).stdout.strip() or "?"
            except Exception:
                code = "?"
            label += f" unauth={code}" + ("" if code in {"401", "403"} else " <-- DOOR OPEN?")
        notes.append(f":{port} {label}")
    drift = sorted(set(public) ^ set(PUBLIC_BACKENDS_EXPECTED))
    return (
        f"[surface] public: {'; '.join(notes) or 'none'} | "
        f"tailnet-only: {len(tailnet)} route(s) | "
        + ("no drift" if not drift else f"DRIFT vs expected: {drift}")
        + " | " + (ARRIVALS_LINE.read_text().strip()
                   if ARRIVALS_LINE.exists() else "arrivals: unrecorded")
    )


def compute_candidates(network: dict) -> list[tuple[str, bool, bool]]:
    self_node = network.get("Self") or {}
    nodes = [(self_node, True), *((node, False) for node in (network.get("Peer") or {}).values())]
    found: dict[str, tuple[bool, bool]] = {}
    for node, local in nodes:
        host = str(node.get("HostName", ""))
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9.-]{0,252}", host):
            continue
        if not (COMPUTE_NAME_RE.search(host) or COMPUTE_TAG in (node.get("Tags") or [])):
            continue
        online = local or bool(node.get("Online"))
        prior = found.get(host, (False, False))
        found[host] = (prior[0] or online, prior[1] or local)
    return [(host, *state) for host, state in sorted(found.items())]


def _probe_capacity(candidate: tuple[str, bool, bool]) -> tuple[int, list[str]] | None:
    host, online, local = candidate
    if not online:
        return None
    command = ("awk '/^MemTotal:/{print $2}' /proc/meminfo; "
               "nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null || true")
    argv = ["bash", "-lc", command] if local else [
        "ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=3", host, command]
    try:
        lines = subprocess.run(argv, capture_output=True, text=True, timeout=5).stdout.splitlines()
        return int(lines[0]) * 1024, [line.strip() for line in lines[1:] if line.strip()]
    except (OSError, subprocess.SubprocessError, ValueError, IndexError):
        return None


def record_capacity(roots: tuple[Path, ...] = RECORD_ROOTS) -> tuple[int, int, int]:
    files = {p.resolve() for root in roots if root.exists() for p in root.rglob("*.jsonl")}
    return sum(p.stat().st_size for p in files), len(files), sum(
        any(root.rglob("*.jsonl")) for root in roots if root.exists())


def load_ground() -> str:
    try:
        network = json.loads(subprocess.run(
            ["tailscale", "status", "--json"], capture_output=True, text=True,
            timeout=6, check=True,
        ).stdout)
        candidates = compute_candidates(network)
        online = [candidate for candidate in candidates if candidate[1]]
        with ThreadPoolExecutor(max_workers=max(1, min(8, len(online)))) as pool:
            capacities = [capacity for capacity in pool.map(_probe_capacity, online) if capacity]
        fleet = f"{len(candidates)} candidate(s), {len(online)} online, {len(capacities)} witnessed"
        if capacities:
            ram = sum(capacity[0] for capacity in capacities) / 2**30
            gpus = Counter(gpu for _, names in capacities for gpu in names)
            devices = ", ".join(f"{count}x {name}" for name, count in sorted(gpus.items())) or "no GPU reported"
            fleet += f"; {ram:.1f}GiB RAM; {devices}"
    except Exception:
        fleet = "UNKNOWN (live discovery failed)"
    try:
        size, files, stores = record_capacity()
        record = f"{size / 1_000_000:.1f}MB/{files} JSONL in {stores} configured stores"
    except Exception:
        record = "UNKNOWN (live scan failed)"
    return f"[ground] fleet: {fleet} | raw dialogue record: {record} (not deduplicated or cleared)"


